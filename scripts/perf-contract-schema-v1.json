{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyle.dev/schema/perf-contract-v1.json",
  "title": "HYLE performance contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "module",
    "claim",
    "candidate",
    "peers",
    "workloads",
    "strata",
    "controls",
    "experiment",
    "build",
    "artifacts",
    "hosts"
  ],
  "properties": {
    "schema": {
      "const": "hyle.perf.contract/v1"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "module": {
      "$ref": "#/$defs/identifier"
    },
    "claim": {
      "$ref": "#/$defs/nonemptyString"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "delivery_shape", "revision"],
      "properties": {
        "target": {
          "$ref": "#/$defs/identifier"
        },
        "delivery_shape": {
          "enum": ["header-only", "static", "shared", "source", "executable"]
        },
        "revision": {
          "$ref": "#/$defs/nonemptyString",
          "description": "Exact revision, or runtime-bound when each platform manifest records the actual HEAD/tree and certificate composition verifies identity."
        },
        "component": {
          "$ref": "#/$defs/nonemptyString"
        },
        "entrypoint": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "peers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "configuration"],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "revision": {
            "$ref": "#/$defs/nonemptyString"
          },
          "configuration": {
            "type": "object"
          }
        }
      }
    },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workload"
      }
    },
    "strata": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dimensions"],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "dimensions": {
            "type": "object"
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "target_variant": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "parameters"],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "kind": {
            "enum": [
              "aa",
              "known-delta",
              "timer-floor",
              "phase-floor",
              "codegen",
              "placement",
              "resource",
              "host"
            ]
          },
          "parameters": {
            "type": "object"
          }
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_schedule", "order_policy", "holdout"],
      "properties": {
        "sample_schedule": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "order_policy": {
          "enum": ["fixed-dual", "randomized", "abba"]
        },
        "holdout": {
          "type": "boolean"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration", "fresh", "linkage", "lto", "isa", "toolchain"],
      "properties": {
        "configuration": {
          "$ref": "#/$defs/nonemptyString"
        },
        "fresh": {
          "type": "boolean"
        },
        "linkage": {
          "$ref": "#/$defs/nonemptyString"
        },
        "lto": {
          "$ref": "#/$defs/nonemptyString"
        },
        "isa": {
          "$ref": "#/$defs/nonemptyString"
        },
        "toolchain": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validators"],
      "properties": {
        "validators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_platforms", "certification_platforms", "requirements"],
      "properties": {
        "allowed_platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "certification_platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "requirements": {
          "type": "object"
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]+$"
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "unit", "direction"],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "unit": {
          "$ref": "#/$defs/nonemptyString"
        },
        "direction": {
          "enum": ["higher-is-better", "lower-is-better"]
        }
      }
    },
    "processEstimator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "minimum_independent_samples", "tail_alpha"],
      "properties": {
        "kind": {
          "const": "process-median"
        },
        "minimum_independent_samples": {
          "type": "integer",
          "minimum": 1
        },
        "tail_alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 0.5
        }
      }
    },
    "clusteredEstimator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "minimum_independent_samples",
        "confidence",
        "bootstrap_rounds"
      ],
      "properties": {
        "kind": {
          "const": "clustered-bootstrap-median"
        },
        "minimum_independent_samples": {
          "type": "integer",
          "minimum": 1
        },
        "confidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "bootstrap_rounds": {
          "type": "integer",
          "minimum": 100
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "consumer_key": ["provenance", "ownership_topology", "material_contribution"],
        "provenance": ["consumer_key", "ownership_topology", "material_contribution"],
        "ownership_topology": ["consumer_key", "provenance", "material_contribution"],
        "material_contribution": ["consumer_key", "provenance", "ownership_topology"]
      },
      "allOf": [
        {
          "if": {
            "required": ["gate_role"],
            "properties": {
              "tier": {"const": "mechanism"}
            }
          },
          "then": {
            "properties": {
              "gate_role": {"const": "diagnostic"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "gate_role": {"const": "product"}
            },
            "required": ["gate_role"]
          },
          "then": {
            "properties": {
              "comparability": {"const": "COMPARABLE"}
            }
          }
        }
      ],
      "required": [
        "id",
        "tier",
        "semantic_contract",
        "comparability",
        "peer_id",
        "metric",
        "input",
        "setup",
        "charged_phases",
        "pair",
        "practical_margin_percent",
        "noninferiority_margin_percent",
        "estimator",
        "required_strata",
        "required_controls"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "tier": {
          "enum": ["consumer", "replay", "mechanism"]
        },
        "gate_role": {
          "enum": ["product", "diagnostic"]
        },
        "consumer_key": {
          "$ref": "#/$defs/identifier"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "allOf": [
                {"$ref": "#/$defs/nonemptyString"},
                {
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                }
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "ownership_topology": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate", "peer", "equivalence"],
          "properties": {
            "candidate": {
              "$ref": "#/$defs/nonemptyString"
            },
            "peer": {
              "$ref": "#/$defs/nonemptyString"
            },
            "equivalence": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        "material_contribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frequency", "value", "unit", "budget", "denominator", "derivation"],
          "properties": {
            "frequency": {
              "$ref": "#/$defs/positiveNumber"
            },
            "value": {
              "$ref": "#/$defs/positiveNumber"
            },
            "unit": {
              "$ref": "#/$defs/nonemptyString"
            },
            "budget": {
              "$ref": "#/$defs/positiveNumber"
            },
            "denominator": {
              "$ref": "#/$defs/nonemptyString"
            },
            "derivation": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        "semantic_contract": {
          "$ref": "#/$defs/nonemptyString"
        },
        "comparability": {
          "enum": ["COMPARABLE", "NOT_COMPARABLE"]
        },
        "peer_id": {
          "$ref": "#/$defs/identifier"
        },
        "metric": {
          "$ref": "#/$defs/metric"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["distribution", "scale"],
          "properties": {
            "distribution": {
              "$ref": "#/$defs/nonemptyString"
            },
            "scale": {
              "type": "object"
            }
          }
        },
        "setup": {
          "$ref": "#/$defs/nonemptyString"
        },
        "charged_phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "pair": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate", "peer"],
          "properties": {
            "candidate": {
              "$ref": "#/$defs/nonemptyString"
            },
            "peer": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        "practical_margin_percent": {
          "$ref": "#/$defs/positiveNumber"
        },
        "noninferiority_margin_percent": {
          "$ref": "#/$defs/positiveNumber"
        },
        "estimator": {
          "oneOf": [
            {
              "$ref": "#/$defs/processEstimator"
            },
            {
              "$ref": "#/$defs/clusteredEstimator"
            }
          ]
        },
        "required_strata": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "required_controls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    }
  }
}
