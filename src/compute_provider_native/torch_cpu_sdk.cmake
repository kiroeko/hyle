include_guard(GLOBAL)

hyle_auto_feature_option(HYLE_COMPUTE_TORCH_CPU
  "Use the original TorchAO/ATen CPU low precision programs" DEFAULT AUTO)
set(HYLE_COMPUTE_TORCH_CPU_ROOT "" CACHE PATH "LibTorch 2.8.0+cpu SDK prefix")
set(HYLE_COMPUTE_TORCH_CPU_ENABLED OFF)
if(HYLE_COMPUTE_TORCH_CPU STREQUAL "OFF")
  return()
endif()
if(NOT CMAKE_SYSTEM_NAME MATCHES "^(Windows|Linux)$" OR
   NOT HYLE_TARGET_PROCESSOR STREQUAL "x86_64")
  if(HYLE_COMPUTE_TORCH_CPU STREQUAL "ON")
    message(FATAL_ERROR "The qualified TorchAO CPU adapter requires Windows/Linux x86_64")
  endif()
  return()
endif()

# Do not load an arbitrary TorchConfig during AUTO: a CUDA wheel can fail in
# its own SDK discovery before HYLE can reject it. Read CPU identity first.
set(_hyle_torch_root "${HYLE_COMPUTE_TORCH_CPU_ROOT}")
if(NOT _hyle_torch_root AND Torch_DIR)
  get_filename_component(_hyle_torch_root "${Torch_DIR}/../../.." ABSOLUTE)
endif()
if(NOT _hyle_torch_root)
  find_path(_hyle_torch_prefix NAMES build-version
    PATHS ${CMAKE_PREFIX_PATH} PATH_SUFFIXES libtorch NO_DEFAULT_PATH)
  if(_hyle_torch_prefix)
    set(_hyle_torch_root "${_hyle_torch_prefix}")
  endif()
endif()
set(_hyle_torch_cpu FALSE)
if(EXISTS "${_hyle_torch_root}/build-version")
  file(READ "${_hyle_torch_root}/build-version" _hyle_torch_version)
  string(STRIP "${_hyle_torch_version}" _hyle_torch_version)
  if(_hyle_torch_version STREQUAL "2.8.0+cpu")
    set(_hyle_torch_cpu TRUE)
  endif()
endif()
if(NOT _hyle_torch_cpu)
  if(HYLE_COMPUTE_TORCH_CPU STREQUAL "ON")
    message(FATAL_ERROR "Set HYLE_COMPUTE_TORCH_CPU_ROOT to LibTorch 2.8.0+cpu; CUDA Torch is not accepted")
  endif()
  message(STATUS "HYLE: original CPU low precision unavailable -- no LibTorch 2.8.0+cpu SDK")
  return()
endif()
find_package(Torch 2.8.0 EXACT CONFIG REQUIRED
  PATHS "${_hyle_torch_root}/share/cmake/Torch" NO_DEFAULT_PATH)
include("${CMAKE_CURRENT_LIST_DIR}/HyleTorchCpuSdkConfig.cmake")
foreach(_hyle_torch_target IN ITEMS torch torch_cpu c10)
  if(TARGET ${_hyle_torch_target})
    get_target_property(_hyle_torch_global ${_hyle_torch_target} IMPORTED_GLOBAL)
    if(NOT _hyle_torch_global)
      set_property(TARGET ${_hyle_torch_target} PROPERTY IMPORTED_GLOBAL TRUE)
    endif()
  endif()
endforeach()
set(HYLE_COMPUTE_TORCH_CPU_ENABLED ON)
message(STATUS "HYLE: original TorchAO/ATen CPU low precision -- LibTorch 2.8.0+cpu")
