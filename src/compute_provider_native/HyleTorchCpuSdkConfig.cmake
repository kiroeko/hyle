# CPU-only machine SDK, private to the Native adapter. This same check runs in
# a static installed consumer; finding a GPU Torch package is not CPU isolation.
include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/torch_cpu_fetch.cmake")
set(_hyle_torch_lock "${CMAKE_CURRENT_LIST_DIR}/HyleDependencyLock.json")
if(NOT EXISTS "${_hyle_torch_lock}")
  # The same shim is included directly by a source build before installation.
  set(_hyle_torch_lock "${CMAKE_CURRENT_LIST_DIR}/../../cmake/HyleDependencyLock.json")
endif()
hyle_resolve_torch_cpu_sdk("${_hyle_torch_lock}" _hyle_torch_cpu_root)
_hyle_prepare_torch_cpu_sdk("${_hyle_torch_cpu_root}")
find_dependency(Torch 2.8.0 EXACT CONFIG
  PATHS "${_hyle_torch_cpu_root}/share/cmake/Torch" NO_DEFAULT_PATH)
hyle_register_torch_cpu_runtime("${_hyle_torch_cpu_root}")
if(NOT EXISTS "${TORCH_INSTALL_PREFIX}/build-version")
  message(FATAL_ERROR "HYLE low precision requires a versioned LibTorch CPU SDK")
endif()
file(READ "${TORCH_INSTALL_PREFIX}/build-version" _hyle_torch_version)
string(STRIP "${_hyle_torch_version}" _hyle_torch_version)
_hyle_torch_cpu_expected_version(_hyle_torch_expected)
if(NOT _hyle_torch_version STREQUAL _hyle_torch_expected OR CAFFE2_USE_CUDA)
  message(FATAL_ERROR "HYLE requires platform CPU LibTorch '${_hyle_torch_expected}', found '${_hyle_torch_version}'")
endif()
set(HyleTorchCpuSdk_FOUND TRUE)
unset(_hyle_torch_version)
