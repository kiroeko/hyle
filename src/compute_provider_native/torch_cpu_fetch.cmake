include_guard(GLOBAL)

function(_hyle_torch_cpu_platform output)
  set(_processor "${HYLE_TARGET_PROCESSOR}")
  if(NOT _processor)
    get_property(_processor GLOBAL PROPERTY HYLE_TARGET_PROCESSOR)
  endif()
  if(NOT _processor)
    set(_processor "${CMAKE_SYSTEM_PROCESSOR}")
  endif()
  if(CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND _processor MATCHES "^(arm64|aarch64)$")
    if(CMAKE_OSX_ARCHITECTURES AND NOT CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
      message(FATAL_ERROR "The locked Mac CPU SDK is ARM64; universal/x86 CPU SDK builds are not qualified")
    endif()
    set(${output} "Darwin-aarch64" PARENT_SCOPE)
  elseif(CMAKE_SYSTEM_NAME MATCHES "^(Windows|Linux)$" AND
         _processor MATCHES "^(x86_64|AMD64|amd64|x64)$")
    set(${output} "${CMAKE_SYSTEM_NAME}-x86_64" PARENT_SCOPE)
  else()
    message(FATAL_ERROR "No locked LibTorch CPU SDK for ${CMAKE_SYSTEM_NAME}/${_processor}")
  endif()
endfunction()

function(_hyle_torch_cpu_expected_version output)
  _hyle_torch_cpu_platform(_platform)
  if(_platform STREQUAL "Darwin-aarch64")
    set(${output} "2.8.0" PARENT_SCOPE)
  else()
    set(${output} "2.8.0+cpu" PARENT_SCOPE)
  endif()
endfunction()

function(hyle_register_torch_cpu_runtime root)
  set(_files "")
  if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    foreach(_name IN ITEMS torch torch_cpu c10)
      if(NOT EXISTS "${root}/lib/lib${_name}.so")
        message(FATAL_ERROR "Incomplete LibTorch CPU runtime: lib${_name}.so")
      endif()
      list(APPEND _files "${root}/lib/lib${_name}.so")
    endforeach()
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    foreach(_name IN ITEMS torch torch_cpu c10 omp)
      if(NOT EXISTS "${root}/lib/lib${_name}.dylib")
        message(FATAL_ERROR "Incomplete LibTorch CPU runtime: lib${_name}.dylib")
      endif()
      list(APPEND _files "${root}/lib/lib${_name}.dylib")
    endforeach()
    execute_process(COMMAND /usr/bin/lipo -verify_arch arm64
      "${root}/lib/libtorch_cpu.dylib" RESULT_VARIABLE _architecture)
    if(NOT _architecture EQUAL 0)
      message(FATAL_ERROR "Mac CPU SDK must contain the ARM64 runtime slice")
    endif()
    execute_process(COMMAND /usr/bin/otool -L "${root}/lib/libtorch_cpu.dylib"
      OUTPUT_VARIABLE _dependencies RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0 OR _dependencies MATCHES "/opt/homebrew/opt/libomp/")
      message(FATAL_ERROR "Mac CPU SDK has a non-relocatable libomp dependency; use HYLE's managed archive or a relocatable external SDK")
    endif()
  elseif(WIN32)
    foreach(_name IN ITEMS asmjit c10 fbgemm libiomp5md torch torch_cpu uv)
      if(NOT EXISTS "${root}/lib/${_name}.dll")
        message(FATAL_ERROR "Incomplete LibTorch CPU runtime: ${_name}.dll")
      endif()
      list(APPEND _files "${root}/lib/${_name}.dll")
    endforeach()
  else()
    return()
  endif()
  # The installed shim runs before HyleTargets is loaded. The names may be
  # registered before they exist; collection happens for the consumer later.
  foreach(_owner IN ITEMS hyle_compute_provider_native hyle::_factor_compute_provider_native torch_cpu)
    string(SHA256 _key "${_owner}")
    set_property(GLOBAL APPEND PROPERTY "HYLE_RUNTIME_FILES_${_key}" ${_files})
  endforeach()
endfunction()

# Private prebuilt-SDK acquisition, also shipped with the static dependency
# shim. It reads the central lock; it does not turn an SDK into a source tree.
function(_hyle_torch_cpu_check_root root)
  foreach(_file IN ITEMS build-version share/cmake/Torch/TorchConfig.cmake)
    if(NOT EXISTS "${root}/${_file}")
      message(FATAL_ERROR "Incomplete LibTorch CPU SDK: ${root}/${_file}")
    endif()
  endforeach()
  file(READ "${root}/build-version" _version)
  string(STRIP "${_version}" _version)
  _hyle_torch_cpu_expected_version(_expected)
  if(NOT _version STREQUAL _expected)
    message(FATAL_ERROR
      "HYLE requires the platform CPU SDK '${_expected}'; CUDA Torch is not accepted: ${root}")
  endif()
endfunction()

function(_hyle_torch_cpu_check_cache directory)
  file(STRINGS "${directory}/sha256.txt" _lines)
  foreach(_line IN LISTS _lines)
    string(SUBSTRING "${_line}" 0 64 _expected)
    string(SUBSTRING "${_line}" 66 -1 _relative)
    if(_relative MATCHES "(^|/)\\.\\.(/|$)" OR IS_ABSOLUTE "${_relative}")
      message(FATAL_ERROR "Unsafe LibTorch SDK cache manifest path")
    endif()
    if(NOT EXISTS "${directory}/libtorch/${_relative}")
      message(FATAL_ERROR "Incomplete cached LibTorch SDK: ${_relative}")
    endif()
    file(SHA256 "${directory}/libtorch/${_relative}" _actual)
    if(NOT _actual STREQUAL _expected)
      message(FATAL_ERROR "Corrupt cached LibTorch SDK: ${_relative}")
    endif()
  endforeach()
  file(GLOB_RECURSE _files LIST_DIRECTORIES FALSE "${directory}/libtorch/*")
  list(LENGTH _files _file_count)
  list(LENGTH _lines _manifest_count)
  if(NOT _file_count EQUAL _manifest_count OR _file_count LESS 1)
    message(FATAL_ERROR "LibTorch SDK cache file set differs from its manifest")
  endif()
  _hyle_torch_cpu_check_root("${directory}/libtorch")
endfunction()

function(hyle_resolve_torch_cpu_sdk lock_file output)
  set(HYLE_COMPUTE_TORCH_CPU_ROOT "" CACHE PATH "Advanced: external locked LibTorch CPU prefix")
  set(HYLE_COMPUTE_TORCH_CPU_ARCHIVE "" CACHE FILEPATH "Advanced: local locked CPU SDK archive")
  mark_as_advanced(HYLE_COMPUTE_TORCH_CPU_ROOT HYLE_COMPUTE_TORCH_CPU_ARCHIVE)
  set(_root "${HYLE_COMPUTE_TORCH_CPU_ROOT}")
  if(NOT _root AND Torch_DIR)
    get_filename_component(_root "${Torch_DIR}/../../.." ABSOLUTE)
  endif()
  if(NOT _root)
    find_path(_hyle_torch_prefix NAMES build-version
      PATHS ${CMAKE_PREFIX_PATH} PATH_SUFFIXES libtorch NO_DEFAULT_PATH NO_CACHE)
    if(_hyle_torch_prefix)
      set(_root "${_hyle_torch_prefix}")
    endif()
  endif()
  if(_root)
    _hyle_torch_cpu_check_root("${_root}")
    # Torch_DIR persists across reconfiguration. A managed SDK reached through
    # that cache variable still needs the same integrity check as a cold hit.
    if(EXISTS "${_root}/../.hyle-torch-sdk-stage")
      if(NOT EXISTS "${_root}/../sha256.txt")
        message(FATAL_ERROR "Incomplete managed LibTorch CPU SDK manifest")
      endif()
      _hyle_torch_cpu_check_cache("${_root}/..")
    endif()
    set(${output} "${_root}" PARENT_SCOPE)
    return()
  endif()

  file(READ "${lock_file}" _lock)
  _hyle_torch_cpu_platform(_platform)
  string(JSON _digest GET "${_lock}" sdks torch_cpu platforms "${_platform}" sha256)
  string(JSON _url GET "${_lock}" sdks torch_cpu platforms "${_platform}" url)
  string(LENGTH "${_digest}" _digest_length)
  if(NOT _digest_length EQUAL 64 OR NOT _digest MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Invalid LibTorch CPU SDK archive identity in the central lock")
  endif()
  if(HYLE_DEP_SOURCE_CACHE)
    set(_cache "${HYLE_DEP_SOURCE_CACHE}")
  elseif(DEFINED ENV{HYLE_DEP_SOURCE_CACHE} AND NOT "$ENV{HYLE_DEP_SOURCE_CACHE}" STREQUAL "")
    set(_cache "$ENV{HYLE_DEP_SOURCE_CACHE}")
  elseif(WIN32)
    set(_cache "$ENV{LOCALAPPDATA}/hyle/dependencies/v1")
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    set(_cache "$ENV{HOME}/Library/Caches/hyle/dependencies/v1")
  elseif(DEFINED ENV{XDG_CACHE_HOME} AND NOT "$ENV{XDG_CACHE_HOME}" STREQUAL "")
    set(_cache "$ENV{XDG_CACHE_HOME}/hyle/dependencies/v1")
  else()
    set(_cache "$ENV{HOME}/.cache/hyle/dependencies/v1")
  endif()
  get_filename_component(_cache "${_cache}" ABSOLUTE)
  set(_base "${_cache}/sdks/torch-cpu")
  if(IS_SYMLINK "${_base}")
    message(FATAL_ERROR "LibTorch SDK cache cannot be a symlink")
  endif()
  file(MAKE_DIRECTORY "${_base}")
  get_filename_component(_resolved_base "${_base}" REALPATH)
  if(NOT _resolved_base STREQUAL _base)
    message(FATAL_ERROR "LibTorch SDK cache path traverses a symlink: ${_base}")
  endif()
  if(HYLE_COMPUTE_TORCH_CPU_ARCHIVE)
    get_filename_component(_local_archive "${HYLE_COMPUTE_TORCH_CPU_ARCHIVE}" ABSOLUTE)
    if(NOT EXISTS "${_local_archive}")
      message(FATAL_ERROR "Local LibTorch CPU SDK archive does not exist: ${_local_archive}")
    endif()
    file(SHA256 "${_local_archive}" _actual)
    if(NOT _actual STREQUAL _digest)
      message(FATAL_ERROR "LibTorch CPU SDK archive SHA256 differs from the lock: ${_local_archive}")
    endif()
  endif()
  set(_directory "${_base}/${CMAKE_SYSTEM_NAME}-${_digest}")
  file(LOCK "${_directory}.lock" GUARD FUNCTION TIMEOUT 60)
  if(EXISTS "${_directory}")
    if(IS_SYMLINK "${_directory}" OR NOT EXISTS "${_directory}/sha256.txt")
      message(FATAL_ERROR "Incomplete or foreign LibTorch SDK cache: ${_directory}")
    endif()
    _hyle_torch_cpu_check_cache("${_directory}")
    message(STATUS "HYLE: reusing locked CPU SDK at ${_directory}/libtorch")
    set(${output} "${_directory}/libtorch" PARENT_SCOPE)
    return()
  endif()

  if(HYLE_COMPUTE_TORCH_CPU_ARCHIVE)
    set(_archive "${_local_archive}")
  else()
    set(_archive "${_directory}.zip")
    if(NOT EXISTS "${_archive}")
      if(FETCHCONTENT_FULLY_DISCONNECTED)
        message(FATAL_ERROR
          "LibTorch CPU SDK missing while disconnected. Transfer the SDK cache, "
          "or set HYLE_COMPUTE_TORCH_CPU_ARCHIVE to the locked original archive, "
          "or HYLE_COMPUTE_TORCH_CPU_ROOT to the qualified external SDK.")
      endif()
      message(STATUS "HYLE: obtaining locked LibTorch CPU SDK (once per platform)")
      file(DOWNLOAD "${_url}" "${_archive}.partial" TLS_VERIFY ON
        INACTIVITY_TIMEOUT 60 TIMEOUT 600 STATUS _status SHOW_PROGRESS)
      list(GET _status 0 _code)
      if(NOT _code EQUAL 0)
        file(REMOVE "${_archive}.partial")
        message(FATAL_ERROR "Cannot obtain CPU SDK: ${_status}; use the local archive/root input")
      endif()
      file(SHA256 "${_archive}.partial" _actual)
      if(NOT _actual STREQUAL _digest)
        file(REMOVE "${_archive}.partial")
        message(FATAL_ERROR "Downloaded LibTorch CPU SDK archive SHA256 differs from the lock")
      endif()
      file(RENAME "${_archive}.partial" "${_archive}")
    endif()
  endif()
  file(SHA256 "${_archive}" _actual)
  if(NOT _actual STREQUAL _digest)
    message(FATAL_ERROR "LibTorch CPU SDK archive SHA256 differs from the lock: ${_archive}")
  endif()

  set(_stage "${_directory}.stage")
  # This is the exact per-identity child of our SDK cache, under its writer
  # lock. Never delete an unmarked directory or traverse a reparse point.
  if(EXISTS "${_stage}")
    if(IS_SYMLINK "${_stage}" OR NOT EXISTS "${_stage}/.hyle-torch-sdk-stage")
      message(FATAL_ERROR "Foreign LibTorch SDK staging directory: ${_stage}")
    endif()
    file(READ "${_stage}/.hyle-torch-sdk-stage" _stage_owner)
    if(NOT _stage_owner STREQUAL "${_digest}\n")
      message(FATAL_ERROR "LibTorch SDK staging marker has a different identity")
    endif()
    file(REMOVE_RECURSE "${_stage}")
  endif()
  file(MAKE_DIRECTORY "${_stage}")
  file(WRITE "${_stage}/.hyle-torch-sdk-stage" "${_digest}\n")
  file(ARCHIVE_EXTRACT INPUT "${_archive}" DESTINATION "${_stage}")
  _hyle_torch_cpu_check_root("${_stage}/libtorch")
  if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    # Only this per-identity, writer-locked, marked stage is mutated. The
    # original archive and user-provided SDK roots remain untouched.
    execute_process(COMMAND /usr/bin/install_name_tool
      -change /opt/homebrew/opt/libomp/lib/libomp.dylib
      @loader_path/libomp.dylib "${_stage}/libtorch/lib/libtorch_cpu.dylib"
      RESULT_VARIABLE _relocation)
    if(NOT _relocation EQUAL 0)
      message(FATAL_ERROR "Cannot relocate managed Mac CPU libomp dependency")
    endif()
    execute_process(COMMAND /usr/bin/codesign --force --sign -
      "${_stage}/libtorch/lib/libtorch_cpu.dylib" RESULT_VARIABLE _sign)
    if(NOT _sign EQUAL 0)
      message(FATAL_ERROR "Cannot sign derived managed Mac CPU runtime")
    endif()
  endif()
  file(GLOB_RECURSE _files LIST_DIRECTORIES FALSE RELATIVE "${_stage}/libtorch" "${_stage}/libtorch/*")
  list(SORT _files)
  set(_manifest "")
  foreach(_file IN LISTS _files)
    file(SHA256 "${_stage}/libtorch/${_file}" _hash)
    string(APPEND _manifest "${_hash}  ${_file}\n")
  endforeach()
  file(WRITE "${_stage}/sha256.txt" "${_manifest}")
  file(RENAME "${_stage}" "${_directory}")
  message(STATUS "HYLE: locked CPU SDK cached at ${_directory}/libtorch")
  set(${output} "${_directory}/libtorch" PARENT_SCOPE)
endfunction()
