include_guard(GLOBAL)

# Only explicit DLL imports carry enough identity to vendor a Windows SDK.
# FindOpenSSL's UNKNOWN .lib targets remain external: arbitrary DLL strings in
# a static archive are not proof that it is an import library.
function(hyle_register_openssl_runtime out_bundled)
  set(_bundled "")
  if(NOT WIN32)
    set(${out_bundled} "" PARENT_SCOPE)
    return()
  endif()
  set(_files "")
  set(_seen "")
  foreach(_target IN ITEMS OpenSSL::SSL OpenSSL::Crypto)
    get_target_property(_type "${_target}" TYPE)
    if(NOT _type STREQUAL "SHARED_LIBRARY")
      message(VERBOSE "Hyle: ${_target} remains externally supplied; DLL staging requires an explicit SHARED import")
      continue()
    endif()
    get_target_property(_configurations "${_target}" IMPORTED_CONFIGURATIONS)
    if(NOT _configurations)
      set(_configurations "")
    endif()
    list(APPEND _configurations NOCONFIG)
    foreach(_configuration IN LISTS _configurations)
      string(TOUPPER "${_configuration}" _configuration)
      get_target_property(_location "${_target}" "IMPORTED_LOCATION_${_configuration}")
      if(NOT _location AND _configuration STREQUAL "NOCONFIG")
        get_target_property(_location "${_target}" IMPORTED_LOCATION)
      endif()
      if(NOT _location OR _location IN_LIST _seen)
        continue()
      endif()
      if(NOT _location MATCHES "\\.[dD][lL][lL]$" OR NOT EXISTS "${_location}")
        message(FATAL_ERROR "Cannot stage ${_target}: imported Windows DLL is missing: '${_location}'")
      endif()
      list(APPEND _seen "${_location}")
      get_target_property(_includes "${_target}" INTERFACE_INCLUDE_DIRECTORIES)
      set(_license "")
      foreach(_include IN ITEMS "${OPENSSL_INCLUDE_DIR}" ${_includes})
        if(NOT EXISTS "${_include}/openssl/ssl.h")
          continue()
        endif()
        get_filename_component(_prefix "${_include}/.." ABSOLUTE)
        cmake_path(IS_PREFIX _prefix "${_location}" NORMALIZE _same_sdk)
        if(NOT _same_sdk)
          continue()
        endif()
        foreach(_name IN ITEMS share/openssl/copyright LICENSE.txt LICENSE LICENSE.md)
          if(EXISTS "${_prefix}/${_name}" AND NOT IS_DIRECTORY "${_prefix}/${_name}")
            set(_license "${_prefix}/${_name}")
            break()
          endif()
        endforeach()
        if(_license)
          break()
        endif()
      endforeach()
      if(NOT _license)
        message(FATAL_ERROR
          "Cannot redistribute ${_target}: no original matching OpenSSL license under its SDK include prefix. "
          "Retain the supplier's share/openssl/copyright or LICENSE.txt with that SDK; no license is downloaded or substituted.")
      endif()
      set(_notices "${_license}")
      foreach(_name IN ITEMS NOTICE NOTICE.txt share/openssl/NOTICE)
        if(EXISTS "${_prefix}/${_name}")
          list(APPEND _notices "${_prefix}/${_name}")
        endif()
      endforeach()
      # Match CMake's selected imported artifact, including MAP_IMPORTED_CONFIG
      # and fallback behavior; never stage both Release and Debug by accident.
      set(_selected "$<PATH_EQUAL:$<TARGET_FILE:${_target}>,${_location}>")
      list(APPEND _files "$<${_selected}:${_location}>")
      get_filename_component(_name "${_location}" NAME)
      list(APPEND _bundled "$<${_selected}:${CMAKE_INSTALL_BINDIR}/${_name}>")
      if(ARGV1 AND HYLE_INSTALL AND NOT HYLE_STATIC)
        install(FILES "$<${_selected}:${_location}>"
          DESTINATION "${CMAKE_INSTALL_BINDIR}" COMPONENT Hyle_Runtime)
      endif()
      foreach(_notice IN LISTS _notices)
        get_filename_component(_name "${_notice}" NAME)
        file(SHA256 "${_notice}" _identity)
        string(SUBSTRING "${_identity}" 0 12 _identity)
        set(_name "OpenSSL-${_configuration}-${_identity}-${_name}")
        set(_copy "${CMAKE_CURRENT_BINARY_DIR}/hyle-openssl-notices/${_name}")
        configure_file("${_notice}" "${_copy}" COPYONLY)
        list(APPEND _files "$<${_selected}:${_copy}>")
        set(_destination "${CMAKE_INSTALL_DATADIR}/licenses/Hyle/openssl")
        list(APPEND _bundled "$<${_selected}:${_destination}/${_name}>")
        if(ARGV1 AND HYLE_INSTALL AND NOT HYLE_STATIC)
          foreach(_component IN ITEMS Hyle_Runtime Hyle_Development)
            install(FILES "$<${_selected}:${_copy}>"
              DESTINATION "${_destination}" COMPONENT "${_component}")
          endforeach()
        endif()
      endforeach()
    endforeach()
  endforeach()
  if(_files)
    list(REMOVE_DUPLICATES _files)
    hyle_register_runtime_files(TARGETS hyle_io_tls hyle::_factor_io_tls FILES ${_files})
  endif()
  list(REMOVE_DUPLICATES _bundled)
  set(${out_bundled} "${_bundled}" PARENT_SCOPE)
endfunction()
