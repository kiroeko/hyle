void output_from_statistics() {
    uint group = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint word_index = group * 128u + gl_LocalInvocationID.x;
    uint lanes = 4u / width(type_d);
    if (word_index >= (count + lanes - 1u) / lanes) return;
    uint output_word = 0;
    for (uint part = 0; part < lanes; ++part) {
        uint index = word_index * lanes + part;
        if (index >= count) continue;
        uint row = index / (reduction_width * reduction_inner) * reduction_inner + index % reduction_inner;
        uint column = (index / reduction_inner) % reduction_width;
        // This internal scratch has an aligned root, never a caller View.
        float maximum = uintBitsToFloat(c[row * 2u]);
        float normalizer = uintBitsToFloat(c[row * 2u + 1u]);
        float value = normalized_value(soft_value(row, column), maximum, normalizer, false);
        output_word |= encode(value, type_d) << (part * width(type_d) * 8u);
    }
    d[word_index] = output_word;
