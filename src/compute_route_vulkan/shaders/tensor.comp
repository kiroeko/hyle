void main() {
    if (operation == 13) {
        output_from_statistics();
        return;
    }
    uint group = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint first_row = group * rows_per_group;
    if (first_row >= reduction_rows) return;
    uint lane = gl_LocalInvocationID.x;
    if (operation == 10) {
        float identity = mode == 2 ? -negative_infinity() : mode == 3 ? negative_infinity() : 0.0;
        vec2 partial = vec2(identity);
        for (uint column = lane; column < reduction_width; column += 128)
            for (uint part = 0; part < rows_per_group; ++part) {
                if (first_row + part >= reduction_rows) continue;
                float value = reduced_value(first_row + part, column);
                partial[part] = mode <= 1 ? partial[part] + value : extremum(partial[part], value, mode == 3);
            }
        vec2 result = collective(partial, mode);
        if (mode == 1) result = reduction_width == 0 ? vec2(quiet_nan()) : result / float(reduction_width);
        if (lane == 0) {
            uint output_word = encode(result.x, type_d);
            if (rows_per_group == 2 && first_row + 1 < reduction_rows)
                output_word |= encode(result.y, type_d) << 16u;
            d[first_row / rows_per_group] = output_word;
        }
        return;
    }
    vec2 maximum = vec2(negative_infinity());
    uvec2 selected = uvec2(0xffffffffu);
    for (uint column = lane; column < reduction_width; column += 128) {
        vec2 values = soft_rows(first_row, column);
        if (cache_enabled != 0) row_cache[column] = values;
        for (uint part = 0; part < rows_per_group; ++part)
            select_maximum(maximum[part], selected[part], values[part], column);
    }
    maximum_rows(maximum, selected);
    vec2 partial = vec2(0.0);
    for (uint column = lane; column < reduction_width; column += 128) {
        vec2 values = cache_enabled != 0 ? row_cache[column] : soft_rows(first_row, column);
        vec2 exponential = exp(values - maximum);
        for (uint part = 0; part < rows_per_group; ++part)
            if (mode == 0 || column != selected[part]) partial[part] += exponential[part];
        if (cache_enabled != 0 && mode == 0) row_cache[column] = exponential;
    }
    vec2 total = collective(partial, 0);
    vec2 normalizer;
    for (uint part = 0; part < 2; ++part)
        normalizer[part] = isnan(maximum[part]) || isinf(maximum[part]) ? quiet_nan()
            : mode == 1 ? log_one_plus(total[part]) : 1.0 / total[part];
    if (operation == 12) {
        if (lane == 0)
            for (uint part = 0; part < rows_per_group; ++part)
                if (first_row + part < reduction_rows) {
                    d[(first_row + part) * 2u] = floatBitsToUint(maximum[part]);
                    d[(first_row + part) * 2u + 1u] = floatBitsToUint(normalizer[part]);
                }
        return;
    }
    bool exponential = cache_enabled != 0 && mode == 0;
    if (reduction_inner == 1) {
        uint lanes = 4u / width(type_d);
        uint end = min(count, (first_row + rows_per_group) * reduction_width);
        for (uint word_index = first_row * reduction_width / lanes + lane;
             word_index < (end + lanes - 1u) / lanes; word_index += 128) {
            uint output_word = 0;
            for (uint part = 0; part < lanes; ++part) {
                uint index = word_index * lanes + part;
                if (index >= end) continue;
                uint row = index / reduction_width - first_row, column = index % reduction_width;
                float value = cache_enabled != 0 ? row_cache[column][row] : soft_value(first_row + row, column);
                output_word |= encode(normalized_value(value, maximum[row], normalizer[row], exponential), type_d)
                    << (part * width(type_d) * 8u);
            }
            d[word_index] = output_word;
        }
    } else {
        // F32 owns individual words. Half rows are paired only when inner is
        // even, so both halves of each scattered word stay in this workgroup.
        for (uint column = lane; column < reduction_width; column += 128) {
            vec2 values = cache_enabled != 0 ? row_cache[column] : soft_rows(first_row, column);
            uint output_word = encode(normalized_value(values.x, maximum.x, normalizer.x, exponential), type_d);
            if (rows_per_group == 2)
                output_word |= encode(normalized_value(values.y, maximum.y, normalizer.y, exponential), type_d) << 16u;
            d[soft_index(first_row, column) / rows_per_group] = output_word;
        }
    }
}
#elif defined(HYLE_TENSOR_CONCAT)
uint concat_value(uint index, uint half_word, uint coordinate) {
    uint port = coordinate < concat_end_a ? 0u : coordinate < concat_end_b ? 1u : 2u;
    uint prefix = port == 0 ? concat_shift_a : port == 1 ? concat_shift_b : concat_shift_c;
    // Unsigned modular cancellation removes the global output-axis prefix.
    uint offset = tensor_address(index)[port] - prefix + half_word * 4u;
    return load_bytes(port, offset, min(width(type_d), 4u));
}
uint concat_word(uint word_index) {
    uint size = width(type_d), lanes = size < 4 ? 4u / size : 1u;
    uint output_word = 0, preserve = 0;
    for (uint lane = 0; lane < lanes; ++lane) {
        uint index = size == 8 ? word_index / 2u : word_index * lanes + lane;
        if (index >= count) continue;
        uint coordinate = (index % concat_row) / concat_inner;
        uint shift = lane * size * 8u;
        uint mask = size >= 4 ? 0xffffffffu : (1u << (size * 8u)) - 1u;
        if (coordinate < concat_begin) preserve |= mask << shift;
        else if (coordinate < concat_end_c)
            output_word |= (concat_value(index, size == 8 ? word_index % 2u : 0u,
                                         coordinate) & mask) << shift;
    }
    // A nonzero mask refers only to words already fully initialized by an
    // earlier group. The existing dispatch barrier makes those bits visible.
    if (preserve != 0) output_word |= d[word_index] & preserve;
    return output_word;
}
void main() {
    uint group = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    if (group > (concat_work - 1u) / 128u) return;
    uint work = group * 128u + gl_LocalInvocationID.x;
    if (work >= concat_work) return;
    uint row = work / concat_word_slots, size = width(type_d);
    uint word_index = ((row * concat_row + concat_begin * concat_inner) * size) / 4u
                    + work % concat_word_slots;
    uint end = (row * concat_row + concat_end_c * concat_inner) * size;
    if (word_index * 4u >= end) return;
    // Adjacent outer rows can share a word. Its earliest intersecting row owns
    // all this group's lanes, including lanes belonging to the next row.
    if (row != 0 && word_index * 4u < ((row - 1u) * concat_row + concat_end_c * concat_inner) * size)
        return;
    d[word_index] = concat_word(word_index);
}
