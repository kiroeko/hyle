}
float norm_inverse(float variance) {
    if (isnan(variance) || variance < 0) return uintBitsToFloat(0x7fc00000u);
    if (variance == 0) return uintBitsToFloat(0x7f800000u);
    return isinf(variance) ? 0.0 : inversesqrt(variance);
