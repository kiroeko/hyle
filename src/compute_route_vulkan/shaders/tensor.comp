float binary(float x, float y) {
    if (mode == 0) return x + y;
    if (mode == 1) return x - y;
    if (mode == 2) return x * y;
    if (mode == 3) return x / y;
    if (isnan(x)) return y;
    if (isnan(y)) return x;
    if (x == 0 && y == 0)
        return uintBitsToFloat(mode == 4 ? floatBitsToUint(x) | floatBitsToUint(y)
                                        : floatBitsToUint(x) & floatBitsToUint(y));
    return mode == 4 ? min(x, y) : max(x, y);
}
uvec3 tensor_address(uint index) {
    uvec3 offsets = uvec3(origin.a, origin.b, origin.c);
    uint remaining = index;
    address_axis(remaining, offsets, dim7, uvec3(sa7,sb7,sc7));
    address_axis(remaining, offsets, dim6, uvec3(sa6,sb6,sc6));
    address_axis(remaining, offsets, dim5, uvec3(sa5,sb5,sc5));
    address_axis(remaining, offsets, dim4, uvec3(sa4,sb4,sc4));
    address_axis(remaining, offsets, dim3, uvec3(sa3,sb3,sc3));
    address_axis(remaining, offsets, dim2, uvec3(sa2,sb2,sc2));
    address_axis(remaining, offsets, dim1, uvec3(sa1,sb1,sc1));
    address_axis(remaining, offsets, dim0, uvec3(sa0,sb0,sc0));
    return offsets;
}
uint evaluate(uint index, uint half_word) {
    if (operation == 1) return half_word == 0 ? fill_lo : fill_hi;
    uvec3 offsets = tensor_address(index);
    if (operation == 5) {
        bool choice = load_bytes(0, offsets.x, 1) != 0;
        return load_bytes(choice ? 1u : 2u, (choice ? offsets.y : offsets.z) + half_word * 4u,
                          min(width(type_d), 4u));
    }
    uint bits = load_bytes(0, offsets.x + half_word * 4u, min(width(type_a), 4u));
    if (operation == 0) return bits;
    float value = decode(bits, type_a);
    if (operation == 3) value = unary(value);
    if (operation == 4) value = binary(value, decode(load_bytes(1, offsets.y, width(type_b)), type_b));
    if (operation == 6) {
        float other = fill_hi != 0
            ? decode(load_bytes(0, offsets.x + fill_lo, width(type_a)), type_a)
            : decode(load_bytes(1, offsets.y, width(type_b)), type_b);
        value = unary(value) * other;
    }
    return encode(value, type_d);
}
#ifdef HYLE_TENSOR_REDUCTION
shared vec2 reduction_values[128];
shared uvec2 reduction_indices[128];
shared vec2 row_cache[cache_columns];
float quiet_nan() { return uintBitsToFloat(0x7fc00000u); }
float negative_infinity() { return uintBitsToFloat(0xff800000u); }
float extremum(float a, float b, bool maximum) {
    if (isnan(a)) return a;
    if (isnan(b)) return b;
    if (a == 0 && b == 0)
        return uintBitsToFloat(maximum ? floatBitsToUint(a) & floatBitsToUint(b)
                                     : floatBitsToUint(a) | floatBitsToUint(b));
    return maximum ? max(a, b) : min(a, b);
}
vec2 collective(vec2 partial, uint kind) {
    uint lane = gl_LocalInvocationID.x;
    reduction_values[lane] = partial;
    barrier();
    for (uint step = 64; step != 0; step >>= 1) {
        if (lane < step)
            for (uint part = 0; part < 2; ++part)
                reduction_values[lane][part] = kind <= 1
                    ? reduction_values[lane][part] + reduction_values[lane + step][part]
                    : extremum(reduction_values[lane][part], reduction_values[lane + step][part], kind == 3);
        barrier();
    }
    vec2 result = reduction_values[0];
    barrier();
    return result;
}
void select_maximum(inout float value, inout uint index, float other, uint other_index) {
    if ((!isnan(value) && isnan(other)) ||
        (!isnan(value) && !isnan(other) &&
         (other > value || (other == value && other_index < index)))) {
        value = other;
        index = other_index;
    }
}
void maximum_rows(inout vec2 values, inout uvec2 indices) {
    uint lane = gl_LocalInvocationID.x;
    reduction_values[lane] = values;
    reduction_indices[lane] = indices;
    barrier();
    for (uint step = 64; step != 0; step >>= 1) {
        if (lane < step)
            for (uint part = 0; part < 2; ++part)
                select_maximum(reduction_values[lane][part], reduction_indices[lane][part],
                    reduction_values[lane + step][part], reduction_indices[lane + step][part]);
        barrier();
    }
    values = reduction_values[0];
    indices = reduction_indices[0];
    barrier();
}
void reduce_axis(inout uint row, inout uint column, inout uint offset,
                 uint dimension, uint stride, uint bit) {
    uint coordinate;
    if ((reduction_axes & bit) != 0) {
        coordinate = column % dimension;
        column /= dimension;
    } else {
        coordinate = row % dimension;
        row /= dimension;
    }
    offset += coordinate * stride;
}
float reduced_value(uint row, uint column) {
    uint offset = origin.a;
    reduce_axis(row, column, offset, dim7, sa7, 128u);
    reduce_axis(row, column, offset, dim6, sa6, 64u);
    reduce_axis(row, column, offset, dim5, sa5, 32u);
    reduce_axis(row, column, offset, dim4, sa4, 16u);
    reduce_axis(row, column, offset, dim3, sa3, 8u);
    reduce_axis(row, column, offset, dim2, sa2, 4u);
    reduce_axis(row, column, offset, dim1, sa1, 2u);
    reduce_axis(row, column, offset, dim0, sa0, 1u);
    return decode(load_bytes(0, offset, width(type_a)), type_a);
}
uint soft_index(uint row, uint column) {
    return (row / reduction_inner * reduction_width + column) * reduction_inner + row % reduction_inner;
}
float soft_value(uint row, uint column) {
    uvec3 offsets = tensor_address(soft_index(row, column));
    if (reduction_mask == 2 && load_bytes(1, offsets.y, 1) == 0)
        return negative_infinity();
    precise float scaled = decode(load_bytes(0, offsets.x, width(type_a)), type_a) * uintBitsToFloat(fill_lo);
    return reduction_mask == 1 ? scaled + decode(load_bytes(1, offsets.y, width(type_b)), type_b) : scaled;
}
vec2 soft_rows(uint row, uint column) {
    return vec2(soft_value(row, column), rows_per_group == 2 && row + 1 < reduction_rows
        ? soft_value(row + 1, column) : negative_infinity());
}
float log_one_plus(float tail) {
    // Avoid native log near one. The omitted term is at most tail^6 / 6;
    // precise also preserves the cancellation in the compensated branch.
    if (tail < 0.015625) {
        precise float result = tail * (1.0 + tail * (-0.5 + tail *
            (1.0 / 3.0 + tail * (-0.25 + tail * 0.2))));
        return result;
    }
    precise float sum = 1.0 + tail;
    precise float delta = sum - 1.0;
    precise float result = log(sum) * (tail / delta);
    return result;
}
float normalized_value(float value, float maximum, float normalizer, bool exponential) {
    if (isnan(maximum) || isinf(maximum)) return quiet_nan();
    if (mode == 1) {
        precise float shifted = value - maximum;
        precise float result = shifted - normalizer;
        return result;
    }
    return (exponential ? value : exp(value - maximum)) * normalizer;
