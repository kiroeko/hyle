shared vec2 sums[128];
vec2 row_sum(vec2 partial) {
    uint lane = gl_LocalInvocationID.x;
    sums[lane] = partial;
    barrier();
    for (uint step = 64; step > 0; step >>= 1) {
        if (lane < step) sums[lane] += sums[lane + step];
        barrier();
    }
    vec2 result = sums[0];
    barrier(); // All readers finish before the next reduction overwrites sums.
