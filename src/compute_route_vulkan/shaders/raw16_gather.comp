#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

// Storage lanes only: no floating conversion or sixteen-bit arithmetic. The
// original index-check dispatch produces safe I32 IDs and the shared status.
layout(local_size_x = 128) in;
layout(binding = 0) readonly buffer Source { uint16_t source[]; };
layout(binding = 1) readonly buffer Indices { uint indices[]; };
layout(binding = 2) readonly buffer CheckedStatus { uint status[]; };
layout(binding = 3) writeonly buffer Destination { uint16_t destination[]; };
layout(push_constant) uniform Origins { uint source; uint indices; uint status; uint destination; } origin;
layout(constant_id = 0) const uint width = 1;
layout(constant_id = 1) const uint pitch = 1;
layout(constant_id = 2) const uint count = 1;

void main() {
    uint index = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 128u;
    if (index >= count || status[origin.status / 4u] != 0u) return;
    uint row = index / width;
    uint selected = indices[origin.indices / 4u + row];
    destination[origin.destination / 2u + index] =
        source[origin.source / 2u + selected * pitch + index % width];
}
