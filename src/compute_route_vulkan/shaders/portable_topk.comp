#version 450

// Core U32 storage and ordinary inter-dispatch dependencies. No optional
// Vulkan memory model, cross-workgroup spin barrier or floating comparator.
layout(local_size_x = 128) in;
layout(binding = 0) readonly buffer Input { uint a[]; };
layout(binding = 1) buffer Scratch { uint b[]; };
layout(binding = 2) writeonly buffer Values { uint values[]; };
layout(binding = 3) writeonly buffer Indices { uint indices[]; };
layout(push_constant) uniform Origins {
    uint a; uint b; uint values; uint indices; uint size; uint distance;
} origin;
layout(constant_id = 0) const uint mode = 0;
layout(constant_id = 1) const uint rows = 1;
layout(constant_id = 2) const uint width = 1;
layout(constant_id = 3) const uint padded = 1;
layout(constant_id = 4) const uint count = 1;
layout(constant_id = 5) const uint largest = 1;

uint load_word(uint offset) {
    uint word = a[offset / 4u], shift = (offset % 4u) * 8u;
    return shift == 0u ? word :
        (word >> shift) | (a[offset / 4u + 1u] << (32u - shift));
}
uvec2 item(uint index) {
    uint offset = origin.a / 4u + index * 2u;
    return uvec2(a[offset], a[offset + 1u]);
}
bool before(uvec2 x, uvec2 y) {
    bool xv = x.y < width, yv = y.y < width;
    if (xv != yv) return xv;
    if (!xv) return x.y < y.y;
    uint xm = x.x & 0x7fffffffu, ym = y.x & 0x7fffffffu;
    bool xn = xm > 0x7f800000u, yn = ym > 0x7f800000u;
    // The original stable TopK contract places every NaN after numbers,
    // preserves payloads and regards signed zeros as equal.
    if (xn != yn) return !xn;
    if (xn || x.x == y.x || (xm == 0u && ym == 0u)) return x.y < y.y;
    uint xo = (x.x & 0x80000000u) != 0u ? ~x.x : x.x ^ 0x80000000u;
    uint yo = (y.x & 0x80000000u) != 0u ? ~y.x : y.x ^ 0x80000000u;
    return largest != 0u ? xo > yo : xo < yo;
}
void main() {
    uint index = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 128u +
                 gl_LocalInvocationID.x;
    if (mode == 2u) {
        if (index >= rows * count) return;
        uvec2 chosen = item((index / count) * padded + index % count);
        values[origin.values / 4u + index] = chosen.x;
        indices[origin.indices / 4u + index] = chosen.y;
        return;
    }
    if (index >= rows * padded) return;
    uint column = index % padded;
    uvec2 result;
    if (mode == 0u) {
        uint bits = column < width
            ? load_word(origin.a + ((index / padded) * width + column) * 4u) : 0u;
        result = uvec2(bits, column);
    } else {
        uvec2 x = item(index), y = item((index / padded) * padded + (column ^ origin.distance));
        bool first = ((column & origin.distance) == 0u) == ((column & origin.size) == 0u);
        result = before(x, y) == first ? x : y;
    }
    b[origin.b / 4u + index * 2u] = result.x;
    b[origin.b / 4u + index * 2u + 1u] = result.y;
}
