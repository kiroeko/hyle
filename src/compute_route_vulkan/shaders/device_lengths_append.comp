#version 450
#ifdef HYLE_APPEND_RAW16
#extension GL_EXT_shader_16bit_storage : require
#define Element uint16_t
#define UNIT 2u
#else
#define Element uint
#define UNIT 4u
#endif
layout(local_size_x=64) in;
layout(binding=0) readonly buffer Rows { Element rows[]; };
layout(binding=1) buffer Arena { Element arena[]; };
layout(binding=2) buffer Checked { uint checked[]; };
layout(binding=3) readonly buffer Metadata { uint metadata[]; };
layout(binding=4) readonly buffer Query { int query[]; };
layout(binding=5) readonly buffer Kv { int kv[]; };
layout(binding=6) buffer Verdict { uint verdict[]; };
layout(binding=7) readonly buffer SourceCheck { uint source_check[]; };
layout(push_constant) uniform Origins {
  uint rows; uint arena; uint checked; uint metadata;
  uint query; uint kv; uint verdict; uint source_check;
} origin;
layout(constant_id=0) const uint phase=0;
layout(constant_id=1) const uint requests=1;
layout(constant_id=2) const uint physical_pages=1;
layout(constant_id=3) const uint page_rows=16;
layout(constant_id=4) const uint input_rows=1;
layout(constant_id=5) const uint instruction_capacity=1;
layout(constant_id=6) const uint row_units=1;
layout(constant_id=7) const uint page_capacity=1;
uint word(uint i) { return metadata[origin.metadata/4u+i]; }
void fail() {
  atomicOr(checked[origin.checked/4u],4u);
  atomicOr(verdict[origin.verdict/4u],4u);
}
void main() {
  const uint lane=gl_LocalInvocationID.x, group=gl_WorkGroupID.x;
  if (phase==1u) {
    if (lane==0u && source_check[origin.source_check/4u]!=0u) fail();
    return;
  }
  if (phase==0u) {
    if (lane!=0u) return;
    verdict[origin.verdict/4u]=0u;
    if (word(0)<1u+requests || word(0)>instruction_capacity || word(1)!=0u ||
        word(2)!=0u || word(3)!=0u || word(4)!=requests ||
        word(5)>word(0)-1u-requests || word(5)>page_capacity) { fail(); return; }
    for (uint i=6u;i<12u;++i) if (word(i)!=0u) { fail(); return; }
    uint total=0u;
    for (uint r=0u;r<requests;++r) {
      const uint b=12u+8u*r;
      for (uint i=4u;i<8u;++i) if (word(b+i)!=0u) { fail(); return; }
      int q=query[origin.query/4u+r], k=kv[origin.kv/4u+r];
      if (q<0 || k<q || uint(q)>word(b) || uint(k)>word(b+3u) ||
          uint(k-q)<word(b+1u) || uint(k-q)>word(b+2u) || uint(q)>input_rows-total) { fail(); return; }
      total+=uint(q);
    }
    for (uint i=0u;i<word(5);++i) {
      const uint b=12u+8u*(requests+i);
      const uint r=word(b), logical=word(b+1u), destination=word(b+2u), initialized=word(b+3u);
      if (r>=requests || destination>=physical_pages || initialized==0u || initialized>page_rows ||
          word(b+5u)>page_rows || word(b+6u)!=0u || word(b+7u)!=0u || logical>0xffffffffu/page_rows) { fail(); return; }
      const uint begin=logical*page_rows, q=uint(query[origin.query/4u+r]), k=uint(kv[origin.kv/4u+r]), old=k-q;
      const uint inherited=begin<old ? min(initialized,old-begin) : 0u;
      const uint live=begin<k ? min(initialized,k-begin) : 0u;
      uint packed=0u;
      for (uint j=0u;j<r;++j) packed+=uint(query[origin.query/4u+j]);
      const uint added=live>=inherited ? live-inherited : 0u;
      // Reorder the additions so even hostile coordinates cannot overflow.
      const uint relative=added!=0u ? max(begin,old)-old : 0u;
      if (inherited>live || (inherited!=0u && (word(b+4u)>=physical_pages || inherited>word(b+5u))) ||
          (added!=0u && (relative>input_rows-packed || added>input_rows-packed-relative))) { fail(); return; }
    }
    return;
  }
  if (atomicOr(checked[origin.checked/4u],0u)!=0u || group>=word(5)) return;
  const uint b=12u+8u*(requests+group), r=word(b), begin=word(b+1u)*page_rows;
  const uint old=uint(kv[origin.kv/4u+r]-query[origin.query/4u+r]);
  const uint last=uint(kv[origin.kv/4u+r]);
  const uint inherited=begin<old ? min(word(b+3u),old-begin) : 0u;
  const uint live=begin<last ? min(word(b+3u),last-begin) : 0u;
  uint packed=0u;
  for (uint j=0u;j<r;++j) packed+=uint(query[origin.query/4u+j]);
  const uint source_row=live>inherited ? packed+max(begin,old)-old : 0u;
  for (uint unit=lane;unit<word(b+3u)*row_units;unit+=64u) {
    const uint row=unit/row_units, column=unit%row_units;
    uint value=0u;
    if (row<inherited) value=uint(arena[origin.arena/UNIT+(word(b+4u)*page_rows+row)*row_units+column]);
    else if (row<live) value=uint(rows[origin.rows/UNIT+(source_row+row-inherited)*row_units+column]);
    arena[origin.arena/UNIT+word(b+2u)*page_rows*row_units+unit]=Element(value);
  }
}
