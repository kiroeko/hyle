#version 450
layout(local_size_x=128)in;
layout(binding=0)readonly buffer Query{uint q[];};
layout(binding=1)readonly buffer Bank{uint b[];};
layout(binding=2)buffer Status{uint status[];};
layout(binding=3)readonly buffer Weights{uint w[];};
layout(binding=4)readonly buffer Ranges{uint r[];};
#if defined(HYLE_ROW_INDEXER_PAGED)
layout(binding=5)readonly buffer Metadata{uint metadata_words[];};
layout(binding=6)writeonly buffer Scores{float scores[];};
layout(push_constant)uniform Origins{uint query;uint bank;uint status;uint weights;uint ranges;uint metadata;}origin;
#else
layout(binding=5)writeonly buffer Scores{float scores[];};
layout(push_constant)uniform Origins{uint query;uint bank;uint status;uint weights;uint ranges;}origin;
#endif
layout(constant_id=0)const uint phase=0;
layout(constant_id=1)const uint tokens=0;
layout(constant_id=2)const uint rows=0;
#if defined(HYLE_ROW_INDEXER_PAGED)
layout(constant_id=3)const uint q_offset=0;
layout(constant_id=4)const uint kv_offset=0;
layout(constant_id=5)const uint page_offset=0;
layout(constant_id=6)const uint tail_offset=0;
layout(constant_id=7)const uint page_size=1;
layout(constant_id=8)const uint max_pages=0;
layout(constant_id=9)const uint max_requests=0;
layout(constant_id=10)const uint max_refs=0;
#endif
shared float key[128],products[64];
uint load_word(uint port,uint offset) {
#if defined(HYLE_ROW_INDEXER_PAGED)
  if(port==5u)return metadata_words[offset];
#endif
  return port==0?q[offset]:port==1?b[offset]:port==3?w[offset]:r[offset];
}
uint load_bytes(uint port,uint offset,uint size) {
  uint at=offset/4u,shift=(offset&3u)*8u;
  uint value=load_word(port,at)>>shift;
  if(shift+size*8u>32u)value|=load_word(port,at+1u)<<(32u-shift);
  return size==4u?value:value&((1u<<(size*8u))-1u);
}
#if defined(HYLE_ROW_INDEXER_PAGED)
uint word(uint offset) {return load_bytes(5u,origin.metadata+offset*4u,4u);}
bool header(out uint requests,out uint refs) {
  requests=word(4u);refs=word(7u);
  if(requests>max_requests || refs>max_refs || word(5u)!=tokens)return false;
  return word(q_offset)==0u && word(q_offset+requests)==tokens &&
      word(kv_offset)==0u && word(kv_offset+requests)==refs;
}
uint request_for(uint token,uint requests) {
  uint lo=0u,hi=requests;
  while(lo<hi) {
    uint mid=lo+(hi-lo)/2u;
    if(int(word(q_offset+mid+1u))<=int(token))lo=mid+1u;else hi=mid;
  }
  return lo;
}
bool request_length(uint request,uint refs,out uint length) {
  length=0u;
  int first=int(word(kv_offset+request)),end=int(word(kv_offset+request+1u));
  int tail=int(word(tail_offset+request));
  if(first<0 || end<first || uint(end)>refs)return false;
  if(first==end)return tail==0;
  if(tail<=0 || uint(tail)>page_size || uint(tail)>rows)return false;
  // Repeated physical pages may form a logical history larger than the bank.
  // Bound before multiplying, including the last tail, without U32 overflow.
  uint full=uint(end-first-1);
  if(full>(rows-uint(tail))/page_size)return false;
  length=full*page_size+uint(tail);
  return true;
}
void validate_paged(uint work) {
  uint requests,refs;
  if(!header(requests,refs)) {atomicOr(status[0],1u);return;}
  uint stride=gl_NumWorkGroups.x*gl_NumWorkGroups.y*128u;
  for(uint request=work;request<requests;request+=stride) {
    int begin=int(word(q_offset+request)),end=int(word(q_offset+request+1u));
    uint length;
    if(begin<0 || end<begin || uint(end)>tokens || !request_length(request,refs,length))
      atomicOr(status[0],1u);
  }
  for(uint ref=work;ref<refs;ref+=stride) {
    int page=int(word(page_offset+ref));
    if(page<0 || uint(page)>=max_pages)atomicOr(status[0],1u);
  }
  if(work<tokens) {
    uint request=request_for(work,requests),length;
    if(request>=requests) {atomicOr(status[0],1u);return;}
    int first=int(word(q_offset+request)),last=int(word(q_offset+request+1u));
    int begin=int(load_bytes(4u,origin.ranges+work*8u,4u));
    int end=int(load_bytes(4u,origin.ranges+work*8u+4u,4u));
    if(first<0 || first>int(work) || last<=int(work) || uint(last)>tokens ||
       !request_length(request,refs,length) || begin<0 || end<begin || uint(end)>length)
      atomicOr(status[0],1u);
  }
}
#endif
uint decoded_key(uint code,uint scale) {
  const uint table[8]=uint[8](0u,1u,2u,3u,4u,6u,8u,12u);
  uint magnitude=table[code&7u],sign=(code&8u)<<12u;
  if(scale==255u)return sign|0x7fc0u;
  if(magnitude==0u)return sign;
  int power=int(scale)-128,top=findMSB(magnitude),exponent=power+top;
  if(exponent>127)return sign|0x7f80u;
  if(exponent>=-126)return sign|(uint(exponent+127)<<7u)|((magnitude<<uint(7-top))&127u);
  int shift=power+133;uint value=0u;
  if(shift>=0)value=magnitude<<uint(shift);
  else if(shift>-32) {
    uint right=uint(-shift),high=magnitude>>right,low=magnitude&((1u<<right)-1u),halfway=1u<<(right-1u);
    value=high+uint(low>halfway || (low==halfway && (high&1u)!=0u));
  }
  return sign|value;
}
float bfloat(float x) {
  uint bits=floatBitsToUint(x);
  if((bits&0x7fffffffu)>0x7f800000u)return uintBitsToFloat((bits&0xffff0000u)|0x00400000u);
  return uintBitsToFloat((bits+0x7fffu+((bits>>16u)&1u))&0xffff0000u);
}
void main() {
  uint group=gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x,lane=gl_LocalInvocationID.x;
  if(phase==0u) {
    uint t=group*128u+lane;
#if defined(HYLE_ROW_INDEXER_PAGED)
    validate_paged(t);
#else
    if(t<tokens) {
      int begin=int(load_bytes(4u,origin.ranges+t*8u,4u)),end=int(load_bytes(4u,origin.ranges+t*8u+4u,4u));
      if(begin<0 || end<begin || uint(end)>rows)atomicOr(status[0],1u);
    }
#endif
    return;
  }
  if(group>=tokens*rows || status[0]!=0u)return;
  uint t=group/rows,row=group%rows;
  int begin=int(load_bytes(4u,origin.ranges+t*8u,4u)),end=int(load_bytes(4u,origin.ranges+t*8u+4u,4u));
  if(row<uint(begin) || row>=uint(end)) {
    if(lane==0u)scores[group]=uintBitsToFloat(0xff800000u);
    return;
  }
  uint physical=row;
#if defined(HYLE_ROW_INDEXER_PAGED)
  // The complete validation dispatch already succeeded. Invisible columns
  // returned above, so only the exact request-local visible row touches bank.
  uint request=request_for(t,word(4u)),first=word(kv_offset+request);
  uint page=word(page_offset+first+row/page_size);
  physical=page*page_size+row%page_size;
#endif
  uint code=load_bytes(1u,origin.bank+physical*68u+lane/2u,1u);
  code=(code>>((lane&1u)*4u))&15u;
  uint scale=load_bytes(1u,origin.bank+physical*68u+64u+lane/32u,1u);
  key[lane]=uintBitsToFloat(decoded_key(code,scale)<<16u);
  barrier();
  if(lane<64u) {
    precise float dot=0.0;
    for(uint d=0u;d<128u;++d) {
      float query=uintBitsToFloat(load_bytes(0u,origin.query+((t*64u+lane)*128u+d)*2u,2u)<<16u);
      precise float product=query*key[d];dot=dot+product;
    }
    float value=bfloat(dot),positive=isnan(value)?value:(value>0.0?value:0.0);
    float weight=uintBitsToFloat(load_bytes(3u,origin.weights+(t*64u+lane)*2u,2u)<<16u);
    precise float product=positive*weight;products[lane]=bfloat(product);
  }
  barrier();
  if(lane==0u) {
    precise float total=0.0;
    for(uint h=0u;h<64u;++h)total=total+products[h];
    scores[group]=bfloat(total);
  }
}
