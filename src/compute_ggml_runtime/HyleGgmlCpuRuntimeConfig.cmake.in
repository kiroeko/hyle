@PACKAGE_INIT@

set(_hyle_cpu_program "@PACKAGE_HYLE_GGML_CPU_PROGRAM_INSTALLED_FILE@")
if(NOT EXISTS "${_hyle_cpu_program}")
  message(FATAL_ERROR "Hyle CPU SDK is missing its original optimized ggml program: ${_hyle_cpu_program}")
endif()
# find_dependency runs before the Hyle owner targets are imported.
hyle_register_runtime_files(
  TARGETS hyle_compute_ggml_runtime hyle::_factor_compute_ggml_runtime
  FILES "${_hyle_cpu_program}")
set(HyleGgmlCpuRuntime_FOUND TRUE)
unset(_hyle_cpu_program)
