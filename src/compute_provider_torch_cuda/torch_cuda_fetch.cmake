include_guard(GLOBAL)

# One private CUDA-leaf SDK, sharing the locked CPU host dispatch runtime.
# The original archives and CPU SDK are immutable; no Python runtime is used.
function(hyle_resolve_torch_cuda_leaf lock_file output)
  if(NOT WIN32)
    message(FATAL_ERROR "The CUDA ATen leaf SDK for this platform is not yet qualified")
  endif()
  set(HYLE_COMPUTE_TORCH_CUDA_ARCHIVE "" CACHE FILEPATH "Advanced: locked original CUDA Torch wheel")
  mark_as_advanced(HYLE_COMPUTE_TORCH_CUDA_ARCHIVE)
  file(READ "${lock_file}" _lock)
  string(JSON _digest GET "${_lock}" sdks torch_cuda_leaf platforms Windows-x86_64 sha256)
  string(JSON _url GET "${_lock}" sdks torch_cuda_leaf platforms Windows-x86_64 url)
  if(HYLE_DEP_SOURCE_CACHE)
    set(_cache "${HYLE_DEP_SOURCE_CACHE}")
  elseif(DEFINED ENV{HYLE_DEP_SOURCE_CACHE} AND NOT "$ENV{HYLE_DEP_SOURCE_CACHE}" STREQUAL "")
    set(_cache "$ENV{HYLE_DEP_SOURCE_CACHE}")
  else()
    set(_cache "$ENV{LOCALAPPDATA}/hyle/dependencies/v1")
  endif()
  get_filename_component(_cache "${_cache}" ABSOLUTE)
  set(_base "${_cache}/sdks/torch-cuda-leaf")
  if(IS_SYMLINK "${_base}")
    message(FATAL_ERROR "CUDA leaf SDK cache cannot be a symlink")
  endif()
  file(MAKE_DIRECTORY "${_base}")
  file(REAL_PATH "${_base}" _resolved)
  if(NOT _resolved STREQUAL _base)
    message(FATAL_ERROR "CUDA leaf SDK cache path traverses a symlink")
  endif()
  set(_directory "${_base}/Windows-${_digest}")
  file(LOCK "${_directory}.lock" GUARD FUNCTION TIMEOUT 60)
  if(NOT EXISTS "${_directory}")
    set(_archive "${HYLE_COMPUTE_TORCH_CUDA_ARCHIVE}")
    if(NOT _archive)
      set(_archive "${_directory}.whl")
      if(NOT EXISTS "${_archive}")
        if(FETCHCONTENT_FULLY_DISCONNECTED)
          message(FATAL_ERROR "CUDA leaf SDK missing offline: transfer managed SDK cache or set HYLE_COMPUTE_TORCH_CUDA_ARCHIVE to the locked wheel")
        endif()
        file(DOWNLOAD "${_url}" "${_archive}.partial" TLS_VERIFY ON
          INACTIVITY_TIMEOUT 60 TIMEOUT 900 STATUS _status SHOW_PROGRESS)
        list(GET _status 0 _code)
        if(NOT _code EQUAL 0)
          message(FATAL_ERROR "Cannot obtain CUDA leaf SDK: ${_status}")
        endif()
        file(SHA256 "${_archive}.partial" _actual)
        if(NOT _actual STREQUAL _digest)
          message(FATAL_ERROR "CUDA leaf SDK download SHA256 differs from lock")
        endif()
        file(RENAME "${_archive}.partial" "${_archive}")
      endif()
    endif()
    file(SHA256 "${_archive}" _actual)
    if(NOT _actual STREQUAL _digest)
      message(FATAL_ERROR "CUDA leaf SDK archive SHA256 differs from lock")
    endif()
    set(_stage "${_directory}.stage")
    if(EXISTS "${_stage}")
      if(IS_SYMLINK "${_stage}" OR NOT EXISTS "${_stage}/archive-sha256.txt")
        message(FATAL_ERROR "Foreign CUDA leaf SDK stage: ${_stage}")
      endif()
      file(READ "${_stage}/archive-sha256.txt" _owner)
      if(NOT _owner STREQUAL "${_digest}\n")
        message(FATAL_ERROR "CUDA leaf SDK stage has a different archive identity")
      endif()
      # Re-extract the complete fixed selection from the verified archive.
      # No recursive deletion and no acceptance of an incomplete extraction.
    endif()
    file(MAKE_DIRECTORY "${_stage}")
    file(WRITE "${_stage}/archive-sha256.txt" "${_digest}\n")
    file(ARCHIVE_EXTRACT INPUT "${_archive}" DESTINATION "${_stage}"
      PATTERNS "torch/include/*" "torch/lib/*.dll" "torch/lib/c10_cuda.lib"
               "torch/lib/torch_cuda.lib" "torch-*.dist-info/LICENSE"
               "torch-*.dist-info/NOTICE")
    # These names belong exclusively to the CPU common SDK. The two math
    # providers may coexist without overwriting any of its DLLs.
    foreach(_name IN ITEMS asmjit c10 fbgemm libiomp5md torch torch_cpu uv torch_python shm)
      file(REMOVE "${_stage}/torch/lib/${_name}.dll")
    endforeach()
    file(GLOB_RECURSE _files LIST_DIRECTORIES FALSE RELATIVE "${_stage}" "${_stage}/*")
    list(SORT _files)
    set(_manifest "")
    foreach(_file IN LISTS _files)
      file(SHA256 "${_stage}/${_file}" _hash)
      string(APPEND _manifest "${_hash}  ${_file}\n")
    endforeach()
    file(WRITE "${_stage}/sha256.txt" "${_manifest}")
    file(RENAME "${_stage}" "${_directory}")
  endif()
  if(IS_SYMLINK "${_directory}" OR NOT EXISTS "${_directory}/sha256.txt")
    message(FATAL_ERROR "Foreign or incomplete CUDA leaf SDK cache")
  endif()
  file(STRINGS "${_directory}/sha256.txt" _lines)
  foreach(_line IN LISTS _lines)
    string(SUBSTRING "${_line}" 0 64 _expected)
    string(SUBSTRING "${_line}" 66 -1 _relative)
    if(IS_ABSOLUTE "${_relative}" OR _relative MATCHES "(^|/)\\.\\.(/|$)")
      message(FATAL_ERROR "Unsafe CUDA SDK cache manifest path")
    endif()
    file(SHA256 "${_directory}/${_relative}" _actual)
    if(NOT _actual STREQUAL _expected)
      message(FATAL_ERROR "Corrupt CUDA leaf SDK cache: ${_relative}")
    endif()
  endforeach()
  foreach(_file IN ITEMS c10_cuda.dll torch_cuda.dll c10_cuda.lib torch_cuda.lib)
    if(NOT EXISTS "${_directory}/torch/lib/${_file}")
      message(FATAL_ERROR "Incomplete original CUDA leaf SDK: ${_file}")
    endif()
  endforeach()
  set(${output} "${_directory}/torch" PARENT_SCOPE)
endfunction()

function(hyle_import_torch_cuda_leaf root cpu_root)
  foreach(_name IN ITEMS c10_cuda torch_cuda)
    if(NOT TARGET hyle_vendor_${_name})
      add_library(hyle_vendor_${_name} SHARED IMPORTED GLOBAL)
      set_target_properties(hyle_vendor_${_name} PROPERTIES
        IMPORTED_LOCATION "${root}/lib/${_name}.dll"
        IMPORTED_IMPLIB "${root}/lib/${_name}.lib")
    endif()
  endforeach()
  file(GLOB _runtime "${root}/lib/*.dll" "${cpu_root}/lib/*.dll")
  # Installed dependency configs run before HyleRuntimeStaging is included.
  foreach(_owner IN ITEMS hyle_compute_provider_torch_cuda hyle::_factor_compute_provider_torch_cuda)
    string(SHA256 _key "${_owner}")
    set_property(GLOBAL APPEND PROPERTY "HYLE_RUNTIME_FILES_${_key}" ${_runtime})
  endforeach()
endfunction()
