include_guard(GLOBAL)

function(_hyle_torch_cuda_linux_archive record cache output)
  string(JSON _digest GET "${record}" sha256)
  string(JSON _url GET "${record}" url)
  set(_archive "${cache}/${_digest}.whl")
  if(HYLE_COMPUTE_TORCH_CUDA_ARCHIVES_DIR)
    set(_archive "${HYLE_COMPUTE_TORCH_CUDA_ARCHIVES_DIR}/${_digest}.whl")
  endif()
  if(NOT EXISTS "${_archive}")
    if(FETCHCONTENT_FULLY_DISCONNECTED)
      message(FATAL_ERROR "Missing locked CUDA Linux archive offline: ${_digest}; transfer its managed original archive cache")
    endif()
    file(DOWNLOAD "${_url}" "${_archive}.partial" TLS_VERIFY ON
      INACTIVITY_TIMEOUT 60 TIMEOUT 900 STATUS _status SHOW_PROGRESS)
    list(GET _status 0 _code)
    if(NOT _code EQUAL 0)
      message(FATAL_ERROR "Cannot obtain original CUDA Linux runtime: ${_status}")
    endif()
    file(SHA256 "${_archive}.partial" _actual)
    if(NOT _actual STREQUAL _digest)
      message(FATAL_ERROR "Original CUDA Linux runtime archive differs from lock")
    endif()
    file(RENAME "${_archive}.partial" "${_archive}")
  endif()
  file(SHA256 "${_archive}" _actual)
  if(NOT _actual STREQUAL _digest)
    message(FATAL_ERROR "Locked CUDA Linux archive SHA mismatch: ${_archive}")
  endif()
  set(${output} "${_archive}" PARENT_SCOPE)
endfunction()

function(hyle_resolve_torch_cuda_linux lock_file output)
  set(HYLE_COMPUTE_TORCH_CUDA_ARCHIVES_DIR "" CACHE PATH "Advanced: directory of locked original CUDA Linux wheels named by SHA256")
  mark_as_advanced(HYLE_COMPUTE_TORCH_CUDA_ARCHIVES_DIR)
  file(READ "${lock_file}" _lock)
  string(JSON _record GET "${_lock}" sdks torch_cuda_leaf platforms Linux-x86_64)
  string(JSON _digest GET "${_record}" sha256)
  if(HYLE_DEP_SOURCE_CACHE)
    set(_cache "${HYLE_DEP_SOURCE_CACHE}")
  elseif(DEFINED ENV{HYLE_DEP_SOURCE_CACHE} AND NOT "$ENV{HYLE_DEP_SOURCE_CACHE}" STREQUAL "")
    set(_cache "$ENV{HYLE_DEP_SOURCE_CACHE}")
  elseif(DEFINED ENV{XDG_CACHE_HOME} AND NOT "$ENV{XDG_CACHE_HOME}" STREQUAL "")
    set(_cache "$ENV{XDG_CACHE_HOME}/hyle/dependencies/v1")
  else()
    set(_cache "$ENV{HOME}/.cache/hyle/dependencies/v1")
  endif()
  get_filename_component(_cache "${_cache}" ABSOLUTE)
  set(_base "${_cache}/sdks/torch-cuda-leaf")
  file(MAKE_DIRECTORY "${_base}/original-archives")
  file(REAL_PATH "${_base}" _resolved)
  if(NOT _resolved STREQUAL _base OR IS_SYMLINK "${_base}")
    message(FATAL_ERROR "CUDA Linux SDK cache cannot traverse a symlink")
  endif()
  string(SHA256 _bundle_identity "${_record}")
  string(SUBSTRING "${_bundle_identity}" 0 16 _bundle_short)
  set(_directory "${_base}/Linux-${_digest}-${_bundle_short}")
  file(LOCK "${_directory}.lock" GUARD FUNCTION TIMEOUT 60)
  if(NOT EXISTS "${_directory}")
    _hyle_torch_cuda_linux_archive("${_record}" "${_base}/original-archives" _archive)
    set(_stage "${_directory}.stage")
    if(EXISTS "${_stage}")
      if(IS_SYMLINK "${_stage}" OR NOT EXISTS "${_stage}/archive-sha256.txt")
        message(FATAL_ERROR "Foreign CUDA Linux SDK stage: ${_stage}")
      endif()
      file(READ "${_stage}/archive-sha256.txt" _owner)
      if(NOT _owner STREQUAL "${_digest}\n")
        message(FATAL_ERROR "CUDA Linux SDK stage identity differs")
      endif()
    endif()
    file(MAKE_DIRECTORY "${_stage}")
    file(WRITE "${_stage}/archive-sha256.txt" "${_digest}\n")
    # Only original CUDA registration/kernels/headers. CPU host dispatch is
    # supplied by its unchanged SDK; no Python, CPU math DSO or model engine.
    file(ARCHIVE_EXTRACT INPUT "${_archive}" DESTINATION "${_stage}"
      PATTERNS "torch/include/*" "torch/lib/libc10_cuda.so" "torch/lib/libtorch_cuda.so"
               "torch/lib/libcaffe2_nvrtc.so" "torch-*.dist-info/LICENSE" "torch-*.dist-info/NOTICE")
    string(JSON _count LENGTH "${_record}" runtime_assets)
    math(EXPR _last "${_count}-1")
    foreach(_index RANGE 0 ${_last})
      string(JSON _asset GET "${_record}" runtime_assets ${_index})
      _hyle_torch_cuda_linux_archive("${_asset}" "${_base}/original-archives" _runtime_archive)
      string(JSON _license_count LENGTH "${_asset}" license_files)
      math(EXPR _license_last "${_license_count}-1")
      set(_licenses "")
      foreach(_license_index RANGE 0 ${_license_last})
        string(JSON _license GET "${_asset}" license_files ${_license_index})
        list(APPEND _licenses "${_license}")
      endforeach()
      # Keep original NVIDIA package-relative paths: native RPATH resolves
      # ../../nvidia/*/lib without mutating any original DSO or system SDK.
      file(ARCHIVE_EXTRACT INPUT "${_runtime_archive}" DESTINATION "${_stage}"
        PATTERNS "nvidia/*/lib/*" ${_licenses})
    endforeach()
    file(GLOB_RECURSE _files LIST_DIRECTORIES FALSE RELATIVE "${_stage}" "${_stage}/*")
    list(SORT _files)
    set(_manifest "")
    foreach(_file IN LISTS _files)
      file(SHA256 "${_stage}/${_file}" _hash)
      string(APPEND _manifest "${_hash}  ${_file}\n")
    endforeach()
    file(WRITE "${_stage}/sha256.txt" "${_manifest}")
    file(RENAME "${_stage}" "${_directory}")
  endif()
  if(IS_SYMLINK "${_directory}" OR NOT EXISTS "${_directory}/sha256.txt")
    message(FATAL_ERROR "Foreign or incomplete CUDA Linux SDK cache")
  endif()
  file(STRINGS "${_directory}/sha256.txt" _lines)
  foreach(_line IN LISTS _lines)
    string(SUBSTRING "${_line}" 0 64 _expected)
    string(SUBSTRING "${_line}" 66 -1 _relative)
    if(IS_ABSOLUTE "${_relative}" OR _relative MATCHES "(^|/)\\.\\.(/|$)")
      message(FATAL_ERROR "Unsafe CUDA Linux SDK manifest path")
    endif()
    file(SHA256 "${_directory}/${_relative}" _actual)
    if(NOT _actual STREQUAL _expected)
      message(FATAL_ERROR "Corrupt original CUDA Linux SDK: ${_relative}")
    endif()
  endforeach()
  foreach(_file IN ITEMS libc10_cuda.so libtorch_cuda.so)
    if(NOT EXISTS "${_directory}/torch/lib/${_file}")
      message(FATAL_ERROR "Incomplete CUDA Linux leaf runtime")
    endif()
  endforeach()
  set(${output} "${_directory}/torch" PARENT_SCOPE)
endfunction()
