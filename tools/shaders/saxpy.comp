#version 450

// saxpy: o[i] = alpha*x[i] + beta*y[i] + bias
// 3 storage buffers (bindings 0,1,2) + a push-constant block {uint n; float alpha,beta,bias}.
// The HYLE Vulkan backend binds Buffer args to descriptor slots 0..N in order and pushes the
// packed scalar blob as push constants (see kernel.h unified launch ABI). local_size_x=256
// matches the launch's blocks_for(n, 256) grid. This is the source of tests/compute/
// saxpy_spirv.h (regenerated by tools/embed_spirv.py via hyle_embed_shader).

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer X { float x[]; };
layout(std430, binding = 1) readonly  buffer Y { float y[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };

layout(push_constant) uniform Params {
  uint  n;
  float alpha;
  float beta;
  float bias;
} p;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i < p.n) {
    o[i] = p.alpha * x[i] + p.beta * y[i] + p.bias;
  }
}
