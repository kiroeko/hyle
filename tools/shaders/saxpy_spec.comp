#version 450

// saxpy with SPECIALIZATION CONSTANTS (checklist #2/#3): a variant of saxpy.comp whose
// local_size AND a scale factor are spec constants, resolved at pipeline-build time (not
// runtime push constants). Proves HYLE's spec-constant path end-to-end:
//   constant_id = 0  ->  local_size_x  (workgroup size baked into the pipeline)
//   constant_id = 1  ->  SCALE         (extra multiplier folded into the compute)
// The test builds the pipeline with SCALE != its default (7.0) and checks the result scaled
// by the SUPPLIED value -- if spec data were ignored, the default would produce a wrong
// answer, so a green test is proof the constant reached the driver's compile.

layout(local_size_x_id = 0) in;            // local_size_x comes from spec constant 0
layout(constant_id = 1) const float SCALE = 7.0;  // default 7.0; the test overrides it

layout(std430, binding = 0) readonly  buffer X { float x[]; };
layout(std430, binding = 1) readonly  buffer Y { float y[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };

layout(push_constant) uniform Params {
  uint  n;
  float alpha;
  float beta;
  float bias;
} p;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i < p.n) {
    o[i] = SCALE * (p.alpha * x[i] + p.beta * y[i] + p.bias);
  }
}
