#version 450
#extension GL_GOOGLE_include_directive : require
#include "sampling_math.glsl"

layout(local_size_x=128) in;
layout(push_constant) uniform Shape {uint count;} shape;
layout(binding=0) readonly buffer Input {uint words[];} input0;
layout(binding=1) buffer Output {float values[];} output0;
void main() {
  uint i=gl_GlobalInvocationID.x;
  if(i<shape.count)output0.values[i]=gumbel(input0.words[i*2],input0.words[i*2+1]);
}
