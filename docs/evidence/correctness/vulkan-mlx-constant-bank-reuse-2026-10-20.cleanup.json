  "script_text": "$ErrorActionPreference = 'Stop'\n$repo = [IO.Path]::GetFullPath($PSScriptRoot)\n$scope = [IO.Path]::GetFullPath((Join-Path $repo '.scratch/architecture-refactor-2026-10-18'))\n$planFile = Join-Path $scope 'vulkan-mlx-constant-bank-reuse/cleanup/plan.json'\n$plan = Get-Content -Raw -LiteralPath $planFile | ConvertFrom-Json\nif ($plan.scope -ne $scope) { throw 'Cleanup plan scope mismatch' }\n$protectedPaths = @($plan.protected | ForEach-Object { [IO.Path]::GetFullPath($_.path) })\nforeach ($row in @($plan.protected) + @($plan.files)) {\n    $resolved = (Resolve-Path -LiteralPath $row.path).ProviderPath\n    if ([IO.Path]::GetFullPath($row.path) -ne $resolved) { throw \"Unexpected resolved path: $resolved\" }\n    $file = Get-Item -LiteralPath $resolved\n    if ($file.PSIsContainer -or $file.Length -ne $row.bytes) { throw \"Changed cleanup proof: $resolved\" }\n    if ((Get-FileHash -Algorithm SHA256 -LiteralPath $resolved).Hash.ToLowerInvariant() -ne $row.sha256) { throw \"Changed hash: $resolved\" }\n}\nforeach ($row in $plan.files) {\n    $path = [IO.Path]::GetFullPath($row.path)\n    if (-not $path.StartsWith($scope + [IO.Path]::DirectorySeparatorChar, [StringComparison]::OrdinalIgnoreCase)) { throw \"Outside cleanup scope: $path\" }\n    if ($protectedPaths -contains $path) { throw \"Protected file: $path\" }\n    if ([IO.Path]::GetExtension($path) -notin @('.map','.lib','.exp','.exe')) { throw \"Unexpected cleanup type: $path\" }\n}\n$removed = @()\nforeach ($row in $plan.files) {\n    Remove-Item -LiteralPath $row.path -Force\n    if (Test-Path -LiteralPath $row.path) { throw \"Removal failed: $($row.path)\" }\n    $removed += $row\n}\nforeach ($row in $plan.protected) {\n    if ((Get-FileHash -Algorithm SHA256 -LiteralPath $row.path).Hash.ToLowerInvariant() -ne $row.sha256) { throw \"Protected file changed: $($row.path)\" }\n}\n$result = [ordered]@{ completed = $true; files = $removed.Count; bytes = $plan.total_bytes; removed = $removed; protected = $plan.protected }\n$result | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath (Join-Path $scope 'vulkan-mlx-constant-bank-reuse/cleanup/executed.json') -Encoding utf8\nWrite-Output \"Removed $($removed.Count) rebuildable files, $($plan.total_bytes) bytes; protected images and evidence unchanged.\"\n",
  "scope": "Only exact obsolete test images and rebuildable maps/import/export libraries. Current bank image, direct bank comparison, CPU/CUDA/model images, objects, SDKs and numerical evidence retained."
