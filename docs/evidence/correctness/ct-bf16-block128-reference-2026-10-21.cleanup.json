  "source_script": "# Exact CT BF16 block128 test-artifact cleanup. No recursive directory removal.\r\n$ErrorActionPreference = 'Stop'\r\n$plan = Get-Content -LiteralPath 'C:\\public\\project-hyle\\hyle\\.scratch\\architecture-refactor-2026-10-18\\ct-bf16-block128-reference\\root\\cleanup-plan.json' -Raw | ConvertFrom-Json\r\n$separator = [IO.Path]::DirectorySeparatorChar\r\n$allowed = [IO.Path]::GetFullPath($plan.allowed_windows).TrimEnd($separator) + $separator\r\nfunction Assert-Identity($row) {\r\n  $file = Get-Item -LiteralPath $row.path -ErrorAction Stop\r\n  if ($file.PSIsContainer -or ($file.Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw \"Not a regular file: $($row.path)\" }\r\n  if ($file.Length -ne $row.bytes -or (Get-FileHash -LiteralPath $row.path -Algorithm SHA256).Hash.ToLowerInvariant() -ne $row.sha256) { throw \"Identity changed: $($row.path)\" }\r\n}\r\nAssert-Identity $plan.evidence\r\nAssert-Identity $plan.archive\r\nforeach ($row in $plan.remove_windows) {\r\n  $full = [IO.Path]::GetFullPath($row.path)\r\n  if (-not $full.StartsWith($allowed, [StringComparison]::OrdinalIgnoreCase) -or [IO.Path]::GetExtension($full) -notin '.exe','.map') { throw \"Outside exact artifact scope: $full\" }\r\n  Assert-Identity $row\r\n}\r\nforeach ($row in $plan.keep_windows) { Assert-Identity $row }\r\n$active = @(Get-CimInstance Win32_Process | Where-Object { $_.ExecutablePath -and $_.ExecutablePath.StartsWith($allowed, [StringComparison]::OrdinalIgnoreCase) })\r\nif ($active.Count) { throw 'A test executable in this exact workspace is still running' }\r\nforeach ($row in $plan.remove_windows) { Remove-Item -LiteralPath $row.path -Force }\r\nforeach ($row in $plan.keep_windows) { Assert-Identity $row }\r\n$macProgram = @'\r\nimport pathlib,hashlib,json,subprocess\r\nplan=json.loads('{\"allowed_mac\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/ct-bf16-block128-reference\", \"remove_mac\": [{\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/ct-bf16-block128-reference/apple/ct-block128-qdq.map\", \"bytes\": 4668087, \"sha256\": \"430c1cbfd0d8f8c9baf181dc54ed686c021bacdb4be6b44ad22161cd65b5dd51\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/ct-bf16-block128-reference/apple/ct-block128-qdq\", \"bytes\": 15725840, \"sha256\": \"2cb7aa20835f91fd4a834d09bc203cfc91a95e8d0e1c0c1d1ecadedfb74d0995\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/ct-bf16-block128-reference/apple/activation-edges/ct-activation-edges\", \"bytes\": 15764928, \"sha256\": \"4886ca910c67a1e94451f6746edc284060c1f292254d12922c96c94bc39f2bbf\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/ct-bf16-block128-reference/apple/activation-edges/ct-activation-edges.map\", \"bytes\": 4681882, \"sha256\": \"69672cfde6446314cbd2b9aae2c97a2ad454a4f102fed6d57c144eb7121ea9d0\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/ct-bf16-block128-reference/apple/activation-edges/diagnostic/probe\", \"bytes\": 15768712, \"sha256\": \"1032408b26e4b68acffd1c462e37c18af08fe07bbbc6192b98c23b53201ec8c8\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/ct-bf16-block128-reference/apple/activation-edges/diagnostic/probe.map\", \"bytes\": 4689410, \"sha256\": \"058845764775a96ff40870763c9300fd95bf7651b804678cb47734533609e95b\"}], \"keep_mac\": [{\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/ct-bf16-block128-reference/apple/objects/src--compute_route_apple--apple_operations.cc.o\", \"bytes\": 171616, \"sha256\": \"e6098fda2d316f33dac7a89d88cfc89a60863569735ec60ff0b68c9b4b05d7fd\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/ct-bf16-block128-reference/apple/objects/tests--graph_route_apple--ct_block128_qdq_test.cc.o\", \"bytes\": 217304, \"sha256\": \"8904883414e489a2baa35ca7a626fdb794982906f9f4084703b367a7a59300ce\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/ct-bf16-block128-reference/apple/activation-edges/objects/src--compute_route_apple--apple_mature_float.cc.o\", \"bytes\": 137832, \"sha256\": \"34a51085ed6228d588affed2ca006e8aa74a03e2da8de953ca989d9896071ffa\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/ct-bf16-block128-reference/apple/activation-edges/objects/src--compute_route_apple--apple_operations.cc.o\", \"bytes\": 171624, \"sha256\": \"4f9017b8e537c27eda0b98d26ac981e07d1120194761c40c377d8ae753553265\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/ct-bf16-block128-reference/apple/activation-edges/objects/src--compute_route_apple--apple_static_fp8.cc.o\", \"bytes\": 58048, \"sha256\": \"387e58543b4fb5149745768c6a12aeabbb35928837aadaf0808a78f861e20e59\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/ct-bf16-block128-reference/apple/activation-edges/objects/tests--graph_route_apple--ct_block128_activation_edges_test.cc.o\", \"bytes\": 148144, \"sha256\": \"9d4b2741a5a8c3ca19d56adf1d7c55dff43c9775792e81ab82e375d61fe1e010\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/ct-bf16-block128-reference/apple/activation-edges/diagnostic/probe.o\", \"bytes\": 109240, \"sha256\": \"b936bf1302bb7b8cd9f46d56fedbd7a85cb9dca28ff1ccd34812642b9abf3d80\"}]}')\r\nbase=pathlib.Path(plan['allowed_mac']); assert base.is_dir() and not base.is_symlink()\r\ndef verify(row):\r\n p=pathlib.Path(row['path']); assert p.is_absolute() and not p.is_symlink() and p.resolve().is_relative_to(base.resolve())\r\n assert p.is_file() and p.stat().st_size==row['bytes'] and hashlib.sha256(p.read_bytes()).hexdigest()==row['sha256'],str(p)\r\n return p\r\npaths=[verify(x) for x in plan['remove_mac']]\r\nfor row in plan['keep_mac']:verify(row)\r\nactive=subprocess.check_output(['ps','-axo','command='],text=True)\r\nassert not any(str(p) in command for p in paths for command in active.splitlines() if not command.startswith('python3 -')), 'test executable is running'\r\nfor p in paths:p.unlink()\r\nfor row in plan['keep_mac']:verify(row)\r\nprint(json.dumps(dict(removed=len(paths),bytes=sum(x['bytes'] for x in plan['remove_mac']),kept_objects=len(plan['keep_mac']))))\r\n'@\r\n$macResult = $macProgram | & ssh kiro@172.22.10.198 python3 -\r\nif ($LASTEXITCODE -ne 0) { throw 'Mac exact-file cleanup failed; do not report both platforms completed' }\r\n$result = [ordered]@{\r\n  completed = $true\r\n  windows_removed = @($plan.remove_windows).Count\r\n  windows_bytes = ($plan.remove_windows | Measure-Object -Property bytes -Sum).Sum\r\n  windows_kept_objects = @($plan.keep_windows).Count\r\n  mac = ($macResult | ConvertFrom-Json)\r\n  evidence_sha256 = $plan.evidence.sha256\r\n  archive_sha256 = $plan.archive.sha256\r\n  exact_plan = $plan\r\n  source_script = (Get-Content -LiteralPath $PSCommandPath -Raw)\r\n}\r\n$result | ConvertTo-Json -Depth 18 | Set-Content -LiteralPath 'C:\\public\\project-hyle\\hyle\\docs\\evidence\\correctness\\ct-bf16-block128-reference-2026-10-21.cleanup.json' -Encoding utf8\r\n$result | Select-Object completed,windows_removed,windows_bytes,windows_kept_objects,mac | ConvertTo-Json -Depth 5\r\n"
