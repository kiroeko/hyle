    "items": [
      {
        "id": 1,
        "owner": "Consumer cold backend/constant ownership assembly",
        "source": [
          "tools/qwen35_text/main.cc:908-912",
          "tools/qwen35_text/main.cc:231-256",
          "tools/qwen35_text/main.cc:1363",
          "include/hyle/compute/storage_owner.h:34"
        ],
        "fact": "Model constructs only common CUDA Context/device/pinned resource/Queue and calls graph::cuda::compile. Recipe constants freeze through StorageOwner, whose adoption currently accepts common compute::Context, not native Apple/Vulkan Context.",
        "minimal_change": "Cold assembly owns the actual native Context/resources and ExecutionSource, supplies original StorageDomains/target to graph::batch::compile, and keeps ready constant leases plus their actual resource/Context lifetime. ConstantBinding owner is optional; a Model-private native asset owner can preserve required lifetimes without adding provider-dependent model operations or a new public owner framework.",
        "classification": "Consumer assembly gap, not an absent model arithmetic operator."
      },
      {
        "id": 2,
        "owner": "Consumer weight loader boundary",
        "source": [
          "tools/qwen35_text/main.cc:704-708",
          "tools/qwen35_text/main.cc:810-818",
          "include/hyle/compute/apple_file_stream.h:10-12",
          "include/hyle/compute/vulkan_file_stream.h:10-12"
        ],
        "fact": "Loader signature takes common CUDA Context/Queue and directly creates the CUDA FileResourcePipeline. Native Apple/Vulkan file pipeline factories already exist and take their actual Context without common Queue.",
        "minimal_change": "Keep one manifest/inventory/range/group loader and retirement checks; select only the cold pipeline factory and actual device/staging resource ownership. Reuse the same original 320/335 BF16/F32 bytes and no new weight copy/checkpoint conversion.",
        "classification": "Existing facility needs consumer wiring."
      },
      {
        "id": 3,
        "owner": "Consumer input/initialization/result-readback I/O",
        "source": [
          "tools/qwen35_text/main.cc:176-181",
          "tools/qwen35_text/main.cc:1465-1470",
          "tools/qwen35_text/main.cc:1817-1818",
          "tools/qwen35_text/main.cc:1930-1933",
          "tools/qwen35_text/main.cc:1977-1980",
          "tools/qwen35_text/main.cc:2028-2038",
          "tools/qwen35_text/main.cc:2220-2233",
          "src/compute_route_vulkan/vulkan_memory.cc:69-77"
        ],
        "fact": "Tensor writes/zero initialization and ID/trace reads directly use device BufferView operations; submit/preparation always supplies common Queue lane0. Vulkan device storage is not host-mappable and map_host accepts only staging. Apple shared storage has direct mapping, but native source still does not request a common Compute Queue.",
        "minimal_change": "Use original public native CopyBatch for external input upload, initial state fill and final ID/optional trace download, with actual Completion retirement; use the compiled lane queue requirements. Keep all per-layer state/append/attention computations in the same ordinary Graph and original native Runtime.",
        "classification": "Consumer boundary I/O gap; no per-layer host pipeline or device shadow state."
      },
      {
        "id": 4,
        "owner": "Consumer bindings/Graph output ownership integration",
        "source": [
          "tools/qwen35_text/main.cc:1506-1512",
          "tools/qwen35_text/main.cc:1910-1925",
          "tools/qwen35_text/main.cc:2062-2083",
          "src/graph_route_apple/native_region.cc:721-724",
          "src/graph_route_vulkan/native_region.cc:897-903",
          "src/graph/executable.cc:9047-9051"
        ],
        "fact": "Current consumer unconditionally binds caller buffers for ID/hidden/logits and WriteLease destinations for recurrent/conv/carry alternatives. Native Apple outputs are DeferredGenerated/NativeOnly; Vulkan outputs are BoundGenerated or StableGenerated. The existing Graph contract rejects rebinding an invocation-owned/generated output as caller storage.",
        "minimal_change": "Drive binding/readback from each concrete child Executable output_ownership and actual GraphOutput/storage_lease. Preserve exporting all selected ordinary state/carry results before ANY append take, then 12/14 takes, exact ready/reframe, unbind and one complete head publication. Existing Graph native output export is available; no fake destination or hidden output copy may impersonate its ownership.",
        "classification": "Real consumer ownership assumption to fix; native output export itself is implemented."
      },
      {
        "id": 5,
        "owner": "Consumer state resource policy plus native generated-result backing owner where needed",
        "source": [
          "tools/qwen35_text/main.cc:1035-1050",
          "tools/qwen35_text/main.cc:1499",
          "tools/qwen35_text/session_state.h:85-94",
          "src/compute_route_apple/apple_memory.mm:483-521",
          "src/compute_route_vulkan/vulkan_program.cc:884-890",
          "src/compute_route_vulkan/vulkan_memory.cc:295-324"
        ],
        "fact": "Current exact cache budget preallocates 36 state pools and hidden pools for caller-written outputs. Native generated state instead retains original MLX/Vulkan backing; simply retaining these in addition to the old preallocated destination pools misrepresents actual residency. Vulkan fixed native output backing cannot be overwritten while an old Snapshot/ReadLease retains it: its original reuse_gate explicitly rejects that case.",
        "minimal_change": "Choose a bounded storage policy honoring selected native ownership, charge actual persistent state once, report native-private allocations as unknown where not measurable, and preserve old prefix/snapshot owners. Apple can first use independent readonly MLX output owners; Vulkan needs an explicit supported original backing rebind/rotation or equivalent independently owned result mechanism for recurrent state. Do not remove reuse/retirement gates, copy into a shadow bank, or create per-session executors to evade them.",
        "classification": "Concrete bounded-owner/backing seam beyond changing includes. Exact native full-Qwen behavior and budgets have not been measured by this review."
      }
    ],
    "already_present_not_missing_operators": [
      "Four-input capacity+metadata paged reader and original same-Graph native append/write effect have current implementation; parent reports Apple BF16 D256 finite (1,1)/(2,2)/(2,1) actual passes.",
      "Symbolic logical families use common finite-exact specialization; child native compiles see concrete dimensions.",
      "F32 score output and GDN multiple snapshots have native implementations; they are integration/numerical acceptance items, not newly absent operators.",
      "Typed PagedArena/reframe/exclusive suffix permission, writer-only draft append, original Completion and whole-head transaction mechanisms already exist."
    ],
    "first_backend": {
      "choice": "Apple first is feasible with one original logical model graph and native ExecutionSource; current actual capacity fixture lowers risk, but full model is not claimed run.",
      "minimum_vertical_slice": "Implement only cold asset/source/loader/I/O and output ownership/budget seams; run plain R1 prefill plus continuation, then the same MTP graph roles with a short natural stream and complete target/draft/conv/GDN/carry state checks. Do not force expected acceptance or cross-backend byte identity.",
      "model_math": "No backend/provider branch inside Recipe/mtp_graph mathematical operations, no alternate executor. Backend choice is cold assembly and external I/O only.",
      "vulkan_difference": "Device-only I/O and fixed generated output backing retention need explicit treatment; no claim that changing Context alone enables complete native sessions."
    },
    "unverified": "No full Apple/Vulkan Qwen family compile, all-model operation coverage, 14-bank numerical transaction, native in-flight cancellation or performance was executed by this agent. A complete cold compile can still reveal additional real unsupported combinations."
