    "status": "bounded_read_only_source_review_no_build_or_gpu",
    "scope": "Same Qwen3.5-2B plain/MTP logical graph on native Apple or Vulkan; at most five concrete integration items.",
    "main_source": {
      "path": "tools/qwen35_text/main.cc",
