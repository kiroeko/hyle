set(_assets [==[]==])
set(_directory [==[C:/h7/apple-producer-probe/build/bin]==])
file(MAKE_DIRECTORY "${_directory}")
file(LOCK "${_directory}/.hyle-apple-runtime.lock" GUARD PROCESS TIMEOUT 60)
foreach(_asset IN LISTS _assets)
  if(NOT _asset STREQUAL "")
    if(NOT EXISTS "${_asset}")
      message(FATAL_ERROR "Hyle Apple runtime resource is missing: '${_asset}'")
    endif()
    file(COPY_FILE "${_asset}" "${_directory}/mlx.metallib" ONLY_IF_DIFFERENT)
  endif()
endforeach()
