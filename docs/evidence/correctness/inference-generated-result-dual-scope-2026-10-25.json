  "corrected_contract": {
    "successful": "Both scopes succeed on the one returned export ReadLease/Domain. Its retained owners/subviews hold both fees and its actual backing owner until they retire.",
    "failure": "The original GraphOutput/result and permissions remain intact. A first fee follows normal export-owner lifetime; no atomic counter rollback or persistence beyond that lifetime is promised.",
    "persistent": "Apple cached exports and the persistent host fixture can keep the first fee after second-scope rejection.",
    "transient": "Vulkan fresh export_storage/ReadLease::adopt domains can die on rejected second scope and normally return the first fee while the uncharged native slot remains readable.",
    "independent_uncharged": "Prior independent uncharged exports/native slot ownership are not retroactively charged by later admission.",
    "cap": "Completed-result retention admission, not preallocation reservation for Provider-private storage or a physical-device memory cap."
  },
