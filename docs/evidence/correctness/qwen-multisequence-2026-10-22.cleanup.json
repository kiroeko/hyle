  "script_text": "$ErrorActionPreference = 'Stop'\n$repoRoot = 'C:\\public\\project-hyle\\hyle'\n$stageRoot = [IO.Path]::GetFullPath((Join-Path $repoRoot '.scratch\\qwen-multisequence-20261021'))\n$stagePrefix = $stageRoot + '\\'\n$planPath = Join-Path $stageRoot 'cleanup-plan-final.json'\n$receiptPath = Join-Path $repoRoot 'docs\\evidence\\correctness\\qwen-multisequence-2026-10-22.cleanup.json'\nif (Test-Path -LiteralPath $receiptPath) { throw 'This cleanup has already completed.' }\n$plan = Get-Content -LiteralPath $planPath -Raw -Encoding utf8 | ConvertFrom-Json\nfunction Assert-Identity($row) {\n    $item = Get-Item -LiteralPath $row.path\n    if ($item.PSIsContainer -or $item.Length -ne $row.bytes) { throw \"Size/type mismatch: $($row.path)\" }\n    if ((Get-FileHash -LiteralPath $row.path -Algorithm SHA256).Hash.ToLowerInvariant() -ne $row.sha256) { throw \"Changed file: $($row.path)\" }\n}\nif ([IO.Path]::GetFullPath($plan.allowed_root) -ne $stageRoot -or $plan.target_count -ne 32) { throw 'Unexpected cleanup plan.' }\nAssert-Identity $plan.publication.manifest\nAssert-Identity $plan.publication.final_records\nforeach ($row in $plan.publication.archives) { Assert-Identity $row }\nAssert-Identity $plan.keep_latest_image\n$keptImage = [IO.Path]::GetFullPath($plan.keep_latest_image.path)\n$oldArchive = Join-Path $repoRoot 'docs\\evidence\\correctness\\qwen-multisequence-2026-10-22.zip'\nif ([IO.Path]::GetFullPath($plan.allowed_superseded_archive.path) -ne $oldArchive) { throw 'Unexpected old archive.' }\n$running = @(Get-CimInstance Win32_Process | Where-Object { $_.ExecutablePath -and $_.ExecutablePath.StartsWith($stagePrefix, [StringComparison]::OrdinalIgnoreCase) })\nif ($running.Count) { throw 'A native process from this stage is still running.' }\n$seen = [Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)\nforeach ($row in $plan.targets) {\n    $resolved = [IO.Path]::GetFullPath($row.path)\n    if (-not $seen.Add($resolved) -or $resolved -eq $keptImage) { throw \"Duplicate/protected target: $resolved\" }\n    $isOldArchive = $resolved -eq $oldArchive -and $row.kind -eq 'superseded-evidence-archive'\n    if ($isOldArchive) {\n        if ($row.sha256 -ne $plan.allowed_superseded_archive.sha256) { throw 'Wrong old archive identity.' }\n        $boundary = [IO.Path]::GetDirectoryName($oldArchive)\n    } else {\n        if (-not $resolved.StartsWith($stagePrefix, [StringComparison]::OrdinalIgnoreCase) -or [IO.Path]::GetExtension($resolved) -notin @('.exe','.map','.lib','.exp')) { throw \"Outside/type mismatch: $resolved\" }\n        $boundary = $stageRoot\n    }\n    $at = Get-Item -LiteralPath $resolved\n    while ($null -ne $at) {\n        if (($at.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw \"Reparse path: $resolved\" }\n        if ($at.FullName -eq $boundary) { break }\n        $at = if ($at.PSIsContainer) { $at.Parent } else { $at.Directory }\n    }\n    Assert-Identity $row\n}\nforeach ($row in $plan.targets) {\n    Remove-Item -LiteralPath $row.path -Force\n    if (Test-Path -LiteralPath $row.path) { throw \"Target remains: $($row.path)\" }\n}\n$receipt = [ordered]@{status='completed';time_utc=[DateTime]::UtcNow.ToString('o');deleted_files=$plan.target_count;deleted_bytes=$plan.total_bytes;targets=$plan.targets;publication=$plan.publication;kept=$plan.keep;recursive_delete=$false;plan_sha256=(Get-FileHash -LiteralPath $planPath -Algorithm SHA256).Hash.ToLowerInvariant();script_sha256=(Get-FileHash -LiteralPath $PSCommandPath -Algorithm SHA256).Hash.ToLowerInvariant();script_text=(Get-Content -LiteralPath $PSCommandPath -Raw -Encoding utf8)}\n$receipt | ConvertTo-Json -Depth 12 | Set-Content -LiteralPath $receiptPath -Encoding utf8\nWrite-Output \"Removed $($receipt.deleted_files) exact files, $($receipt.deleted_bytes) bytes; kept current Qwen image, all source/objects/raw data and both evidence volumes.\"\n"
}
