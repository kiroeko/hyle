{
  "status": "bounded_static_stored_scale_FP8_reference_and_ordinary_graph_correctness_verified",
  "scope": "Single-machine Windows CPU/CUDA/Vulkan and macOS Apple primitive math/lifetime regression; original stored E4M3FN weights and two independent F32 scalar scales.",
  "contract": {
    "inputs": [
      "F32/F16/BF16 A[M,K]",
      "E4M3FN W[N,K]",
      "F32 SA[] or[1]",
      "F32 SW[] or[1]"
    ],
    "arithmetic": "F32 A * F32(1/SA), SATFINITE nearest-even E4M3FN Cast, widen codes to F32; F32 code-dot with backend reduction tree; separate F32 MulSA then MulSW; descriptor F32/F16/BF16 output rounding.",
    "IEEE": "All scalar IEEE values remain legal; signed zero, NaN class, Inf and subnormal boundaries are exercised. No positivity/finite scale guard, scale precombination or weight-scale predecode.",
    "integration": "Existing12-node ordinary graph may contract under the shared closed reader/publication/control proof. Published codes/weight escapes retain the original ordinary graph. Original bytes remain canonical; no persistent NK decoded bank or new executor."
