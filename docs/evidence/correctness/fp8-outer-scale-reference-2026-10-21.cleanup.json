  "source_script": "# Exact FP8 outer-scale test-artifact cleanup. No recursive directory removal.\n$ErrorActionPreference = 'Stop'\n$plan = Get-Content -LiteralPath 'C:\\public\\project-hyle\\hyle\\.scratch\\architecture-refactor-2026-10-18\\quark-fp8-side-2026-10-21\\root\\cleanup-plan.json' -Raw | ConvertFrom-Json\n$separator = [IO.Path]::DirectorySeparatorChar\n$allowed = [IO.Path]::GetFullPath($plan.allowed_windows).TrimEnd($separator) + $separator\nfunction Assert-Identity($row) {\n  $file = Get-Item -LiteralPath $row.path -ErrorAction Stop\n  if ($file.PSIsContainer -or ($file.Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw \"Not a regular file: $($row.path)\" }\n  if ($file.Length -ne $row.bytes -or (Get-FileHash -LiteralPath $row.path -Algorithm SHA256).Hash.ToLowerInvariant() -ne $row.sha256) { throw \"Identity changed: $($row.path)\" }\n}\nAssert-Identity $plan.evidence\nAssert-Identity $plan.archive\nforeach ($row in $plan.remove_windows) {\n  $full = [IO.Path]::GetFullPath($row.path)\n  if (-not $full.StartsWith($allowed, [StringComparison]::OrdinalIgnoreCase) -or [IO.Path]::GetExtension($full) -notin '.exe','.map','.dll') { throw \"Outside exact artifact scope: $full\" }\n  Assert-Identity $row\n}\nforeach ($row in $plan.keep_windows) { Assert-Identity $row }\nforeach ($row in $plan.keep_runtime_cache) { Assert-Identity $row }\n$active = @(Get-CimInstance Win32_Process | Where-Object { $_.ExecutablePath -and $_.ExecutablePath.StartsWith($allowed, [StringComparison]::OrdinalIgnoreCase) })\nif ($active.Count) { throw 'A test executable in this exact workspace is still running' }\nforeach ($row in $plan.remove_windows) { Remove-Item -LiteralPath $row.path -Force }\nforeach ($row in $plan.keep_windows) { Assert-Identity $row }\nforeach ($row in $plan.keep_runtime_cache) { Assert-Identity $row }\n$macProgram = @'\nimport pathlib,hashlib,json,subprocess\nplan=json.loads('{\"allowed_mac\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/quark-fp8-side-2026-10-21/apple\", \"remove_mac\": [{\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/quark-fp8-side-2026-10-21/apple/fp8-outer-scale\", \"bytes\": 15469360, \"sha256\": \"bbf316db823d145511a0e0a74cd98d70b1728dc37a41c9aabd30936bca480a81\", \"symlink\": false}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/quark-fp8-side-2026-10-21/apple/fp8-outer-scale.map\", \"bytes\": 4545531, \"sha256\": \"5908b5b88f6bc962a14ba9ea1a228f26e9f1fc743d07bd8de22696fff41fbe58\", \"symlink\": false}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/quark-fp8-side-2026-10-21/apple/fp8-source-role\", \"bytes\": 15509008, \"sha256\": \"8ed081c691774746706dcf7053e39e0441890dee7ed99d84cec9e1a0dee99386\", \"symlink\": false}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/quark-fp8-side-2026-10-21/apple/fp8-source-role.map\", \"bytes\": 4554195, \"sha256\": \"11af56ebbe4ea69f390da69efefb3576bec3f9ade96d4f54a8700764a1f01d33\", \"symlink\": false}], \"keep_mac\": [{\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/quark-fp8-side-2026-10-21/apple/objects/src--compute_provider_native--native_provider.cc.o\", \"bytes\": 89376, \"sha256\": \"65d6bf36d63c15eec5aff94300fe5c157b72b2cbffe7c18b1939dab5765be914\", \"symlink\": false}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/quark-fp8-side-2026-10-21/apple/objects/src--compute_provider_native--static_fp8.cc.o\", \"bytes\": 90760, \"sha256\": \"c5750877f4c6def8c390257eba3752a30d8563062b0af5705bcbcc287eb0f03e\", \"symlink\": false}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/quark-fp8-side-2026-10-21/apple/objects/src--compute_route_apple--apple_mature_float.cc.o\", \"bytes\": 138232, \"sha256\": \"e194bfdad7a0f1674547f2d31d0635a6d29d94af2ed164b23b1e2918238b14b6\", \"symlink\": false}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/quark-fp8-side-2026-10-21/apple/objects/src--compute_route_apple--apple_operations.cc.o\", \"bytes\": 171632, \"sha256\": \"8dce276bf401988ef076b6dec787f2da3eb6d8d3bedd503438df5dbd961b37a1\", \"symlink\": false}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/quark-fp8-side-2026-10-21/apple/objects/src--compute_route_apple--apple_static_fp8.cc.o\", \"bytes\": 71416, \"sha256\": \"796dfc737710958d66c20ae113c9be060754cb7efe6258c73e1aa5e168fe972e\", \"symlink\": false}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/quark-fp8-side-2026-10-21/apple/objects/src--graph_route_apple--apple_lowering.cc.o\", \"bytes\": 305168, \"sha256\": \"f77e9e9df53e35aa39cedc077c51d68c78476838ddecfcbb1f09feb309e26f47\", \"symlink\": false}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/quark-fp8-side-2026-10-21/apple/objects/src--graph_route_apple--native_region.cc.o\", \"bytes\": 192872, \"sha256\": \"96d3dbe48894ffc9dce4a8e016284f17c9fd92a0f0c3ca8cea73dcf0deaa7878\", \"symlink\": false}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/quark-fp8-side-2026-10-21/apple/objects/tests--graph_route_apple--fp8_outer_scale_test.cc.o\", \"bytes\": 389032, \"sha256\": \"302c969c0b54724116efa4bd637f60f8574fa25b0449b8e05bc078001a570f1c\", \"symlink\": false}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/quark-fp8-side-2026-10-21/apple/revisions/generic-first-wrapper.o\", \"bytes\": 348120, \"sha256\": \"a5c1888aa2075b22e93ac0307c55c56231ec360fa9e1dd8f0948cfa328f8273d\", \"symlink\": false}]}')\nbase=pathlib.Path(plan['allowed_mac']); assert base.is_dir() and not base.is_symlink()\ndef verify(row):\n p=pathlib.Path(row['path']); assert p.is_absolute() and not p.is_symlink() and p.resolve().is_relative_to(base.resolve())\n assert p.is_file() and p.stat().st_size==row['bytes'] and hashlib.sha256(p.read_bytes()).hexdigest()==row['sha256'],str(p)\n return p\npaths=[verify(x) for x in plan['remove_mac']]\nfor row in plan['keep_mac']:verify(row)\nactive=subprocess.check_output(['ps','-axo','command='],text=True)\nassert not any(str(p) in command for p in paths for command in active.splitlines() if not command.startswith('python3 -')), 'test executable is running'\nfor p in paths:p.unlink()\nfor row in plan['keep_mac']:verify(row)\nprint(json.dumps(dict(removed=len(paths),bytes=sum(x['bytes'] for x in plan['remove_mac']),kept_objects=len(plan['keep_mac']))))\n'@\n$macResult = $macProgram | & ssh kiro@172.22.10.198 python3 -\nif ($LASTEXITCODE -ne 0) { throw 'Mac exact-file cleanup failed; do not report both platforms completed' }\n$result = [ordered]@{\n  completed = $true\n  windows_removed = @($plan.remove_windows).Count\n  windows_bytes = ($plan.remove_windows | Measure-Object -Property bytes -Sum).Sum\n  windows_kept_objects = @($plan.keep_windows).Count\n  mac = ($macResult | ConvertFrom-Json)\n  evidence_sha256 = $plan.evidence.sha256\n  archive_sha256 = $plan.archive.sha256\n  exact_plan = $plan\n  source_script = [IO.File]::ReadAllText($PSCommandPath)\n}\n$result | ConvertTo-Json -Depth 18 | Set-Content -LiteralPath 'C:\\public\\project-hyle\\hyle\\docs\\evidence\\correctness\\fp8-outer-scale-reference-2026-10-21.cleanup.json' -Encoding utf8\n[pscustomobject]$result | Select-Object completed,windows_removed,windows_bytes,windows_kept_objects,mac | ConvertTo-Json -Depth 5\n"
