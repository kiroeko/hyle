  "script_content": "$ErrorActionPreference = 'Stop'\r\n$repoRoot = [IO.Path]::GetFullPath($PSScriptRoot)\r\n$planPath = Join-Path $repoRoot '.scratch/architecture-refactor-2026-10-18/layout-binding-lifetime/cleanup/cleanup-plan.json'\r\n$plan = Get-Content -LiteralPath $planPath -Raw | ConvertFrom-Json\r\nif ($repoRoot -ne $plan.workspace) { throw 'Unexpected workspace' }\r\n$allowedRoot = [IO.Path]::GetFullPath((Join-Path $repoRoot '.scratch/architecture-refactor-2026-10-18')) + [IO.Path]::DirectorySeparatorChar\r\nfunction Assert-ExactFile($row, [bool]$requireScratch = $false) {\r\n    $resolved = (Resolve-Path -LiteralPath $row.path).ProviderPath\r\n    if (-not $resolved.StartsWith($repoRoot + [IO.Path]::DirectorySeparatorChar, [StringComparison]::OrdinalIgnoreCase)) { throw \"Outside workspace: $resolved\" }\r\n    if ($requireScratch -and -not $resolved.StartsWith($allowedRoot, [StringComparison]::OrdinalIgnoreCase)) { throw \"Outside workspace scratch: $resolved\" }\r\n    if ($resolved -ne [IO.Path]::GetFullPath($row.path)) { throw \"Changed resolved path: $resolved\" }\r\n    $item = Get-Item -LiteralPath $resolved\r\n    if ($item.PSIsContainer -or $item.Length -ne $row.bytes) { throw \"Changed file size: $resolved\" }\r\n    if ((Get-FileHash -LiteralPath $resolved -Algorithm SHA256).Hash -ne $row.sha256) { throw \"Changed file hash: $resolved\" }\r\n}\r\nforeach ($row in $plan.delete) { Assert-ExactFile $row $true }\r\nforeach ($row in $plan.protected) { Assert-ExactFile $row }\r\nforeach ($row in $plan.delete) { Remove-Item -LiteralPath $row.path -Force }\r\nforeach ($row in $plan.delete) { if (Test-Path -LiteralPath $row.path) { throw \"Deletion incomplete: $($row.path)\" } }\r\nforeach ($row in $plan.protected) { Assert-ExactFile $row }\r\n$receipt = [ordered]@{ status='executed'; files=$plan.target_count; reclaimed_bytes=$plan.target_bytes; protected_files=@($plan.protected).Count; exact_targets=$plan.delete; plan_sha256=(Get-FileHash -LiteralPath $planPath -Algorithm SHA256).Hash.ToLower(); finished_utc=[DateTime]::UtcNow.ToString('o') }\r\n$receipt | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath (Join-Path (Split-Path -Parent $planPath) 'cleanup-executed.json') -Encoding utf8\r\nWrite-Output \"CLEANUP_EXECUTED files=$($plan.target_count) bytes=$($plan.target_bytes)\"\r\n",
  "plan_sha256": "41380ecf13e13db0f915fc908d96ee328f472205a05f1c6f36af26ffb7779eda",
  "limitation": "Only exact superseded files listed here were removed. Native objects, SDKs, models, unique vectors and current/comparison images remain."
