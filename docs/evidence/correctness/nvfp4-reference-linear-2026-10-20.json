  "status": "implemented_and_focused_execution_passed",
  "scope": "New five-input ModelOpt group16 BF16 software-reference linear; not hardware-native FP4 GEMM, whole artifact, quality or throughput acceptance.",
  "public_contract": {
    "operation": "model_ops::Nvfp4Linear / nvfp4_linear()",
    "name": "nvfp4-reference-linear",
    "inputs": [
      "BF16[M,K] activation",
      "U8[N,K/2] adjacent low-first E2M1 codes",
      "E4M3FN[N,K/16] group scales",
      "F32 scalar weight global",
      "F32 scalar calibrated input global"
    ],
    "output": "BF16[M,N]",
    "geometry": "Positive M/N/K, complete16 groups, plain dense ports; globals scalar[] or [1].",
    "arithmetic": "Pinned ModelOpt Hopper runtime A16 QDQ with E4M3 scale and tiny guard -> BF16; nonfast W=BF16(q*F32(groupScale*weightGlobal)); F32 backend reduction, final BF16. Both producer weight zero codes are +0. A uses x>=0 sign comparison.",
    "domain": "Finite BF16 A, finite nonnegative E4M3 group scales including both zero signs, strictly positive finite F32 globals including subnormal. Finite input may produce IEEE NaN/Inf after chosen scaling/rounding.",
    "failure": "Completion failure; failed output unusable, no rollback guarantee. Failed Graph Invocation is terminal; recreate from same Executable, bind and prepare to recover."
  },
  "architecture": {
