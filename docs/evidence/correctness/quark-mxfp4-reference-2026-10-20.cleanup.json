  "cleanup_script": "$ErrorActionPreference = 'Stop'\r\n$workspaceRoot = 'C:\\public\\project-hyle\\hyle'\r\n$planPath = Join-Path $workspaceRoot '.scratch\\architecture-refactor-2026-10-18\\quark-mxfp4-reference\\root\\cleanup-plan.json'\r\n$receiptPath = Join-Path $workspaceRoot 'docs\\evidence\\correctness\\quark-mxfp4-reference-2026-10-20.cleanup.json'\r\nif (Test-Path -LiteralPath $receiptPath) { throw 'This exact cleanup already has a receipt; do not rerun.' }\r\n$plan = Get-Content -LiteralPath $planPath -Raw | ConvertFrom-Json\r\n$allowedRoot = (Resolve-Path -LiteralPath $plan.root).ProviderPath.TrimEnd('\\') + '\\'\r\n$expectedRoot = (Join-Path $workspaceRoot '.scratch\\architecture-refactor-2026-10-18\\quark-mxfp4-reference').TrimEnd('\\') + '\\'\r\nif ($allowedRoot -ine $expectedRoot) { throw 'Unexpected cleanup root.' }\r\nfunction Assert-Identity($entry) {\r\n    $item = Get-Item -LiteralPath $entry.path\r\n    if ($item.PSIsContainer -or ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'Expected an ordinary exact file.' }\r\n    if ($item.Length -ne $entry.bytes) { throw \"Size changed: $($entry.path)\" }\r\n    if ((Get-FileHash -LiteralPath $entry.path -Algorithm SHA256).Hash -ine $entry.sha256) { throw \"Hash changed: $($entry.path)\" }\r\n}\r\nAssert-Identity $plan.artifact\r\nforeach ($entry in $plan.protected) { Assert-Identity $entry }\r\nforeach ($entry in $plan.targets) {\r\n    $resolved = (Resolve-Path -LiteralPath $entry.path).ProviderPath\r\n    if (-not $resolved.StartsWith($allowedRoot, [StringComparison]::OrdinalIgnoreCase)) { throw 'Target escapes the exact batch directory.' }\r\n    if ([IO.Path]::GetExtension($resolved) -notin @('.exe','.map','.lib','.exp')) { throw 'Unexpected deletion extension.' }\r\n    Assert-Identity $entry\r\n}\r\nforeach ($entry in $plan.targets) { Remove-Item -LiteralPath $entry.path -Force }\r\nforeach ($entry in $plan.protected) { Assert-Identity $entry }\r\nforeach ($entry in $plan.targets) { if (Test-Path -LiteralPath $entry.path) { throw 'Deletion incomplete.' } }\r\n$receipt = [ordered]@{\r\n    status = 'complete'\r\n    removed_files = @($plan.targets).Count\r\n    removed_bytes = $plan.reclaim_bytes\r\n    targets = $plan.targets\r\n    protected = $plan.protected\r\n    archive = $plan.artifact\r\n    cleanup_script_sha256 = (Get-FileHash -LiteralPath $PSCommandPath -Algorithm SHA256).Hash.ToLowerInvariant()\r\n    cleanup_script = Get-Content -LiteralPath $PSCommandPath -Raw\r\n    scope = $plan.scope\r\n}\r\n$receipt | ConvertTo-Json -Depth 10 | Set-Content -LiteralPath $receiptPath -Encoding utf8\r\nWrite-Output \"Removed $(@($plan.targets).Count) exact rebuildable files, $($plan.reclaim_bytes) bytes; all protected objects and current Qwen consumer remain unchanged.\"\r\n",
  "scope": "Only this batch16 rebuildable Windows images/link sideproducts. Product sources, all objects, SDK caches and current Qwen consumer are protected. Mac26MB coherent cache retained for subsequent incremental work."
