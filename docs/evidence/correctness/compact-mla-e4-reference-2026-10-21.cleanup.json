  "source_script": "# Exact compact MLA E4 test-artifact cleanup. No recursive directory removal.\r\n$ErrorActionPreference = 'Stop'\r\n$plan = Get-Content -LiteralPath 'C:\\public\\project-hyle\\hyle\\.scratch\\architecture-refactor-2026-10-18\\compact-mla-e4-reference\\root\\cleanup-plan.json' -Raw | ConvertFrom-Json\r\n$separator = [IO.Path]::DirectorySeparatorChar\r\n$allowed = [IO.Path]::GetFullPath($plan.allowed_windows).TrimEnd($separator) + $separator\r\nfunction Assert-Identity($row) {\r\n  $file = Get-Item -LiteralPath $row.path -ErrorAction Stop\r\n  if ($file.PSIsContainer -or ($file.Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw \"Not a regular file: $($row.path)\" }\r\n  if ($file.Length -ne $row.bytes -or (Get-FileHash -LiteralPath $row.path -Algorithm SHA256).Hash.ToLowerInvariant() -ne $row.sha256) { throw \"Identity changed: $($row.path)\" }\r\n}\r\nAssert-Identity $plan.evidence\r\nAssert-Identity $plan.archive\r\nforeach ($row in $plan.remove_windows) {\r\n  $full = [IO.Path]::GetFullPath($row.path)\r\n  if (-not $full.StartsWith($allowed, [StringComparison]::OrdinalIgnoreCase) -or [IO.Path]::GetExtension($full) -notin '.exe','.map') { throw \"Outside exact artifact scope: $full\" }\r\n  Assert-Identity $row\r\n}\r\nforeach ($row in $plan.keep_windows) { Assert-Identity $row }\r\n$active = @(Get-CimInstance Win32_Process | Where-Object { $_.ExecutablePath -and $_.ExecutablePath.StartsWith($allowed, [StringComparison]::OrdinalIgnoreCase) })\r\nif ($active.Count) { throw 'A test executable in this exact workspace is still running' }\r\nforeach ($row in $plan.remove_windows) { Remove-Item -LiteralPath $row.path -Force }\r\nforeach ($row in $plan.keep_windows) { Assert-Identity $row }\r\n$macProgram = @'\r\nimport pathlib,hashlib,json,subprocess\r\nplan=json.loads('{\"allowed_mac\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/compact-mla-e4-reference/apple\", \"remove_mac\": [{\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/compact-mla-e4-reference/apple/compact-mla-e4\", \"bytes\": 16233488, \"sha256\": \"bf07a67c1aeac28e83dc3b8fa4f8fee2f080c8f4cc9445f27c660b04417b6430\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/compact-mla-e4-reference/apple/compact-mla-e4.map\", \"bytes\": 4828441, \"sha256\": \"5d1f00c3f750d10901d2cbfd285d639c6e481f188538534e201f91b6c7412f21\"}], \"keep_mac\": [{\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/compact-mla-e4-reference/apple/objects/native--mlx--backend--metal--jit_kernels.cpp.o\", \"bytes\": 571936, \"sha256\": \"14131167045278e4b41c129e6ddb96e6146c2d31524b3196bb59ca364e2dab93\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/compact-mla-e4-reference/apple/objects/native--mlx--backend--metal--scaled_dot_product_attention.cpp.o\", \"bytes\": 127216, \"sha256\": \"202752825ba45954c7aecdc0a1581ba530531b725e1600754ef0c21b1b1872d1\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/compact-mla-e4-reference/apple/objects/native--mlx--fast.cpp.o\", \"bytes\": 260456, \"sha256\": \"9d468c29adf3696feb48840c176c517175da056ed0e87d2516827bc590a661ff\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/compact-mla-e4-reference/apple/objects/native-jit--steel_attention.cpp.o\", \"bytes\": 78824, \"sha256\": \"c8ca7885516f5ad6db9ea4ab643ff262bd6f0d114675c8854f7f436277e251d3\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/compact-mla-e4-reference/apple/objects/src--compute_batch--batch_layout.cc.o\", \"bytes\": 43544, \"sha256\": \"c5343cb3dd2b5fe28ca6b5d00450d8f0a573cd8f50abf70ae9cf157110701490\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/compact-mla-e4-reference/apple/objects/src--compute_route_apple--apple_batch.cc.o\", \"bytes\": 170552, \"sha256\": \"8f0d0c5a74203590e08c1e3f88443d785c9d998ab277a624c5509c1514d113f3\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/compact-mla-e4-reference/apple/objects/src--graph_batch--batch.cc.o\", \"bytes\": 228400, \"sha256\": \"82f9582957d672950780b5345b7bd6ee1c7dd4c7751b67d8d110b6a2fc7ef91e\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/compact-mla-e4-reference/apple/objects/src--graph_batch--native_batch_regions.cc.o\", \"bytes\": 29216, \"sha256\": \"2a237c189d628c2f0af9e000783ebbb8cd1e1797190c9ce5505b7b065a543b49\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/compact-mla-e4-reference/apple/objects/src--graph_batch--native_paged_node.cc.o\", \"bytes\": 12344, \"sha256\": \"ebe9199b23949e981d8d8207e4d7d4585288da4e82971ac610c2185b54aa24fd\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/compact-mla-e4-reference/apple/objects/src--graph_route_apple--native_paged_region.cc.o\", \"bytes\": 125856, \"sha256\": \"044111308a9339c2e8d84858c09e762c027ec31d4a3e2c6e7366efdceada5fac\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/compact-mla-e4-reference/apple/objects/src--graph_route_apple--native_ragged_region.cc.o\", \"bytes\": 86776, \"sha256\": \"d4e84761c321d841cadee5773a85f3578b3e428d4343e3616f89e7120a635d48\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/compact-mla-e4-reference/apple/objects/tests--graph_batch--native_ragged_attention_test.cc.o\", \"bytes\": 214632, \"sha256\": \"3df6e4a69ad2df9ec8d53ad57790d1ec6d575dd5ea5572f756779d4c88fbb156\"}, {\"path\": \"/Users/kiro/hyle-scratch/compute-unified/architecture-refactor-20261019-apple-page-invocation/compact-mla-e4-reference/apple/objects/tests--graph_route_apple--compact_mla_e4_test.cc.o\", \"bytes\": 225848, \"sha256\": \"20c8c1ddeb6f88c0002114d82f4bf8c129e585ff751b4dcd8d4920f03f541622\"}]}')\r\nbase=pathlib.Path(plan['allowed_mac']); assert base.is_dir() and not base.is_symlink()\r\ndef verify(row):\r\n p=pathlib.Path(row['path']); assert p.is_absolute() and not p.is_symlink() and p.resolve().is_relative_to(base.resolve())\r\n assert p.is_file() and p.stat().st_size==row['bytes'] and hashlib.sha256(p.read_bytes()).hexdigest()==row['sha256'],str(p)\r\n return p\r\npaths=[verify(x) for x in plan['remove_mac']]\r\nfor row in plan['keep_mac']:verify(row)\r\nactive=subprocess.check_output(['ps','-axo','command='],text=True)\r\nassert not any(str(p) in command for p in paths for command in active.splitlines() if not command.startswith('python3 -')), 'test executable is running'\r\nfor p in paths:p.unlink()\r\nfor row in plan['keep_mac']:verify(row)\r\nprint(json.dumps(dict(removed=len(paths),bytes=sum(x['bytes'] for x in plan['remove_mac']),kept_objects=len(plan['keep_mac']))))\r\n'@\r\n$macResult = $macProgram | & ssh kiro@172.22.10.198 python3 -\r\nif ($LASTEXITCODE -ne 0) { throw 'Mac exact-file cleanup failed; do not report both platforms completed' }\r\n$result = [ordered]@{\r\n  completed = $true\r\n  windows_removed = @($plan.remove_windows).Count\r\n  windows_bytes = ($plan.remove_windows | Measure-Object -Property bytes -Sum).Sum\r\n  windows_kept_objects = @($plan.keep_windows).Count\r\n  mac = ($macResult | ConvertFrom-Json)\r\n  evidence_sha256 = $plan.evidence.sha256\r\n  archive_sha256 = $plan.archive.sha256\r\n  exact_plan = $plan\r\n  source_script = (Get-Content -LiteralPath $PSCommandPath -Raw)\r\n}\r\n$result | ConvertTo-Json -Depth 18 | Set-Content -LiteralPath 'C:\\public\\project-hyle\\hyle\\docs\\evidence\\correctness\\compact-mla-e4-reference-2026-10-21.cleanup.json' -Encoding utf8\r\n[pscustomobject]$result | Select-Object completed,windows_removed,windows_bytes,windows_kept_objects,mac | ConvertTo-Json -Depth 5\r\n"
