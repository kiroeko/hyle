    "episode": "write and close 8-byte next generation in sibling model.next, atomically rename to model.bin, receive matching native change and re-read exact authoritative generation before next episode",
    "resources": "one persistent route at a time, one native user owner thread plus main thread; /proc/self/status Threads=2 for every successful row; this does not count possible kernel workers",
    "preparation": "create fixture/runtime/watcher and bounded readiness warmup plus equal 100ms route quiescence outside timing; cold destruction outside timing",
    "charged_work": "4096 serialized authoritative publications per row, five rows per route, process median; both routes call the identical Platform FS publish/read helper",
    "same_process_control": "routes are created, measured and destroyed sequentially in one process, matching the original fixture lifetime; orders hyle-libuv and libuv-hyle",
    "timer": "std::chrono::steady_clock, one start/end per complete 4096-episode row; no claim that nanobench amortized harness time is clock resolution",
    "affinity": "taskset -c 2 in WSL; guest affinity only, not proof of physical core class",
    "filesystem": "TMPDIR=/root/hyle/.scratch/perf-watch/tmp (Linux native work directory, not /mnt/c)",
