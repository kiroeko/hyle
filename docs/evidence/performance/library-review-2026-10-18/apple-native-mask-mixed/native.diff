+// Called only for the frontend's raw F16/BF16 additive mask on F32 full SDPA.
+// Compact actual zero-stride axes before conversion, then restore their views.
+array compact_full_mask_cast(
+    const array& raw, const array& q, const array& k, const Stream& s) {
+  const Shape shape{q.shape(0), q.shape(1), q.shape(2), k.shape(2)};
+  Strides source_strides(4, 0);
+  const int diff = 4 - raw.ndim();
+  for (int i = 0; i < raw.ndim(); ++i)
+    if (raw.shape(i) != 1)
+      source_strides[i + diff] = raw.strides(i);
+
+  auto compact_shape = shape;
+  for (int i = 0; i < 4; ++i)
+    if (source_strides[i] == 0 && compact_shape[i] != 0)
+      compact_shape[i] = 1;
+  const bool contiguous = raw.flags().contiguous;
+  array converted(contiguous ? raw.shape() : compact_shape, q.dtype(), nullptr, {});
+  auto strides = source_strides;
+  if (contiguous) {
+    // Match AsType's Vector allocation and physical order, including a
+    // transpose or broadcast whose backing is contiguous but not row-dense.
+    converted.set_data(allocator::malloc(raw.data_size() * converted.itemsize()),
+        raw.data_size(), raw.strides(), raw.flags());
+  } else {
+    converted.set_data(allocator::malloc(converted.nbytes()));
+    strides = converted.strides();
+    for (int i = 0; i < 4; ++i)
+      if (source_strides[i] == 0)
+        strides[i] = 0;
+  }
+  // Retain before enqueue: a later kernel/dispatch failure must not retire an
+  // accepted conversion prefix's backing before its native completion.
+  metal::get_command_encoder(s).add_temporary(converted);
+  if (contiguous)
+    copy_gpu_inplace(raw, converted, CopyType::Vector, s);
+  else
+    copy_gpu_inplace(raw, converted, compact_shape, source_strides,
+        converted.strides(), 0, 0, CopyType::GeneralGeneral, s);
+  array mask(shape, q.dtype(), nullptr, {});
+  auto flags = converted.flags();
+  if (mask.size() > converted.size())
+    flags.row_contiguous = flags.col_contiguous = false;
+  mask.copy_shared_buffer(converted, strides, flags, converted.data_size());
+  return mask;
+}
 
