  "findings": [
    {
      "id": "Q38_OUTPUT_GATE",
      "verdict": "RESOLVED_DISTINCT_BRANCHES",
      "models": [
        "qwen38_27b",
        "qwen38_2p4t_a95b"
      ],
      "conclusion": "output_gate_type is consumed by GatedDeltaNet RMSNormGated, with swish = z*sigmoid(z); regular full-attention output gating remains sigmoid. The earlier comparison against Qwen3_5Attention inspected a different branch, and does not establish a missing swish implementation.",
      "anchors": [
        "srt/models/qwen3_5.py:355,462-473",
        "kernels/ops/attention/fla/layernorm_gated.py:138-141,190-193"
      ],
      "requirements": [
        "F03_OUTPUT_GATE_SIGMOID",
        "F04_RMS_SWISH_GATE"
      ],
      "oracle": "separate full-attention sigmoid and post-RMS swish formulas; Qwen3.5 reference qualifies only the shared formula and local checkpoint, not full Qwen3.8 execution"
    },
    {
      "id": "K3_ACTIVATION_QUANTIZATION",
      "verdict": "RESOLVED_RUNTIME_PROFILE_DEPENDENT",
      "models": [
        "kimi_k3"
      ],
      "conclusion": "Checkpoint input_activations=null does not remove runtime activation quantization. The declared W4A8 path uses MXFP4 E2M1/UE8M0 group32 weights and E4M3/UE8M0 group32 dynamic activations. SGLang explicitly distinguishes this SM100 default route from BF16-activation routes (Marlin/cutlass/precision=bf16); compare only identical named profiles.",
      "anchors": [
        "srt/models/kimi_k3.py:1129-1170",
        "srt/layers/quantization/mxfp4.py:78-119",
        "kernels/jit/csrc/gemm/per_token_group_quant.cuh:296-330"
      ],
      "activation_contract": "finite values; amax=max(group_absmax,1e-10); raw scale=amax/448; round scale upward to representable power-of-two UE8M0; E4M3 nearest-even SATFINITE; input dtype intermediate multiply preserved as declared; apply at expert gate/up and down GEMM inputs",
      "requirements": [
        "F18_MXFP4_W4A8",
        "F18_MXFP8_ACTIVATION"
      ],
      "oracle": "independent scalar format decoder/encoder plus same codes/scales W4A8 composition; a dequantized BF16 engine is not a W4A8 performance peer",
      "hardware": "No SM100/107 validation exists on RTX4070 SM89; four-route emulation must preserve the same quantized values and charge costs."
    },
    {
      "id": "MTP_BRANCH_BINDING",
      "verdict": "RESOLVED_MODEL_SPECIFIC_COMPOSITION",
      "branches": [
        {
          "models": [
            "qwen35_2b_local",
            "qwen38_27b",
            "qwen38_2p4t_a95b"
          ],
          "count": 1,
          "weights": "mtp.fc; pre_fc_norm_embedding; pre_fc_norm_hidden; layers.0; norm; base tied embeddings/head unless config explicitly supplies dedicated ones",
          "formula": "target post-final-norm hidden + next-token embedding; each Gemma RMS (1+weight); concatenate [embedding,hidden]; fc; one full-attention decoder; MTP norm; tied head",
          "evidence": "SGLang qwen3_5_mtp.py plus llama.cpp qwen35.cpp lines205-209,540-550,624-638; local input contains all15 MTP tensors",
          "acceptance": "C4 actual local MTP tensor fragment; request scheduling and acceptance policy remain test consumer"
        },
        {
          "models": [
            "deepseek_v4_pro",
            "deepseek_v4_flash"
          ],
          "count": 1,
          "weights": "mtp layer e_proj,h_proj,enorm,hnorm,norm,hc_head_fn/base/scale and inherited block; shared embedding/head",
          "formula": "enorm(embedding)->e_proj broadcast over HC + h_proj(hnorm(HC hidden)); one nextn block; HC head and norm",
          "evidence": "pinned official inference/model.py MTPBlock and SGLang deepseek_v4_nextn.py",
          "acceptance": "C4 HC/MTP composition with real widths; inherited sparse attention dependencies completed C5"
        },
        {
          "models": [
            "glm53",
            "glm53_flash"
          ],
          "count": 1,
          "weights": "model.layers.<num_hidden_layers> NextN-specific enorm,hnorm,eh_proj,shared_head.norm and decoder tensors; Flash may use model.language_model prefix",
          "formula": "concat normalized next embedding and previous hidden; eh_proj; decoder with MTP index carry; shared head norm/head. Respect checkpoint quantization ignore entries (Flash BF16 NextN).",
          "evidence": "SGLang glm4_moe.py GlmMoeDsaForCausalLMNextN; glm5_next_nextn.py; deepseek_nextn.py forward; config model mapping",
          "acceptance": "C4 math and index owner/lifetime with C5 final DSA composition, no speculative sampling in SDK"
        },
        {
          "models": [
            "kimi_k3"
          ],
          "count": 0,
          "weights": "none required by frozen config",
          "formula": "no MTP head requirement; ordinary KDA chunk/ragged mechanisms remain MUST",
          "evidence": "pinned config num_nextn_predict_layers=0"
        }
      ],
      "oracle": "Each branch has an independent formula fixture; ordinary base-model logits do not sign MTP."
    }
  ]
