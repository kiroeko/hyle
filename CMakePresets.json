{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "hyle-dev",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HYLE_BUILD_TESTS": "ON",
        "HYLE_BUILD_BENCH": "OFF"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows VS 2022 CPU development",
      "description": "Visual Studio 2022 solution fallback. Use scripts/hyle-windows.ps1 so side-by-side v143 toolsets resolve to the highest installed MSVC 19.43+ version.",
      "inherits": "hyle-dev",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build-windows",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-vs2026",
      "displayName": "Windows VS 2026 CPU development",
      "description": "Native Visual Studio 2026 solution using v145. Requires CMake 4.2+ and VS 2026 with the C++ workload.",
      "inherits": "hyle-dev",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build-windows-vs2026",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-ninja",
      "displayName": "Windows selected MSVC + Ninja",
      "description": "Ninja build using the MSVC environment selected by scripts/hyle-windows.ps1 (or an already initialized developer shell).",
      "inherits": "hyle-dev",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-windows-ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-clangcl",
      "displayName": "Windows clang-cl + Ninja",
      "description": "Clang frontend with the Windows/MSVC ABI and SDK. The wrapper imports the Visual Studio environment; clang-cl must be installed and discoverable on PATH.",
      "inherits": "windows-ninja",
      "binaryDir": "${sourceDir}/build-windows-clangcl",
      "environment": {
        "CC": "clang-cl",
        "CXX": "clang-cl"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux CPU development",
      "description": "Generator- and compiler-name-independent Release build. Select any supported GCC 14+ or Clang 18+ through CC/CXX or normal CMake arguments.",
      "inherits": "hyle-dev",
      "binaryDir": "${sourceDir}/build-linux",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "macos",
      "displayName": "macOS CPU development",
      "description": "Generator-independent Release build using the selected AppleClang/Clang toolchain; Ninja is optional.",
      "inherits": "hyle-dev",
      "binaryDir": "${sourceDir}/build-macos",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "win",
      "displayName": "Windows Ninja development (compatibility alias)",
      "inherits": "windows-ninja"
    },
    {
      "name": "wsl",
      "displayName": "Linux/WSL GCC 14 development",
      "description": "Convenience preset for machines that expose gcc-14/g++-14 by those names. Use the generic linux preset with CC/CXX for other supported toolchains.",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build-wsl",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-14",
        "CMAKE_CXX_COMPILER": "g++-14"
      }
    },
    {
      "name": "wsl-tsan",
      "displayName": "Linux/WSL GCC 14 + ThreadSanitizer",
      "description": "Separate TSan build for lock-free/concurrency changes. Run executables under setarch -R when the host TSan runtime requires ASLR disabled.",
      "inherits": "wsl",
      "binaryDir": "${sourceDir}/build-wsl-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HYLE_SANITIZER": "tsan"
      }
    },
    {
      "name": "package-feature-shared",
      "displayName": "Portable feature SDK (shared)",
      "description": "Deterministic all-component SDK input: tests/bench, trace, sanitizer, TLS, and exact-ISA specialization are explicitly OFF; HTTP/2 is explicitly ON.",
      "binaryDir": "${sourceDir}/build-package-feature-shared",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HYLE_COMPONENTS": "all",
        "HYLE_BUILD_TESTS": "OFF",
        "HYLE_BUILD_BENCH": "OFF",
        "HYLE_INSTALL": "ON",
        "HYLE_STATIC": "OFF",
        "HYLE_SANITIZER": "off",
        "HYLE_TRACE": "OFF",
        "HYLE_SIMD_EXACT_TARGET": "",
        "HYLE_IO_TLS": "OFF",
        "HYLE_IO_HTTP2": "ON"
      }
    },
    {
      "name": "package-feature-static",
      "displayName": "Portable feature SDK (static, CUDA-free)",
      "inherits": "package-feature-shared",
      "binaryDir": "${sourceDir}/build-package-feature-static",
      "cacheVariables": {
        "HYLE_STATIC": "ON"
      }
    },
    {
      "name": "bench",
      "displayName": "Benchmarks (pinned SIMD vendors)",
      "description": "Generator-independent isolated benchmark build. Fetch the pinned Highway/xsimd opponents first; enable CUDA/TLS explicitly only for a benchmark that needs them.",
      "inherits": "hyle-dev",
      "binaryDir": "${sourceDir}/build-bench",
      "cacheVariables": {
        "HYLE_BUILD_TESTS": "OFF",
        "HYLE_BUILD_BENCH": "ON"
      }
    },
    {
      "name": "bench-all-sota",
      "displayName": "Benchmarks + all shared SOTA rivals",
      "description": "Development-only comparison build. Enables all ten shared HYLE_BENCH_* rival gates; IO-only backend gates remain explicit because they are platform/dependency specific.",
      "inherits": "bench",
      "cacheVariables": {
        "HYLE_BENCH_ABSL": "ON",
        "HYLE_BENCH_TBB": "ON",
        "HYLE_BENCH_MARL": "ON",
        "HYLE_BENCH_HIGHWAY": "ON",
        "HYLE_BENCH_XSIMD": "ON",
        "HYLE_BENCH_SIMDUTF": "ON",
        "HYLE_BENCH_MOODYCAMEL": "ON",
        "HYLE_BENCH_RIGTORP": "ON",
        "HYLE_BENCH_BOOST": "ON",
        "HYLE_BENCH_WYHASH": "ON"
      }
    },
    {
      "name": "linux-aarch64-cross",
      "displayName": "Linux AArch64 cross build",
      "description": "All-component CPU AArch64 cross smoke with warnings as errors. The toolchain discovers aarch64-linux-gnu GCC; override HYLE_CROSS_* cache variables for a nonstandard prefix/version. This verifies compilation and linkage, not target execution or module acceptance.",
      "binaryDir": "${sourceDir}/build-linux-aarch64-cross",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-aarch64-gcc.cmake",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HYLE_COMPONENTS": "all",
        "HYLE_BUILD_TESTS": "OFF",
        "HYLE_BUILD_BENCH": "OFF",
        "HYLE_WERROR": "ON",
        "HYLE_IO_TLS": "OFF",
        "HYLE_IO_HTTP2": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows", "configurePreset": "windows", "configuration": "Release" },
    { "name": "windows-vs2026", "configurePreset": "windows-vs2026", "configuration": "Release" },
    { "name": "windows-ninja", "configurePreset": "windows-ninja", "configuration": "Release" },
    { "name": "windows-clangcl", "configurePreset": "windows-clangcl", "configuration": "Release" },
    { "name": "linux", "configurePreset": "linux", "configuration": "Release" },
    { "name": "macos", "configurePreset": "macos", "configuration": "Release" },
    { "name": "win", "configurePreset": "win", "configuration": "Release" },
    { "name": "wsl", "configurePreset": "wsl", "configuration": "Release" },
    { "name": "wsl-tsan", "configurePreset": "wsl-tsan", "configuration": "RelWithDebInfo" },
    { "name": "package-feature-shared", "configurePreset": "package-feature-shared", "configuration": "Release" },
    { "name": "package-feature-static", "configurePreset": "package-feature-static", "configuration": "Release" },
    { "name": "bench", "configurePreset": "bench", "configuration": "Release" },
    { "name": "bench-all-sota", "configurePreset": "bench-all-sota", "configuration": "Release" },
    { "name": "linux-aarch64-cross", "configurePreset": "linux-aarch64-cross", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "windows", "configurePreset": "windows", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "windows-vs2026", "configurePreset": "windows-vs2026", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "windows-ninja", "configurePreset": "windows-ninja", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "windows-clangcl", "configurePreset": "windows-clangcl", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "linux", "configurePreset": "linux", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "macos", "configurePreset": "macos", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "win", "configurePreset": "win", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "wsl", "configurePreset": "wsl", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "wsl-tsan", "configurePreset": "wsl-tsan", "configuration": "RelWithDebInfo", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } }
  ],
  "workflowPresets": [
    { "name": "windows-check", "steps": [ { "type": "configure", "name": "windows" }, { "type": "build", "name": "windows" }, { "type": "test", "name": "windows" } ] },
    { "name": "windows-vs2026-check", "steps": [ { "type": "configure", "name": "windows-vs2026" }, { "type": "build", "name": "windows-vs2026" }, { "type": "test", "name": "windows-vs2026" } ] },
    { "name": "windows-ninja-check", "steps": [ { "type": "configure", "name": "windows-ninja" }, { "type": "build", "name": "windows-ninja" }, { "type": "test", "name": "windows-ninja" } ] },
    { "name": "windows-clangcl-check", "steps": [ { "type": "configure", "name": "windows-clangcl" }, { "type": "build", "name": "windows-clangcl" }, { "type": "test", "name": "windows-clangcl" } ] },
    { "name": "linux-check", "steps": [ { "type": "configure", "name": "linux" }, { "type": "build", "name": "linux" }, { "type": "test", "name": "linux" } ] },
    { "name": "macos-check", "steps": [ { "type": "configure", "name": "macos" }, { "type": "build", "name": "macos" }, { "type": "test", "name": "macos" } ] }
  ]
}
