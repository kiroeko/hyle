  "source_excerpts": {
    "header_static_arrays": [
      {
        "line": 120,
        "text": "  // Prepare threadgroup memory"
      },
      {
        "line": 121,
        "text": "  constexpr short padQ = 16 / sizeof(QueryT);"
      },
      {
        "line": 122,
        "text": "  constexpr short padK = 16 / sizeof(T);"
      },
      {
        "line": 123,
        "text": "  constexpr short padV = 16 / sizeof(T);"
      },
      {
        "line": 124,
        "text": ""
      },
      {
        "line": 125,
        "text": "  constexpr short LDQ_tgp = BD + padQ;"
      },
      {
        "line": 126,
        "text": "  constexpr short LDK_tgp = BK + padK;"
      },
      {
        "line": 127,
        "text": "  constexpr short LDV_tgp = BV + padV;"
      },
      {
        "line": 128,
        "text": ""
      },
      {
        "line": 129,
        "text": "  constexpr short tgp_mem_0 = (BK + padK) * (BD);"
      },
      {
        "line": 130,
        "text": "  constexpr short tgp_mem_1 = BK * (BV + padV);"
      },
      {
        "line": 131,
        "text": "  constexpr short tgp_mem_s = tgp_mem_0 > tgp_mem_1 ? tgp_mem_0 : tgp_mem_1;"
      },
      {
        "line": 132,
        "text": ""
      },
      {
        "line": 133,
        "text": "  threadgroup QueryT Q_smem[BQ * (BD + padQ)];"
      },
      {
        "line": 134,
        "text": "  threadgroup T KV_smem[tgp_mem_s];"
      },
      {
        "line": 135,
        "text": ""
      },
      {
        "line": 136,
        "text": "  threadgroup QueryT* Qs = Q_smem;"
      },
      {
        "line": 137,
        "text": "  threadgroup T* Ks = KV_smem;"
      },
      {
        "line": 138,
        "text": "  threadgroup T* Vs = KV_smem;"
      }
    ],
    "jit_template_arguments": [
      {
        "line": 1308,
        "text": "MTL::ComputePipelineState* get_steel_attention_kernel("
      },
      {
        "line": 1309,
        "text": "    metal::Device& d,"
      },
      {
        "line": 1310,
        "text": "    const std::string& kernel_name,"
      },
      {
        "line": 1311,
        "text": "    const std::string& hash_name,"
      },
      {
        "line": 1312,
        "text": "    const metal::MTLFCList& func_consts,"
      },
      {
        "line": 1313,
        "text": "    const array& q,"
      },
      {
        "line": 1314,
        "text": "    int bq,"
      },
      {
        "line": 1315,
        "text": "    int bk,"
      },
      {
        "line": 1316,
        "text": "    int bd,"
      },
      {
        "line": 1317,
        "text": "    int wm,"
      },
      {
        "line": 1318,
        "text": "    int wn,"
      },
      {
        "line": 1319,
        "text": "    const array& m, int bv, bool half_query) {"
      },
      {
        "line": 1320,
        "text": "  const auto& lib_name = kernel_name;"
      },
      {
        "line": 1321,
        "text": "  auto lib = d.get_library(lib_name, [&]() {"
      },
      {
        "line": 1322,
