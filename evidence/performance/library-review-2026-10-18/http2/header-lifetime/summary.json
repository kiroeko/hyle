      "peer then Hyle"
    ],
    "processes": 4,
    "epochs_per_arm": 9,
    "arms_per_process": 2,
    "all_72_epochs_retained": true,
    "full_smoke": "One complete original oracle episode per variant before formal; each returned Hyle=4, peer=4.",
    "extra_AA_shapes_probes_or_formal_retries": false,
    "terminal_capture": false
  },
  "change": {
    "actual_entries": "StoredHeader is construct_at only after both field appends succeed; HttpHeader views are construct_at only for the published count.",
    "lifetime": "Both types are statically required to be trivially destructible. Capacity storage is independently deallocated without destructing unconstructed entries. Repeated same-type non-const replacement is intentional.",
    "unchanged": "Both capacity allocations, their order, overflow/OOM checks, limits, bytes, alignment, field append and transport/protocol work remain unchanged. This saves initialization work, not allocated capacity.",
    "removed_work": "Four max_header_count value-construction loops per stream; at default 128 this is 512 capacity objects per stream. Trivial destructor loops already compile away in the baseline, so no destructor speedup is claimed."
  },
  "static_review": {
    "informational": "Informational headers reset count and byte storage without materializing views; overwritten same-type entries are transparently replaced, unused suffix is never read.",
    "repeated_views": "Each new HttpHeader value is computed from StoredHeader/ByteBuffer before construct_at; no old HttpHeader value is read. Only [0,count) is exposed as a contiguous span.",
    "partial_initialization": "No capacity object is assumed live. Each non-null allocation is deallocated separately even when the other allocation fails; count increments only after both field appends succeed.",
    "address": "The views allocation starts at a byte offset, not typed pointer arithmetic across unused StoredHeader capacity. Existing alignment and size-overflow preflight are retained.",
    "limits": "No new targeted informational/OOM case or allocation probe; these lifetime boundaries are supported by source analysis. Existing multi-header/trailer/stable-view regressions ran.",
    "independent_review": "configuration_consistency_scan reviewed lifetime/count reuse; backend_assembly_design independently recomputed all four medians and Hyle/peer ratios."
  },
  "static_object_observation": {
    "compiler": "GCC 14.2.0, same -O3 closure flags recorded in commands",
    "create_stream_code_bytes_before": 4767,
    "create_stream_code_bytes_after": 1559,
    "interpretation": "The old object contains capacity zero-store loops absent in the candidate. Code-size reduction is not a measured time attribution."
  },
