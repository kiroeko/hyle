{
  "result": "Keep the minimal removal of capacity-sized initialization work. These four processes do not establish a throughput improvement; the current candidate remains slower than its same-process manual peer.",
  "head_at_packaging": "8f501cceff0b04deaf9671831880b338a14fce9f",
  "scope": {
    "product_file": "src/io_http2/http2.cc",
    "trace": "Only original 4 streams x256KiB request/response holdout",
    "outer_order": [
      "old",
