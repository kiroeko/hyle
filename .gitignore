# build artifacts
/build/
/build-*/
/out/
/cmake-build-*/
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
build-*.log

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# fetched deps / vendored
/_deps/
/vendor/*/

# compute-05: ggml is a FetchContent dependency PINNED BY COMMIT (CMakeLists.txt).
# third_party/ggml is a LOCAL SOURCE MIRROR (git archive of the pin) kept out-of-repo so
# build/ and build-wsl/ share ONE copy without re-downloading -- unlike fcontext/
# picohttpparser (tiny copied vendors that ARE tracked). Delete it -> CMake fetches the
# pinned commit from upstream. (FetchContent's subbuild lives in the default per-build-dir
# ${build}/_deps -- NOT a shared in-source .deps, which broke Win/WSL cross-OS; see the
# compute-05 milestone doc. The stray /.deps/ guard below catches an accidental one.)
/third_party/ggml/
/.deps/

# local build helper (machine-specific hardcoded paths)
_build.bat

# IDE / editors
.vscode/
.idea/
*.user
.cache/

# OS
.DS_Store
Thumbs.db
