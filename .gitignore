# build artifacts
/build/
/build-*/
/out/
/cmake-build-*/
/.scratch/
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
__pycache__/
*.py[cod]
build-*.log

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# fetched deps / vendored
/_deps/
/vendor/*/

# Obsolete in-repository dependency cache spelling. Product source resources use
# HYLE_DEP_SOURCE_CACHE outside the checkout; keep accidental legacy recreation
# ignored so it cannot enter a source package.
/.deps/

# Source-only payload assembled beside hyle-offline-deps.cmake. It belongs to
# an offline delivery bundle, not HYLE's tracked complete-source archive.
/deps/

# local build helper (machine-specific hardcoded paths)
_build.bat

# IDE / editors
.vscode/
.idea/
*.user
.cache/

# OS
.DS_Store
Thumbs.db
