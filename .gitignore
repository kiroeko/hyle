# build artifacts
/build/
/build-*/
/out/
/cmake-build-*/
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
__pycache__/
*.py[cod]
build-*.log

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# fetched deps / vendored
/_deps/
/vendor/*/

# Legacy/local dependency directory. The supported default is each build tree's
# `_deps`; offline source trees are injected with FETCHCONTENT_SOURCE_DIR_<NAME>.
# Keep old developer caches ignored, but never make this path a build contract.
/.deps/

# local build helper (machine-specific hardcoded paths)
_build.bat

# IDE / editors
.vscode/
.idea/
*.user
.cache/

# OS
.DS_Store
Thumbs.db
