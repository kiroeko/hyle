# build artifacts
/build/
/build-*/
/out/
/cmake-build-*/
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
build-*.log

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# fetched deps / vendored
/_deps/
/vendor/*/

# compute-05 / tests: ggml + googletest are FetchContent deps (CMakeLists.txt / tests/
# CMakeLists.txt), pinned by commit/tag. FETCHCONTENT_BASE_DIR points here so a first
# `cmake` auto-fetches them into .deps/<dep>-src ONCE, reused across `rm -rf build` and
# regenerations. .deps is per-machine (Win C:\..., WSL /root/hyle, mac ~/hyle). Nothing
# pre-placed in third_party for these -- pure open-box auto-download (cil2cpp form).
/.deps/

# local build helper (machine-specific hardcoded paths)
_build.bat

# IDE / editors
.vscode/
.idea/
*.user
.cache/

# OS
.DS_Store
Thumbs.db
