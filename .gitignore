# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# fetched deps / vendored
/_deps/
/vendor/*/

# compute-05: ggml is a FetchContent dependency PINNED BY COMMIT (CMakeLists.txt).
# third_party/ggml is a LOCAL SOURCE MIRROR (git archive of the pin) kept out-of-repo --
# unlike fcontext/picohttpparser (tiny copied vendors that ARE tracked). Delete it ->
# CMake fetches the pinned commit from upstream. .deps/ is the persistent FetchContent
# cache (FETCHCONTENT_BASE_DIR): populated ONCE per machine, reused across `rm -rf build`
# and regenerations. Both are per-machine (Win C:\..., WSL /root/hyle, mac ~/hyle -- never
# shared across OSes), so no cross-tree path conflict.
/third_party/ggml/
/.deps/
# googletest local mirror (git-archive of the pinned tag), same rule as ggml: per-machine,
# .gitignored, SOURCE_DIR zero-download. Absent -> FetchContent fetches the tag once.
/third_party/googletest/

# local build helper (machine-specific hardcoded paths)
_build.bat

# IDE / editors
.vscode/
.idea/
*.user
.cache/

# OS
.DS_Store
Thumbs.db
