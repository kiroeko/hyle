      "executables": [
        {
          "id": "error-source-consumer-primary",
          "target": "hyle_error_source_consumer_bench",
          "stem": "hyle_error_source_consumer_bench",
          "target_variant": "primary",
          "measurement_batch": 1,
          "telemetry_prefixes": ["# HYLE_ERROR_SOURCE_CONSUMER_RUN "],
          "workloads": [
            {"id": "taskgraph-source-success-64", "title": "Source TaskGraph 64-node success propagation"},
