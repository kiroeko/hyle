          "stem": "hyle_error_source_consumer_bench_placement",
          "target_variant": "placement",
          "measurement_batch": 1,
          "telemetry_prefixes": ["# HYLE_ERROR_SOURCE_CONSUMER_RUN "],
          "workloads": [
            {"id": "taskgraph-source-success-64", "title": "Source TaskGraph 64-node success propagation"},
            {"id": "taskgraph-source-owning-last-failure-64", "title": "Source TaskGraph 64-node owning last failure"},
            {"id": "parallel-source-first-error-handoff", "title": "Source parallel first-error owning handoff"},
            {"id": "join-source-failed-owning-handoff", "title": "Source JoinState failed owning handoff"}
          ]
