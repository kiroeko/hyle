{
  "schema": "hyle.perf.contract/v1",
  "id": "error-source-consumer-v1",
  "module": "error",
  "claim": "Engineering non-inferiority of HYLE Status/Result against Abseil in current source-consumer ownership traces, with identical algorithms, value categories, charged lifetimes, execution-order strata, and code-placement perturbation",
  "candidate": {
    "target": "hyle_error",
    "delivery_shape": "source",
    "revision": "runtime-bound",
    "component": "error",
    "entrypoint": "hyle/error/status.h and hyle/error/result.h"
  },
  "peers": [
    {
      "id": "abseil",
      "revision": "81c993af4fb88b3a51829a796df02251fa27102f",
      "configuration": {
        "status_source_location": "disabled with an empty absl::SourceLocation",
        "delivery_shape": "source",
        "source": "clean external checkout"
      }
    }
  ],
  "strata": [
    {
      "id": "primary-candidate-first",
      "dimensions": {"placement": "primary", "execution_order": "candidate-first"},
      "target_variant": "primary"
    },
    {
      "id": "primary-peer-first",
      "dimensions": {"placement": "primary", "execution_order": "peer-first"},
      "environment": {"HYLE_BENCH_RIVAL_FIRST": "1"},
      "target_variant": "primary"
    },
    {
      "id": "placement-candidate-first",
      "dimensions": {"placement": "perturbed", "execution_order": "candidate-first"},
      "target_variant": "placement"
    },
    {
      "id": "placement-peer-first",
      "dimensions": {"placement": "perturbed", "execution_order": "peer-first"},
      "environment": {"HYLE_BENCH_RIVAL_FIRST": "1"},
      "target_variant": "placement"
    }
  ],
  "controls": [
    {"id": "aa", "kind": "aa", "parameters": {"maximum_bias_percent": 5}},
    {"id": "delta5", "kind": "known-delta", "parameters": {"nominal_percent": 5}},
    {"id": "delta10", "kind": "known-delta", "parameters": {"nominal_percent": 10}},
    {"id": "timer-floor", "kind": "timer-floor", "parameters": {"minimum_workload_floor_multiple": 20}},
    {"id": "placement", "kind": "placement", "parameters": {}},
    {"id": "error-source-codegen", "kind": "codegen", "parameters": {"validator_id": "error-source-consumer-contract"}}
  ],
  "workloads": [
    {
      "id": "taskgraph-source-success-64",
      "tier": "replay",
      "gate_role": "product",
      "consumer_key": "graph/taskgraph/evaluate-success",
      "provenance": {
        "path": "src/graph/taskgraph.cc",
        "sha256": "9adb3f42e9cf9fd11c4edf961f2d121fe06341f6b6417b79ee4c8ecb9a2078f5"
      },
      "ownership_topology": {
        "candidate": "Each indirect node returns a fresh local HYLE Status; the evaluator observes it by reference and the success local dies before the next node",
        "peer": "Each identical indirect node returns a fresh local absl::Status; the evaluator observes it by reference and the success local dies before the next node",
        "equivalence": "One shared template owns node storage access, 64 indirect calls, local lifetime, status check, trace writes, and final return; only the carrier trait differs"
      },
      "material_contribution": {
        "frequency": 64,
        "value": 1,
        "unit": "status-check",
        "budget": 5,
        "denominator": "one 64-node TaskGraph evaluate request",
        "derivation": "Literal TaskGraph::evaluate loop topology at the frozen provenance hash; no future inference frequency is claimed"
      },
      "semantic_contract": "Replay one TaskGraph::evaluate source request with 64 active indirect nodes, fresh local success carriers, and observable call/checksum effects",
      "comparability": "COMPARABLE",
      "peer_id": "abseil",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {"distribution": "64 active nodes, all successful", "scale": {"requests_per_callback": 1, "nodes_per_request": 64}},
      "setup": "Candidate and peer arrays use the same GraphNode/GraphNodeContext templates and are initialized outside the callback",
      "charged_phases": ["64 indirect calls", "64 fresh success carriers", "64 status checks", "observable trace updates", "final success return and destruction"],
      "pair": {"candidate": "HYLE Status source TaskGraph success", "peer": "absl::Status source TaskGraph success"},
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": ["primary-candidate-first", "primary-peer-first", "placement-candidate-first", "placement-peer-first"],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement", "error-source-codegen"]
    },
    {
      "id": "taskgraph-source-owning-last-failure-64",
      "tier": "replay",
      "gate_role": "product",
      "consumer_key": "graph/taskgraph/evaluate-owning-failure",
      "provenance": {
        "path": "src/graph/taskgraph.cc",
        "sha256": "9adb3f42e9cf9fd11c4edf961f2d121fe06341f6b6417b79ee4c8ecb9a2078f5"
      },
      "ownership_topology": {
        "candidate": "The last indirect node constructs one owning HYLE error inside the charged phase; TaskGraph's dead local is returned by move and destroyed by the caller",
        "peer": "The last identical indirect node constructs one owning Abseil error with source location disabled; the dead local is returned by move and destroyed by the caller",
        "equivalence": "One shared template fixes all 64 calls, message bytes, allocation phase, local value category, early return, trace effects, and destruction"
      },
      "material_contribution": {
        "frequency": 1,
        "value": 1,
        "unit": "owning-error-propagation",
        "budget": 5,
        "denominator": "one failed 64-node TaskGraph evaluate request",
        "derivation": "Literal failed-local move topology from TaskGraph::evaluate; the failure is placed last to retain the source loop cost, not to predict production failure rate"
      },
      "semantic_contract": "Replay a TaskGraph::evaluate source request whose final active node constructs and propagates one owning 29-byte NotFound error",
      "comparability": "COMPARABLE",
      "peer_id": "abseil",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {"distribution": "63 fresh successes followed by one fresh owning failure", "scale": {"requests_per_callback": 1, "nodes_per_request": 64, "failure_index": 63, "message_bytes": 29}},
      "setup": "Only node/context arrays exist outside the callback; the owning error and its backing are created and destroyed inside the charged phase",
      "charged_phases": ["64 indirect calls", "63 success checks", "owning error allocation and construction", "failure check and move propagation", "all carrier destruction"],
      "pair": {"candidate": "HYLE Status source TaskGraph owning failure", "peer": "absl::Status source TaskGraph owning failure"},
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": ["primary-candidate-first", "primary-peer-first", "placement-candidate-first", "placement-peer-first"],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement", "error-source-codegen"]
    },
    {
      "id": "parallel-source-first-error-handoff",
      "tier": "replay",
      "gate_role": "product",
      "consumer_key": "graph/parallel-eval/first-error-handoff",
      "provenance": {
        "path": "src/graph/parallel_eval.cc",
        "sha256": "5a4888eab4a46f670f81f8a112587cc5c2f5b0872592b5b132f1a2e8ee0f7fb4"
      },
      "ownership_topology": {
        "candidate": "A worker creates an owning HYLE error, copy-assigns the outcome slot, copies through record(Status), moves to first_error, and the waiter copy-assigns the result before shared storage dies",
        "peer": "The identical shared algorithm performs the same assignments and value categories with an owning Abseil error and source location disabled",
        "equivalence": "Factory input, message, copy/move topology, noinline record boundary, observable outcome, return, and every destructor are shared"
      },
      "material_contribution": {
        "frequency": 1,
        "value": 1,
        "unit": "failed-node-handoff",
        "budget": 5,
        "denominator": "one parallel node failure recorded and lifted to its waiter",
        "derivation": "Literal outcome/record/first_err/result ownership sequence at the frozen parallel_eval.cc hash"
      },
      "semantic_contract": "Replay one current parallel evaluator owning-error handoff from fresh worker error through outcome, first-error storage, and waiter result",
      "comparability": "COMPARABLE",
      "peer_id": "abseil",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {"distribution": "one fresh owning NotFound error", "scale": {"handoffs_per_callback": 1, "message_bytes": 29}},
      "setup": "No prebuilt carrier or backing exists outside the callback",
      "charged_phases": ["owning error allocation and construction", "outcome copy assignment", "record parameter copy", "first-error move assignment", "waiter result copy assignment", "all destruction"],
      "pair": {"candidate": "HYLE Status source parallel owning handoff", "peer": "absl::Status source parallel owning handoff"},
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": ["primary-candidate-first", "primary-peer-first", "placement-candidate-first", "placement-peer-first"],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement", "error-source-codegen"]
    },
    {
      "id": "join-source-failed-owning-handoff",
      "tier": "replay",
      "gate_role": "product",
      "consumer_key": "sched/join/failed-owning-handoff",
      "provenance": {
        "path": "include/hyle/sched/join.h",
        "sha256": "29d1ac248c8ee3fbf9e9e8ba8f7cd3c22f8b900c7182508f12f471b88065eb3e"
      },
      "ownership_topology": {
        "candidate": "A noinline producer creates an owning HYLE error and moves it into a locked JoinState-shaped slot; a noinline consumer copies it under the lock and moves it into HYLE Result<int>",
        "peer": "The same producer, slot, lock, consumer, and value categories carry an owning Abseil error into absl::StatusOr<int>",
        "equivalence": "Only Status/Result traits differ; task-boundary noinline calls, uncontended locks, done branch, construction, copy/move sequence, query, and destruction are identical"
      },
      "material_contribution": {
        "frequency": 1,
        "value": 1,
        "unit": "failed-join-handoff",
        "budget": 5,
        "denominator": "one completed failed JoinState producer/consumer handoff",
        "derivation": "Literal JoinState::set_error/complete_/take and Result construction topology at the frozen join.h hash"
      },
      "semantic_contract": "Replay one completed failed JoinState handoff including fresh owning error, producer slot, uncontended synchronization, consumer copy, and result carrier",
      "comparability": "COMPARABLE",
      "peer_id": "abseil",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {"distribution": "one completed failed join with a fresh owning NotFound error", "scale": {"handoffs_per_callback": 1, "message_bytes": 29}},
      "setup": "The empty JoinState-shaped slot is callback-local; no error carrier or backing is prebuilt",
      "charged_phases": ["slot construction", "owning error allocation", "producer moves and lock", "consumer lock and status copy", "move into Result or StatusOr", "result query and all destruction"],
      "pair": {"candidate": "HYLE Result source JoinState owning failure", "peer": "absl::StatusOr source JoinState owning failure"},
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": ["primary-candidate-first", "primary-peer-first", "placement-candidate-first", "placement-peer-first"],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement", "error-source-codegen"]
    }
  ],
  "experiment": {
    "sample_schedule": [15, 31],
    "order_policy": "fixed-dual",
    "holdout": false
  },
  "build": {
    "configuration": "Release",
    "fresh": true,
    "linkage": "static",
    "lto": "off",
    "isa": "portable",
    "toolchain": "machine-profile-bound"
  },
  "artifacts": {
