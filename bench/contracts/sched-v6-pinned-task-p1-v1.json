        "frequency": 4096,
        "value": 4,
        "unit": "worker-owned-completion-resume",
        "budget": 5,
        "denominator": "one persistent four-worker backend or IO-owner lifetime",
        "derivation": "Inference IO/completion rings and renderer upload queues normally retain long-lived worker-owned loops; pinning and typed terminal status are both required while task construction is amortized"
      },
      "semantic_contract": "Run one suspending typed task on each of four stable worker owners across 4096 foreign completion wakes, acknowledge every episode without migration or loss, publish an exact terminal result and join every task",
      "comparability": "COMPARABLE",
      "peer_id": "hyle-v5-manual-pinned-task",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {
        "distribution": "sequential foreign completion episodes with an explicit readiness and completion handshake per worker",
        "scale": {"workers": 4, "warmup_episodes": 256, "measured_episodes": 4096, "completion_resumes": 16384}
      },
      "setup": "Scheduler creation, exact worker placement, coroutine/result-owner construction, pinned admission and 256 complete warmup episodes are outside measurement",
      "charged_phases": [
        "fresh Waker publication and readiness handshake",
        "foreign wake, pinned reinjection/unpark and owner resume",
        "completion acknowledgement and exact checksum update",
        "typed terminal result publication and one join per worker"
      ],
      "pair": {
        "candidate": "HYLE spawn_task_on plus JoinHandle",
        "peer": "HYLE v5 public manual Task plus spawn_detached_on plus typed slot and per-task WaitGroup"
      },
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": [
