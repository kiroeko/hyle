{
  "schema": "hyle.perf.contract/v1",
  "id": "platform-host-p1-v2",
  "module": "platform",
  "claim": "P1 engineering non-inferiority for one inference-planning snapshot of process-visible CPU topology plus documented Windows physical/commit availability against an equivalent direct Win32 ABI adapter",
  "candidate": {"target": "hyle_platform", "delivery_shape": "source", "revision": "runtime-bound", "component": "platform", "entrypoint": "include/hyle/platform/cpu.h"},
  "peers": [
    {
      "id": "onetbb",
      "revision": "e00c68dcac0e83947c9b54f6d5304c0616c9639f",
      "configuration": {
        "delivery_shape": "source-pinned mechanism adapter",
        "algorithm": "direct Windows CPU-set, processor-relation and memory-status queries; oneTBB pins the production topology lineage while the documented OS ABI is the comparison authority",
        "source": "clean external checkout plus the machine-profile-bound Windows SDK"
      }
    }
  ],
  "strata": [
    {"id": "primary-candidate-first", "dimensions": {"placement": "primary", "execution_order": "candidate-first"}, "target_variant": "primary"},
    {"id": "primary-peer-first", "dimensions": {"placement": "primary", "execution_order": "peer-first"}, "environment": {"HYLE_BENCH_RIVAL_FIRST": "1"}, "target_variant": "primary"},
    {"id": "placement-candidate-first", "dimensions": {"placement": "perturbed", "execution_order": "candidate-first"}, "target_variant": "placement"},
    {"id": "placement-peer-first", "dimensions": {"placement": "perturbed", "execution_order": "peer-first"}, "environment": {"HYLE_BENCH_RIVAL_FIRST": "1"}, "target_variant": "placement"}
  ],
  "controls": [
    {"id": "aa", "kind": "aa", "parameters": {"maximum_bias_percent": 5}},
    {"id": "delta5", "kind": "known-delta", "parameters": {"nominal_percent": 5}},
    {"id": "delta10", "kind": "known-delta", "parameters": {"nominal_percent": 10}},
    {"id": "timer-floor", "kind": "timer-floor", "parameters": {"minimum_workload_floor_multiple": 20}},
    {"id": "placement", "kind": "placement", "parameters": {}}
  ],
  "workloads": [
    {
      "id": "inference-host-planning-snapshot",
      "tier": "replay",
      "gate_role": "product",
      "consumer_key": "inference/host/planning-snapshot",
      "provenance": {"path": "docs/implementation/tasks/platform/platform-v3-capability-factorization.md", "sha256": "664ad1c653d02a19bde33bc3055a263dc8f7b6241c84f7b8e0c7789956a9ffcb"},
      "ownership_topology": {
        "candidate": "Two fallible one-shot HYLE queries return process-visible topology and documented Windows physical/commit availability in owned value records",
        "peer": "One direct Win32 adapter performs the same discovery and returns the same value fields",
        "equivalence": "Both routes allocate and release native scratch inside each charged snapshot, observe the same process placement, query the same processor relations and system memory facts, and validate equal topology before timing"
      },
      "material_contribution": {"frequency": 1, "value": 1, "unit": "host-planning-snapshot", "budget": 5, "denominator": "one model or runtime planning episode", "derivation": "Inference startup and explicit re-planning need one current CPU-placement and host-memory snapshot; cached scalar feature reads and unobservable nested-Job budgets are different contracts"},
      "semantic_contract": "Discover current process-visible logical, physical, package, NUMA and L2/L3 domains plus documented Windows physical/commit availability, including native scratch setup and teardown",
      "comparability": "COMPARABLE",
      "peer_id": "onetbb",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {"distribution": "the current process CPU-set/affinity, processor topology and Windows physical/commit availability", "scale": {"snapshots_per_callback": 1}},
      "setup": "Only correctness warm-up is outside timing; neither route retains reusable topology scratch between callbacks",
      "charged_phases": ["native sizing queries", "scratch allocation", "CPU-set and processor-relation discovery", "host physical/commit-memory discovery", "aggregation", "scratch teardown"],
      "pair": {"candidate": "HYLE topology + memory snapshot", "peer": "Win32 equivalent snapshot"},
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": ["primary-candidate-first", "primary-peer-first", "placement-candidate-first", "placement-peer-first"],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement"]
    }
  ],
  "experiment": {"sample_schedule": [15, 31], "order_policy": "fixed-dual", "holdout": false},
  "build": {"configuration": "Release", "fresh": true, "linkage": "static", "lto": "off", "isa": "portable", "toolchain": "machine-profile-bound"},
  "artifacts": {"validators": ["artifact-identity", "build-contract"]},
  "hosts": {"allowed_platforms": ["windows"], "certification_platforms": ["windows"], "requirements": {"machine_profiles": ["W1-WIN"], "qualified_role": "engineering", "formal_independent_hardware": true}},
  "extensions": {
    "runner": {
      "schema": "hyle.perf.nanobench-runner/v1",
      "sampling_topology": "single-logical-cpu",
      "cmake": {
        "cache": {"BUILD_SHARED_LIBS": "ON", "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF", "HYLE_BENCH_TBB": "ON", "HYLE_BUILD_BENCH": "ON", "HYLE_BUILD_TESTS": "OFF", "HYLE_DEV_FACTORS": "platform", "HYLE_INSTALL": "OFF", "HYLE_SANITIZER": "off", "HYLE_SIMD_EXACT_TARGET": "", "HYLE_STATIC": "ON", "HYLE_TEST_INSTRUMENTATION": "OFF", "HYLE_TRACE": "OFF"},
        "peer_cache": {"onetbb": "HYLE_TBB_DIR"}
      },
      "profiles": {"W1-WIN": {"generator": "Visual Studio 18 2026", "architecture": "x64", "compiler_id": "MSVC", "compiler_version_prefix": "19.50", "cache": {}}},
      "executables": [
        {"id": "platform-host-primary", "target": "hyle_platform_host_bench", "stem": "hyle_platform_host_bench", "target_variant": "primary", "measurement_batch": 1, "telemetry_prefixes": ["# HYLE_PLATFORM_HOST_RUN "], "workloads": [{"id": "inference-host-planning-snapshot", "title": "one-shot host planning snapshot"}]},
        {"id": "platform-host-placement", "target": "hyle_platform_host_bench_placement", "stem": "hyle_platform_host_bench_placement", "target_variant": "placement", "measurement_batch": 1, "telemetry_prefixes": ["# HYLE_PLATFORM_HOST_RUN "], "workloads": [{"id": "inference-host-planning-snapshot", "title": "one-shot host planning snapshot"}]}
      ],
      "control_executable": {"target": "hyle_perf_control_bench", "stem": "hyle_perf_control_bench"},
      "controlled_environment": ["HYLE_BENCH_RIVAL_FIRST", "HYLE_BENCH_APPLE_QOS", "HYLE_PERF_APPLE_QOS"],
      "validators": [{"id": "artifact-identity", "kind": "artifact-identity"}, {"id": "build-contract", "kind": "build-contract"}]
    }
  }
}
