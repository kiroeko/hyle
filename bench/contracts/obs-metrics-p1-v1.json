  "workloads": [
    {
      "id": "owner-scheduler-metrics-iteration",
      "tier": "replay",
      "gate_role": "product",
      "consumer_key": "inference/observability/owner-scheduler-iteration",
      "provenance": {
        "path": "bench/obs/metrics_consumer_shapes_v1.json",
        "sha256": "65cd057cd2da1f03f84b36b6fa31b06243ce73447ae9c8211b97b038c4616596"
      },
      "ownership_topology": {
        "candidate": "one scheduler owner retains HYLE Counter/Gauge/FixedHistogram state and validated runtime bounds across iterations",
        "peer": "one scheduler owner retains direct scalar/array state and the same runtime bounds across iterations",
        "equivalence": "both routes validate the same floating inputs, perform the same scalar increments and gauge stores, binary-search the same six runtime bounds, update one exclusive bucket and weighted sum, and expose persistent state to the caller"
      },
      "material_contribution": {
        "frequency": 1,
        "value": 64,
        "unit": "scheduler-iteration-with-request-observations",
        "budget": 5,
        "denominator": "one metrics-enabled inference scheduler iteration",
        "derivation": "vLLM and SGLang update their metric families once per scheduler iteration and per completed or scheduled request; 64 records form a bounded serving batch rather than an isolated scalar instruction"
      },
      "semantic_contract": "Update two integral counters, one floating counter, two gauges and one fixed histogram for a deterministic 64-request scheduler iteration using runtime-validated bounds and token-count observation multiplicity",
      "comparability": "COMPARABLE",
      "peer_id": "folly",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {"distribution": "eight positive latency values spanning six runtime buckets, request token multiplicity 1..8, queue depth 12..18 and cache usage 0.45..0.75", "scale": {"scheduler_iterations_per_callback": 1, "request_records": 64, "finite_bounds": 6}},
      "setup": "both persistent states and the same validated runtime boundary values are constructed outside measurement; names, labels, exporter and scrape are absent on both sides",
      "charged_phases": ["three counter updates per request", "floating validity checks", "two gauge stores per iteration", "one logarithmic runtime-bound lookup per request", "one bucket update", "one weighted sum update", "observable persistent state"],
      "pair": {"candidate": "HYLE owner-thread metrics iteration", "peer": "Direct owner-thread metrics iteration"},
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": ["primary-candidate-first", "primary-peer-first", "placement-candidate-first", "placement-peer-first"],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement", "obs-metrics-contract"]
    },
    {
      "id": "shared-scheduler-metrics-iteration",
      "tier": "replay",
      "gate_role": "product",
      "consumer_key": "inference/observability/shared-scheduler-iteration",
      "provenance": {
        "path": "bench/obs/metrics_consumer_shapes_v1.json",
        "sha256": "65cd057cd2da1f03f84b36b6fa31b06243ce73447ae9c8211b97b038c4616596"
      },
      "ownership_topology": {
        "candidate": "workers deliberately share one HYLE Concurrent metric state whose numeric reads and updates use lock-free relaxed atomics",
        "peer": "workers deliberately share one direct state with the same always-lock-free relaxed std::atomic fields and runtime bounds",
        "equivalence": "both routes provide immediate atomic values but no application synchronization, issue the same RMW/store sequence, validate the same input, search the same bounds and permit weak running snapshots with exact quiescent state"
      },
      "material_contribution": {
        "frequency": 1,
        "value": 64,
        "unit": "shared-scheduler-iteration-with-request-observations",
        "budget": 5,
        "denominator": "one deliberately shared metrics-enabled inference scheduler iteration",
        "derivation": "a host may choose immediate shared producer state instead of per-worker merge; the iteration aggregate keeps atomic cost visible without comparing it to the semantically lighter owner-thread route"
      },
      "semantic_contract": "Perform the same 64-request scheduler metrics iteration using always-lock-free relaxed atomic counters, gauges, exclusive buckets and floating sums with persistent shared-state semantics",
      "comparability": "COMPARABLE",
      "peer_id": "folly",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {"distribution": "identical to owner-scheduler-metrics-iteration", "scale": {"scheduler_iterations_per_callback": 1, "request_records": 64, "finite_bounds": 6, "writers_in_measurement": 1}},
      "setup": "both shared states and runtime bounds are constructed outside measurement; a single pinned writer isolates wrapper overhead while correctness separately validates concurrent writers",
      "charged_phases": ["three relaxed counter RMWs per request", "floating validity checks", "two relaxed gauge stores per iteration", "one logarithmic runtime-bound lookup per request", "one relaxed bucket RMW", "one relaxed floating-sum RMW", "observable persistent state"],
      "pair": {"candidate": "HYLE concurrent metrics iteration", "peer": "Direct relaxed-atomic metrics iteration"},
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": ["primary-candidate-first", "primary-peer-first", "placement-candidate-first", "placement-peer-first"],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement", "obs-metrics-contract"]
    }
