    {"id": "delta10", "kind": "known-delta", "parameters": {"nominal_percent": 10}},
    {"id": "timer-floor", "kind": "timer-floor", "parameters": {"minimum_workload_floor_multiple": 20}},
    {"id": "placement", "kind": "placement", "parameters": {}}
