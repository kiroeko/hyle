{
  "schema": "hyle.perf.contract/v1",
  "id": "io-watch-p1-v1",
  "module": "io_watch",
  "claim": "P1 engineering same-contract non-inferiority of the persistent HYLE FileWatcher owner-to-consumer route against source-pinned libuv for exact-file atomic replacement and bounded non-recursive directory bursts",
  "candidate": {
    "target": "hyle_io_watch",
    "delivery_shape": "source",
    "revision": "runtime-bound",
    "component": "io_watch",
    "entrypoint": "include/hyle/io/watch.h"
  },
  "peers": [
    {
      "id": "libuv",
      "revision": "3e606bc30a842701f8d12007d3ade662d258b76b",
      "configuration": {
        "delivery_shape": "clean source-pinned static libuv",
        "route": "one persistent uv_loop worker and uv_fs_event over the same parent or directory root",
        "progress": "one event owner plus one external publishing/waiting caller, with no polling or per-event thread",
        "adapter": "benchmark-owned target classification and authoritative eight-byte generation read identical to the HYLE consumer"
      }
    }
  ],
  "strata": [
    {
      "id": "primary-candidate-first",
      "dimensions": {"placement": "primary", "execution_order": "candidate-first"},
