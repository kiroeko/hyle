    },
    {
      "id": "placement-candidate-first",
      "dimensions": {"placement": "perturbed", "execution_order": "candidate-first"},
      "target_variant": "placement"
    },
    {
      "id": "placement-peer-first",
      "dimensions": {"placement": "perturbed", "execution_order": "peer-first"},
      "environment": {"HYLE_BENCH_RIVAL_FIRST": "1"},
      "target_variant": "placement"
    }
  ],
  "controls": [
