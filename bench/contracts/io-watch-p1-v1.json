  "workloads": [
    {
      "id": "exact-file-atomic-replace",
      "tier": "consumer",
      "gate_role": "product",
      "consumer_key": "inference/io/exact-sidecar-atomic-reload",
      "provenance": {
        "path": "bench/io_watch/consumer_shapes_v1.json",
        "sha256": "cc72781a58ce6191276661e1c5d3b7f80f1be138f07af3855bcf1ccc98c8fce2"
      },
      "ownership_topology": {
        "candidate": "one persistent HYLE Scheduler/IoContext owner retains FileWatcher; an external caller atomically publishes and waits for the coroutine consumer",
        "peer": "one persistent libuv loop owner retains uv_fs_event; the same external caller atomically publishes and waits for the callback consumer",
        "equivalence": "both observe the existing parent, retain runtime/watcher outside timing, publish the same sibling replacement, classify the exact basename and re-read the same authoritative generation before acknowledging"
      },
      "material_contribution": {
        "frequency": 8,
        "value": 1,
        "unit": "authoritative-exact-file-publication",
        "budget": 5,
        "denominator": "one eight-publication TLS/config/model-sidecar replay",
        "derivation": "inference servers commonly publish certificate, config and model-sidecar files by rename; the persistent watcher cost is paid at every reload"
      },
      "semantic_contract": "With one persistent watcher and event owner, publish and classify eight sequential atomic replacements of one exact file, re-read every new authoritative generation, reject stale duplicate notifications and retire the watcher cleanly",
      "comparability": "COMPARABLE",
      "peer_id": "libuv",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {
        "distribution": "eight monotonically numbered eight-byte sibling replacements on one local filesystem",
        "scale": {"targets": 1, "publications_per_callback": 8, "bytes_per_generation": 8, "event_owners": 1}
      },
      "setup": "Create the local root and initial file, establish each persistent runtime/watcher and complete one route-ordered warmup publication outside timing",
      "charged_phases": [
        "write and close one sibling replacement",
        "atomic replacement of the watched destination",
        "native event delivery through the route's persistent owner",
        "exact-target classification and authoritative generation read",
        "external completion acknowledgement"
      ],
      "pair": {
        "candidate": "HYLE FileWatcher",
        "peer": "libuv uv_fs_event"
      },
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": [
        "primary-candidate-first",
        "primary-peer-first",
        "placement-candidate-first",
        "placement-peer-first"
      ],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement"]
    },
    {
      "id": "nonrecursive-directory-burst",
      "tier": "consumer",
      "gate_role": "product",
      "consumer_key": "rendering/io/flat-asset-directory-invalidation",
      "provenance": {
        "path": "bench/io_watch/consumer_shapes_v1.json",
        "sha256": "cc72781a58ce6191276661e1c5d3b7f80f1be138f07af3855bcf1ccc98c8fce2"
      },
      "ownership_topology": {
        "candidate": "the same persistent HYLE owner receives bounded borrowed batches and coalesces repeated direct-child notifications",
        "peer": "the same persistent libuv owner receives uv_fs_event callbacks and accumulates the direct-child set in benchmark-owned state",
        "equivalence": "both retain runtime/watcher outside timing, publish two bursts over the same eight stable direct children, reject nested names, classify all direct children and re-read each authoritative generation before acknowledging"
      },
      "material_contribution": {
        "frequency": 2,
        "value": 8,
        "unit": "authoritative-direct-child-publication",
        "budget": 5,
        "denominator": "one two-burst flat shader/model-shard invalidation replay",
        "derivation": "asset and model caches routinely publish several sibling files together; batching and bounded coalescing are material at this burst shape"
      },
      "semantic_contract": "With one persistent non-recursive directory watcher and event owner, publish two bursts across eight direct children, classify and re-read all sixteen authoritative generations without accepting nested paths or silently losing a burst, then retire cleanly",
      "comparability": "COMPARABLE",
      "peer_id": "libuv",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {
        "distribution": "two sequential rewrites of eight stable direct children on one local filesystem",
        "scale": {"directories": 1, "bursts": 2, "children_per_burst": 8, "publications": 16, "bytes_per_generation": 8, "event_owners": 1}
      },
      "setup": "Create the local root and eight initial children, establish each persistent runtime/watcher and complete one route-ordered eight-child warmup burst outside timing",
      "charged_phases": [
        "write and close all direct-child generations",
        "native event delivery through the route's persistent owner",
        "bounded batch or callback accumulation",
        "direct-child classification and authoritative generation reads",
        "external completion acknowledgement"
      ],
      "pair": {
        "candidate": "HYLE FileWatcher",
        "peer": "libuv uv_fs_event"
      },
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": [
        "primary-candidate-first",
        "primary-peer-first",
        "placement-candidate-first",
        "placement-peer-first"
      ],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement"]
    }
  ],
