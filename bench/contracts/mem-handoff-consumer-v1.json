  "workloads": [
    {
      "id": "fixed-slot-cross-core-handoff-64",
      "tier": "replay",
      "gate_role": "product",
      "consumer_key": "northstar/mem/fixed-slot-cross-core-handoff",
      "provenance": {
        "path": "bench/mem/consumer_shapes_v1.json",
        "sha256": "c72e00527ea82d5e32431fd29d996faa7fecb6d58c2d2514281c41a471a43b32"
      },
      "ownership_topology": {
        "candidate": "A pinned producer takes 64 move-only HYLE PoolLoan values from a 256-slot hard ObjectPool and a pinned consumer observes and destroys them, returning slots remotely",
        "peer": "The same roles move 64 Marl Loan values from a 256-slot BoundedPool through its repaired published non-blocking tryBorrow route and return them on the consumer",
        "equivalence": "Both pools reconstruct Slot, expose unique scoped ownership in the charged path, retain exactly 256 slots, reject the 257th outstanding non-blocking request, transfer the same payload and charge producer acquisition plus consumer observation/return"
      },
      "material_contribution": {
        "frequency": 64,
        "value": 1,
        "unit": "producer-consumer-slot-lifecycle",
        "budget": 5,
        "denominator": "one pinned two-role handoff batch",
        "derivation": "The retained manifest marks this as an admitted inference-foundation replay with no current HYLE product caller; 64 of 256 slots preserves normal non-exhausted operation while capacity failure is verified outside timing"
      },
      "semantic_contract": "Acquire, populate, transfer, observe and remotely return 64 uniquely owned fixed-capacity slots without blocking or exhaustion",
      "comparability": "COMPARABLE",
      "peer_id": "marl",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {"distribution": "64 sequential Slot payloads per batch", "scale": {"pool_capacity": 256, "loans_per_callback": 64, "threads": 2}},
      "setup": "Both pools are constructed in both allocation orders, capacity-tested, warmed for 32 paired batches and held for the process; caller and worker are pinned by the cross-core machine contract",
      "charged_phases": ["64 non-blocking scoped acquisitions", "64 payload writes", "one release/acquire command handoff", "64 consumer observations", "64 remote scoped returns", "producer completion wait"],
      "pair": {"candidate": "HYLE hard ObjectPool handoff N=64", "peer": "Marl BoundedPool handoff N=64"},
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": [
        "primary-candidate-first-candidate-allocation-first",
        "primary-candidate-first-peer-allocation-first",
        "primary-peer-first-candidate-allocation-first",
        "primary-peer-first-peer-allocation-first",
        "placement-candidate-first-candidate-allocation-first",
        "placement-candidate-first-peer-allocation-first",
        "placement-peer-first-candidate-allocation-first",
        "placement-peer-first-peer-allocation-first"
      ],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement", "mem-handoff-resource"]
    }
  ],
