  "workloads": [
    {
      "id": "host-phase-deadline-64",
      "tier": "replay",
      "gate_role": "product",
      "consumer_key": "sched/runtime/host-phase-and-deadline",
      "provenance": {
        "path": "src/sched/scheduler.cc",
        "sha256": "9fc1b77d51b70b701962418ca5b3003244b9828ac676fd5e9e33a49716842ba3"
      },
      "ownership_topology": {
        "candidate": "One runtime thread performs 64 independent HYLE Instant begin/end samples and value-only saturated deadline/remaining calculations",
        "peer": "The same thread performs 64 direct std::chrono::steady_clock begin/end samples and source-equivalent value-only calculations",
        "equivalence": "Both routes use the same compiler, standard library, OS clock, number of reads, timeout sequence, arithmetic boundary contract, checksum sink and process; only the HYLE public inline vocabulary differs"
      },
      "material_contribution": {
        "frequency": 64,
        "value": 2,
        "unit": "host-clock-read",
        "budget": 5,
        "denominator": "one callback containing 64 runtime phase records with begin and end samples",
        "derivation": "Scheduler deadline/remaining paths and inference phase accounting both read a precise monotonic clock; batching 64 phase records raises the workload above the instrument floor without inventing a different API shape"
      },
      "semantic_contract": "For each of 64 runtime phases, sample a precise monotonic begin and end, compute a non-negative elapsed duration, derive a 30-second-plus-index saturated absolute deadline from begin, compute remaining time at end, and consume every result",
      "comparability": "COMPARABLE",
      "peer_id": "seastar",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {
        "distribution": "64 consecutive phase records with timeout_ns = 30 seconds plus the record index",
        "scale": {"phases": 64, "clock_reads": 128, "deadline_calculations": 64, "elapsed_calculations": 64}
      },
      "setup": "No heap allocation, clock registry, runtime object or timer node is created; both same-TU routes are warmed before measured epochs",
      "charged_phases": ["128 precise steady-clock reads", "64 typed begin/end elapsed calculations", "64 saturated deadline calculations", "64 remaining-time calculations", "one checksum sink"],
      "pair": {"candidate": "HYLE host phase batch N=64", "peer": "C++ steady_clock phase batch N=64"},
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": ["primary-candidate-first", "primary-peer-first", "placement-candidate-first", "placement-peer-first"],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement"]
    }
  ],
  "experiment": {
