      "peer_id": "seastar",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {
        "distribution": "64 separately allocated stable nodes armed in a multiplicative permutation; deadlines 1..64 ticks; 45/64 deterministic cancellations preserving a final-tick survivor",
        "scale": {"nodes": 64, "cancelled": 45, "survivors": 19, "advance_ticks": 64, "callbacks": 19}
      },
      "setup": "Candidate/peer owner objects, stable node allocations, payloads, callbacks, and allocation order are established outside measured callbacks; each epoch begins with empty queues and ready lists",
      "charged_phases": ["64 arms", "45 arbitrary O(1) cancellations", "64 monotonic queue advances", "19-node ready-list drain", "19 callback/data observations", "queue state observations"],
      "pair": {"candidate": "HYLE TimerQueue lifecycle N=64", "peer": "Seastar timer_set lifecycle N=64"},
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": ["primary-candidate-first-candidate-allocation-first", "primary-candidate-first-peer-allocation-first", "primary-peer-first-candidate-allocation-first", "primary-peer-first-peer-allocation-first", "placement-candidate-first-candidate-allocation-first", "placement-candidate-first-peer-allocation-first", "placement-peer-first-candidate-allocation-first", "placement-peer-first-peer-allocation-first"],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement"]
