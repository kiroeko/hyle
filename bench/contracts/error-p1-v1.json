{
  "schema": "hyle.perf.contract/v1",
  "id": "error-p1-v1",
  "module": "error",
  "claim": "P1 engineering non-inferiority for frozen Status and Result component replays against Abseil under balanced execution-order and code-placement strata",
  "candidate": {
    "target": "hyle_error",
    "delivery_shape": "static",
    "revision": "runtime-bound",
    "component": "error",
    "entrypoint": "hyle/error/status.h, hyle/error/result.h, and hyle/error/format.h"
  },
  "peers": [
    {
      "id": "abseil",
      "revision": "81c993af4fb88b3a51829a796df02251fa27102f",
      "configuration": {
        "status_source_location": "disabled with an empty absl::SourceLocation",
        "delivery_shape": "static",
        "source": "clean external checkout"
      }
    }
  ],
  "strata": [
    {
      "id": "primary-candidate-first",
      "dimensions": {"placement": "primary", "execution_order": "candidate-first"},
      "target_variant": "primary"
    },
    {
      "id": "primary-peer-first",
      "dimensions": {"placement": "primary", "execution_order": "peer-first"},
      "environment": {"HYLE_BENCH_RIVAL_FIRST": "1"},
      "target_variant": "primary"
    },
    {
      "id": "placement-candidate-first",
      "dimensions": {"placement": "perturbed", "execution_order": "candidate-first"},
      "target_variant": "placement"
    },
    {
      "id": "placement-peer-first",
      "dimensions": {"placement": "perturbed", "execution_order": "peer-first"},
      "environment": {"HYLE_BENCH_RIVAL_FIRST": "1"},
      "target_variant": "placement"
    }
  ],
  "controls": [
    {"id": "aa", "kind": "aa", "parameters": {"maximum_bias_percent": 5}},
    {"id": "delta5", "kind": "known-delta", "parameters": {"nominal_percent": 5}},
    {"id": "delta10", "kind": "known-delta", "parameters": {"nominal_percent": 10}},
    {"id": "timer-floor", "kind": "timer-floor", "parameters": {"minimum_workload_floor_multiple": 20}},
    {"id": "placement", "kind": "placement", "parameters": {}},
    {"id": "error-codegen", "kind": "codegen", "parameters": {"validator_id": "error-p1-contract"}}
  ],
  "workloads": [
    {
      "id": "taskgraph-active-success-64",
      "tier": "replay",
      "semantic_contract": "Evaluate one TaskGraph-shaped request containing 64 active indirect function-pointer nodes; every node returns an information-free OK Status",
      "comparability": "COMPARABLE",
      "peer_id": "abseil",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {"distribution": "64 active nodes, all successful", "scale": {"graph_requests_per_callback": 1, "nodes_per_request": 64}},
      "setup": "Separate candidate and peer node/context arrays are initialized outside the measured callback; each evaluator receives runtime storage",
      "charged_phases": ["64 indirect node calls", "64 value-less status checks", "success return", "observable call/checksum updates"],
      "pair": {"candidate": "HYLE Status TaskGraph active stream success", "peer": "absl::Status TaskGraph active stream success"},
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": ["primary-candidate-first", "primary-peer-first", "placement-candidate-first", "placement-peer-first"],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement", "error-codegen"]
    },
    {
      "id": "taskgraph-active-last-error-64",
      "tier": "replay",
      "semantic_contract": "Evaluate one TaskGraph-shaped request containing 64 active indirect function-pointer nodes; the final node returns a code-only NotFound Status and evaluation propagates it",
      "comparability": "COMPARABLE",
      "peer_id": "abseil",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {"distribution": "63 successful nodes followed by one code-only failure", "scale": {"graph_requests_per_callback": 1, "nodes_per_request": 64, "failure_index": 63}},
      "setup": "Separate candidate and peer node/context arrays are initialized outside the measured callback; no message, context, payload, or allocation",
      "charged_phases": ["64 indirect node calls", "64 value-less status checks", "last-node error propagation", "observable call/checksum updates"],
      "pair": {"candidate": "HYLE Status TaskGraph active stream last code-only error", "peer": "absl::Status TaskGraph active stream last code-only error"},
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": ["primary-candidate-first", "primary-peer-first", "placement-candidate-first", "placement-peer-first"],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement", "error-codegen"]
    },
    {
      "id": "status-message-29",
      "tier": "replay",
      "semantic_contract": "Construct an owning NotFound status from a borrowed 29-byte message with source-location capture disabled",
      "comparability": "COMPARABLE",
      "peer_id": "abseil",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {"distribution": "fixed borrowed message", "scale": {"message_bytes": 29}},
      "setup": "Borrowed message storage exists outside the callback",
      "charged_phases": ["owning status construction", "carrier destruction"],
      "pair": {"candidate": "HYLE Status::NotFound owning 29-byte message (borrowed input)", "peer": "absl::Status owning 29-byte message (borrowed input, no-loc)"},
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": ["primary-candidate-first", "primary-peer-first", "placement-candidate-first", "placement-peer-first"],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement", "error-codegen"]
    },
    {
      "id": "status-message-copy",
      "tier": "replay",
      "semantic_contract": "Copy a prebuilt owning status whose 29-byte message representation is shared",
      "comparability": "COMPARABLE",
      "peer_id": "abseil",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {"distribution": "prebuilt owned message status", "scale": {"message_bytes": 29, "copies_per_callback": 1}},
      "setup": "Source status is constructed outside the callback",
      "charged_phases": ["shared status copy", "copy destruction"],
      "pair": {"candidate": "HYLE Status copy (shared owned 29-byte message)", "peer": "absl::Status copy (shared owned 29-byte message)"},
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": ["primary-candidate-first", "primary-peer-first", "placement-candidate-first", "placement-peer-first"],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement", "error-codegen"]
    },
    {
      "id": "status-context-1",
      "tier": "replay",
      "semantic_contract": "Copy a prebuilt message status and prepend one semantic context layer",
      "comparability": "COMPARABLE",
      "peer_id": "abseil",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {"distribution": "fixed seed and context", "scale": {"context_layers": 1}},
      "setup": "Seed status is constructed outside the callback",
      "charged_phases": ["seed copy", "context prepend", "result destruction"],
      "pair": {"candidate": "HYLE Status::WithContext x1 (copied lvalue seed)", "peer": "absl::StatusBuilder SetPrepend x1 (prebuilt lvalue seed)"},
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": ["primary-candidate-first", "primary-peer-first", "placement-candidate-first", "placement-peer-first"],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement", "error-codegen"]
    },
    {
      "id": "status-context-3",
      "tier": "replay",
      "semantic_contract": "Copy a prebuilt message status and prepend three semantic context layers through an rvalue chain",
      "comparability": "COMPARABLE",
      "peer_id": "abseil",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {"distribution": "fixed seed and contexts", "scale": {"context_layers": 3}},
      "setup": "Seed status is constructed outside the callback",
      "charged_phases": ["seed copy", "three context prepends", "result destruction"],
      "pair": {"candidate": "HYLE Status::WithContext x3 (copied lvalue seed, rvalue chain)", "peer": "absl::StatusBuilder SetPrepend x3 (prebuilt lvalue seed)"},
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": ["primary-candidate-first", "primary-peer-first", "placement-candidate-first", "placement-peer-first"],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement", "error-codegen"]
    },
    {
      "id": "result-message-error",
      "tier": "replay",
      "semantic_contract": "Propagate a prebuilt NotFound message error through two symmetric noinline Result call frames",
      "comparability": "COMPARABLE",
      "peer_id": "abseil",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {"distribution": "increasing positive integer selecting the error path", "scale": {"frames": 2}},
      "setup": "Prebuilt owning message errors exist outside the callback",
      "charged_phases": ["two-frame result propagation", "result-state query"],
      "pair": {"candidate": "HYLE Result message error (2 noinline frames)", "peer": "absl::StatusOr message error (2 noinline frames)"},
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": ["primary-candidate-first", "primary-peer-first", "placement-candidate-first", "placement-peer-first"],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement", "error-codegen"]
    },
    {
      "id": "status-format-54",
      "tier": "replay",
      "semantic_contract": "Format an Unavailable status with a 54-byte message to a complete owning human-readable string",
      "comparability": "COMPARABLE",
      "peer_id": "abseil",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {"distribution": "fixed prebuilt status", "scale": {"message_bytes": 54}},
      "setup": "Candidate and peer statuses exist outside the callback and carry the same canonical code/message semantics",
      "charged_phases": ["status formatting", "owning output allocation and materialization"],
      "pair": {"candidate": "HYLE hyle::to_string owning (54-byte message)", "peer": "absl::Status::ToString owning (54-byte message)"},
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": ["primary-candidate-first", "primary-peer-first", "placement-candidate-first", "placement-peer-first"],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement", "error-codegen"]
    },
    {
      "id": "status-update-prvalue",
      "tier": "replay",
      "semantic_contract": "Keep the first of two fresh noinline-factory prvalue message errors",
      "comparability": "COMPARABLE",
      "peer_id": "abseil",
      "metric": {"name": "operations-per-second", "unit": "op/s", "direction": "higher-is-better"},
      "input": {"distribution": "two fixed fresh message errors", "scale": {"updates_per_callback": 2}},
      "setup": "Both message errors are created inside the callback through symmetric noinline factories",
      "charged_phases": ["two message status constructions", "first-error Update", "discarded second error", "destruction"],
      "pair": {"candidate": "HYLE Status::Update noinline factory prvalues x2", "peer": "absl::Status::Update noinline factory prvalues x2"},
      "practical_margin_percent": 5,
      "noninferiority_margin_percent": 5,
      "estimator": {"kind": "process-median", "minimum_independent_samples": 15, "tail_alpha": 0.01},
      "required_strata": ["primary-candidate-first", "primary-peer-first", "placement-candidate-first", "placement-peer-first"],
      "required_controls": ["aa", "delta5", "delta10", "timer-floor", "placement", "error-codegen"]
    }
  ],
  "experiment": {
    "sample_schedule": [15, 31],
    "order_policy": "fixed-dual",
    "holdout": false
  },
  "build": {
    "configuration": "Release",
    "fresh": true,
    "linkage": "static",
    "lto": "off",
    "isa": "portable",
    "toolchain": "machine-profile-bound"
  },
  "artifacts": {
    "validators": ["artifact-identity", "build-contract", "error-p1-contract"]
  },
  "hosts": {
    "allowed_platforms": ["windows", "wsl2", "macos"],
    "certification_platforms": ["windows", "macos"],
    "requirements": {
      "machine_profiles": ["W1-WIN", "W1-WSL", "M1-MAC"],
      "qualified_role": "engineering",
      "formal_independent_hardware": true
    }
  },
  "extensions": {
    "runner": {
      "schema": "hyle.perf.nanobench-runner/v1",
      "cmake": {
        "cache": {
          "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
          "HYLE_BENCH_ABSL": "ON",
          "HYLE_BUILD_BENCH": "ON",
          "HYLE_BUILD_TESTS": "OFF",
          "HYLE_COMPONENTS": "error",
          "HYLE_INSTALL": "OFF",
          "HYLE_SANITIZER": "off",
          "HYLE_SIMD_EXACT_TARGET": "",
          "HYLE_STATIC": "ON",
          "HYLE_TEST_INSTRUMENTATION": "OFF",
          "HYLE_TRACE": "OFF"
        },
        "peer_cache": {"abseil": "HYLE_ABSL_DIR"}
      },
      "profiles": {
        "W1-WIN": {"generator": "Visual Studio 18 2026", "architecture": "x64", "compiler_id": "MSVC", "compiler_version_prefix": "19.50", "cache": {}},
        "W1-WSL": {"generator": "Ninja", "compiler_id": "GNU", "compiler_version_prefix": "14", "cache": {"CMAKE_C_COMPILER": "gcc-14", "CMAKE_CXX_COMPILER": "g++-14"}},
        "M1-MAC": {"generator": "Ninja", "compiler_id": "AppleClang", "compiler_version_prefix": "21", "cache": {}}
      },
      "executables": [
        {
          "id": "error-p1-primary",
          "target": "hyle_error_p1_bench",
          "stem": "hyle_error_p1_bench",
          "target_variant": "primary",
          "measurement_batch": 1,
          "telemetry_prefixes": ["# HYLE_ERROR_P1_RUN "],
          "workloads": [
            {"id": "taskgraph-active-success-64", "title": "TaskGraph evaluate 64 active function-pointer nodes success"},
            {"id": "taskgraph-active-last-error-64", "title": "TaskGraph evaluate 64 active function-pointer nodes last error"},
            {"id": "status-message-29", "title": "Status construct owning 29-byte message"},
            {"id": "status-message-copy", "title": "Status copy sharing an owned 29-byte message"},
            {"id": "status-context-1", "title": "Status prepend 1 context to a prebuilt message error"},
            {"id": "status-context-3", "title": "Status prepend 3 contexts to a prebuilt message error"},
            {"id": "result-message-error", "title": "Result propagate prebuilt message error through 2 noinline frames"},
            {"id": "status-format-54", "title": "Format 54-byte message to an owning string"},
            {"id": "status-update-prvalue", "title": "Status::Update keeps first of 2 fresh prvalue message errors"}
          ]
        },
        {
          "id": "error-p1-placement",
          "target": "hyle_error_p1_bench_placement",
          "stem": "hyle_error_p1_bench_placement",
          "target_variant": "placement",
          "measurement_batch": 1,
          "telemetry_prefixes": ["# HYLE_ERROR_P1_RUN "],
          "workloads": [
            {"id": "taskgraph-active-success-64", "title": "TaskGraph evaluate 64 active function-pointer nodes success"},
            {"id": "taskgraph-active-last-error-64", "title": "TaskGraph evaluate 64 active function-pointer nodes last error"},
            {"id": "status-message-29", "title": "Status construct owning 29-byte message"},
            {"id": "status-message-copy", "title": "Status copy sharing an owned 29-byte message"},
            {"id": "status-context-1", "title": "Status prepend 1 context to a prebuilt message error"},
            {"id": "status-context-3", "title": "Status prepend 3 contexts to a prebuilt message error"},
            {"id": "result-message-error", "title": "Result propagate prebuilt message error through 2 noinline frames"},
            {"id": "status-format-54", "title": "Format 54-byte message to an owning string"},
            {"id": "status-update-prvalue", "title": "Status::Update keeps first of 2 fresh prvalue message errors"}
          ]
        }
      ],
      "control_executable": {"target": "hyle_perf_control_bench", "stem": "hyle_perf_control_bench"},
      "controlled_environment": ["HYLE_BENCH_RIVAL_FIRST", "HYLE_BENCH_APPLE_QOS", "HYLE_PERF_APPLE_QOS"],
      "validators": [
        {"id": "artifact-identity", "kind": "artifact-identity"},
        {"id": "build-contract", "kind": "build-contract"},
        {"id": "error-p1-contract", "kind": "command", "command": ["{python}", "scripts/validate-error-p1-bench.py", "--build", "{build}"]}
      ]
