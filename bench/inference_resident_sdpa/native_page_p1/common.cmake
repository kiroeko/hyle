get_filename_component(HYLE_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(HYLE_COMPONENTS "compute;graph")
set(HYLE_COMPUTE_ROUTES "${HYLE_PAGE_ROUTE}")
set(HYLE_BUILD_TESTS OFF)
set(HYLE_BUILD_BENCH OFF)
add_subdirectory("${HYLE_SOURCE_DIR}" hyle)
if(HYLE_PAGE_ROUTE STREQUAL "apple")
  find_package(Python3 REQUIRED COMPONENTS Interpreter)
  get_target_property(_mlx_linked_source mlx HYLE_DEP_SOURCE_DIR)
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/verify_mlx_peer.py"
    --peer "${HYLE_MLX_ORIGINAL_REFERENCE_SOURCE}" --linked "${_mlx_linked_source}" --manifest "${HYLE_SOURCE_DIR}/third_party/mlx_cast/patches.json" --output "${CMAKE_CURRENT_BINARY_DIR}/mlx-peer-identity.json"
    RESULT_VARIABLE _mlx_peer_result)
  if(NOT _mlx_peer_result EQUAL 0)
    message(FATAL_ERROR "Original MLX fast SDPA source identity did not match the linked runtime")
  endif()
endif()
if(NOT HYLE_STATIC)
  message(FATAL_ERROR "Private original page comparators require static source linkage")
endif()
add_library(g01_nr_nanobench STATIC "${HYLE_SOURCE_DIR}/bench/nanobench_impl.cc")
target_include_directories(g01_nr_nanobench SYSTEM PUBLIC "${HYLE_SOURCE_DIR}/third_party/nanobench")
set(_source "${HYLE_SOURCE_DIR}/bench/inference_resident_sdpa")
if(HYLE_PAGE_ROUTE STREQUAL "vulkan")
  find_package(Python3 REQUIRED COMPONENTS Interpreter)
  set(_generated "${CMAKE_CURRENT_BINARY_DIR}/reference-shaders")
  if(NOT EXISTS "${HYLE_RESIDENT_REFERENCE_SOURCE}/src/ggml-vulkan/ggml-vulkan.cpp")
    message(FATAL_ERROR "Original shader peer checkout required")
  endif()
  add_custom_command(OUTPUT "${_generated}/reference_spirv.h"
    COMMAND "${Python3_EXECUTABLE}" "${_source}/reference_shaders.py" --peer "${HYLE_RESIDENT_REFERENCE_SOURCE}" --compiler "${HYLE_RESIDENT_GLSLANG}" --output "${_generated}"
    DEPENDS "${_source}/reference_shaders.py" VERBATIM)
  if(APPLE)
    find_file(_loader NAMES libvulkan.1.dylib HINTS /opt/homebrew/opt/vulkan-loader/lib REQUIRED)
  endif()
endif()
foreach(_variant primary placement)
  if(_variant STREQUAL "primary")
    set(_target g01_native_page_bench)
  else()
    set(_target g01_native_page_bench_placement)
  endif()
  add_executable(${_target} "${_source}/native_page_bench.cc")
  if(HYLE_PAGE_ROUTE STREQUAL "apple")
    target_sources(${_target} PRIVATE "${_source}/apple_page_reference.cc")
    target_compile_definitions(${_target} PRIVATE HYLE_PAGE_APPLE_BENCH=1)
  else()
    target_sources(${_target} PRIVATE "${_source}/vulkan_page_reference.cc" "${_source}/reference.cc" "${_generated}/reference_spirv.h")
    target_include_directories(${_target} PRIVATE "${_generated}" "${HYLE_SOURCE_DIR}/src/compute_route_vulkan")
    if(APPLE)
      target_compile_definitions(${_target} PRIVATE HYLE_RESIDENT_VULKAN_LOADER="${_loader}")
    endif()
  endif()
  if(_variant STREQUAL "placement")
    target_sources(${_target} PRIVATE "${_source}/placement.cc")
    target_compile_definitions(${_target} PRIVATE HYLE_PAGE_PLACEMENT=1)
  else()
    target_compile_definitions(${_target} PRIVATE HYLE_PAGE_PLACEMENT=0)
  endif()
  target_compile_features(${_target} PRIVATE cxx_std_23)
  target_link_libraries(${_target} PRIVATE hyle::compute g01_nr_nanobench)
  hyle_apply_warnings(${_target})
  if(MSVC)
    target_compile_definitions(${_target} PRIVATE _CRT_SECURE_NO_WARNINGS)
  endif()
  set_property(TARGET ${_target} PROPERTY INTERPROCEDURAL_OPTIMIZATION FALSE)
  hyle_stage_runtime(${_target})
endforeach()
add_executable(g01_native_page_control "${HYLE_SOURCE_DIR}/bench/integration/perf_control_bench.cc")
target_compile_features(g01_native_page_control PRIVATE cxx_std_23)
target_link_libraries(g01_native_page_control PRIVATE hyle::compute g01_nr_nanobench)
set_property(TARGET g01_native_page_control PROPERTY INTERPROCEDURAL_OPTIMIZATION FALSE)
hyle_stage_runtime(g01_native_page_control)
